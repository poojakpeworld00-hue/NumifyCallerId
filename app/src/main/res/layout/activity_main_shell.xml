<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.MainShellActivity">

        <com.callerid.numberlookup.home.feature.widgets.SwipeNavigationLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/overlayBanner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Overlay-permission prompt: sits above the nav once call-log & contacts
             are granted but the overlay permission isn't.

             Anchored to footerBar, NOT to fabLookup. The FAB used to straddle the
             bar's top edge, so pinning to it kept clear of the nav; now that it is
             centred INSIDE the pill, its top sits a dozen dp within the nav — and
             because fragmentContainer chains its own bottom through this banner,
             anchoring here dragged every tab's content underneath the nav bar.

             This view is the bottom of the content area whether it is visible or
             gone (a gone widget collapses to a point at its resolved position), so
             it has to line up with the top of the nav, not with something inside it. -->
        <LinearLayout
            android:id="@+id/overlayBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/primary_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/footerBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/overlay_banner_desc"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/buttonEnableOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="@string/perm_allow"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Hairline over the nav, so the bar reads as its own surface even where
             the two colours are close. -->
        <View
            android:id="@+id/footerDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/ds_rule"
            app:layout_constraintBottom_toTopOf="@id/footerBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom navigation, flat and full-bleed.

             It used to be the handoff's floating white island — 28dp radius,
             inset 20dp a side, on a 16dp shadow with a gap beneath. Sitting
             directly above a banner ad, that stacked three separate objects at
             the foot of every screen: island, gap, ad. Flat, it is just the last
             row of the page, and the only thing under it is the ad.

             It carries ds_surface rather than nothing. With no background of its
             own the page colour ran straight through and the bar stopped looking
             like a bar at all — the four cells floated on the same field as the
             content above them. Surface against page is the same one-step
             separation every card on every screen uses, and the hairline above
             carries it where the two are only a shade apart.

             No margins, so it spans the width; no padding, because each cell
             already brings its own. -->
        <LinearLayout
            android:id="@+id/footerBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/ds_surface"
            android:baselineAligned="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@+id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Dialer · Recent · (Lookup) · Contact · Tools.
                 Blocklist gave up its chip to the dialer: it is a place you go to
                 manage something you already did, not one of the four things the
                 app is for, and it is still a tap away from Settings and from the
                 protection strip on Recents. -->
            <include
                android:id="@+id/navDialer"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navRecents"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navContacts"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navTools"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>


        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
