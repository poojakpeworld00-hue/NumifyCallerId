<?xml version="1.0" encoding="utf-8"?>
<!-- The raised lookup action: `linear-gradient(150deg,#8B7CFF,#3466F0)` on an 18dp
     radius. This is the one place the palette uses violet, which is what keeps the
     centre action from reading as just another blue chip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/ds_fab_end"
        android:startColor="@color/ds_fab_start"
        android:type="linear" />
    <corners android:radius="18dp" />
</shape>
