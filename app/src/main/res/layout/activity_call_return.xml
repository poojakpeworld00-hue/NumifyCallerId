<?xml version="1.0" encoding="utf-8"?>
<!-- Call back (post-call), restyled to match Call Details.

     UI only. Every id, every string and every piece of information the screen
     showed before is still here and still says the same thing — the identity,
     the duration, the time, the call type, the call-back button, the Ask AI
     summary, the four tabs, the fragment host and the ad slot. What changed is
     how they are grouped and painted.

     The screen was a flat header row on the plain background, with the name,
     duration, time and type stacked as four small lines of equal weight beside a
     circular avatar. Call Details had already solved the same problem: one dark
     hero holding the identity, the facts folded into it, and the action sitting
     inside the thing it acts on. Reusing that here means the two screens about
     the same call no longer look like they came from different apps.

     Dark mode comes free: every colour below is a ds_ token with a values-night
     counterpart, where the old layout used @color/bg and @color/on_surface. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page">

        <!--
            The hero is pinned: it is who the call was with, and it should not
            slide away while you are reading what is underneath it.
        -->
        <!-- ===== Identity hero ===== -->
        <LinearLayout
            android:id="@+id/column_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_ds_detail_hero"
            android:clipToOutline="true"
            android:elevation="10dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/ds_hero_shadow"
            android:outlineSpotShadowColor="@color/ds_hero_shadow"
            android:padding="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/sectionUser"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_ds_hero_avatar">

                    <!-- Three layers, same as a contacts row: the glyph for a
                         caller with no name at all, initials once there is one,
                         and the contact picture over both when they have one. -->
                    <ImageView
                        android:id="@+id/imageUser"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/ds_on_hero_muted" />

                    <TextView
                        android:id="@+id/textUserInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/ds_on_hero_muted"
                        android:textSize="22sp"
                        android:visibility="gone"
                        tools:text="JD" />

                    <ImageView
                        android:id="@+id/imageUserPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:visibility="gone" />
                </FrameLayout>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:id="@+id/headerLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/labelCallerName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.02"
                        android:maxLines="1"
                        android:textColor="@color/ds_on_hero"
                        android:textSize="26sp"
                        tools:text="98745 63210" />

                    <!-- Held in place of the name while the number is looked up, for
                         the same reason the incoming-call card does it: printing the
                         raw number and then swapping in a name a second later reads
                         as the app correcting itself. Same 100x13 bar as
                         overlay_caller_id, so the two screens shimmer identically. -->
                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmerCallerName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <View
                            android:layout_width="@dimen/_100sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:alpha="0.18"
                            android:background="@drawable/bg_shimmer_placeholder" />
                    </com.facebook.shimmer.ShimmerFrameLayout>

                    <!-- Time and call type on one muted line, where Call Details
                         puts "+91 70164 14568 · Mobile". -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/labelTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_semibold"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="12:03"
                            android:textColor="@color/ds_on_hero_muted"
                            android:textSize="12.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="6dp"
                            android:fontFamily="@font/mulish_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/dash"
                            android:textColor="@color/ds_on_hero_muted"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/labelCallType"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/mulish_semibold"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="@string/call_type_outgoing"
                            android:textColor="@color/ds_on_hero_muted"
                            android:textSize="12.5sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>

                    <!-- Duration as a hero pill, where Call Details puts its
                         "Not identified" pill. -->
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:background="@drawable/bg_ds_hero_pill"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="@string/call_duration_label"
                            android:textColor="@color/ds_on_hero_muted"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/labelDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:text="00:00"
                            android:textColor="@color/ds_on_hero"
                            android:textSize="11.5sp" />
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </androidx.appcompat.widget.LinearLayoutCompat>

                <!-- The hero carried a call button of its own until the strip below
                     grew a Call action. Two buttons that place the same call, one
                     above the other, is one button too many - and the hero's was the
                     one with no label on it. -->
            </LinearLayout>
        </LinearLayout>

        <!--
            Everything above the ad scrolls.

            The ad slot at the bottom is as tall as the ad that lands in it, and
            the large native is close to half the screen. What was left had to
            hold the hero, the summary, the actions and the call list, so the
            list was squeezed to a row or two and on a short screen the summary
            and the actions had nowhere to go at all. None of it could be
            reached, because nothing scrolled.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@+id/adContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_default="spread"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/column_1">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/contentColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <!-- Ask AI post-call summary. Built from call-log metadata only: how often,
                     how long, how many went unanswered. There is no transcript, because
                     Android has not let a third-party app capture call audio since API 29.
                     Collapses when there is nothing worth saying. -->
                <LinearLayout
                    android:id="@+id/cardCallSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ds_card"
                    android:baselineAligned="false"
                    android:elevation="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ai_sparkle"
                        app:tint="@color/ds_accent" />

                    <TextView
                        android:id="@+id/textCallSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/mulish_semibold"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.35"
                        android:textColor="@color/ds_ink"
                        android:textSize="12.5sp"
                        tools:text="You have spoken to Rahul 6 times this month. This was your longest call yet." />
                </LinearLayout>

                <!-- ===== Actions: the same four the call detail screen offers ===== -->
                <LinearLayout
                    android:id="@+id/main_butttion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ds_card"
                    android:baselineAligned="false"
                    android:elevation="4dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="12dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/cardCallSummary">

                    <LinearLayout
                        android:id="@+id/buttonCall"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_accent"
                            android:contentDescription="@string/action_call"
                            android:src="@drawable/ic_ds_phone"
                            app:tint="@color/ds_on_accent" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_call" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonMessage"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_hero_blue_wash"
                            android:contentDescription="@string/action_message"
                            android:src="@drawable/ic_message_square_alt"
                            app:tint="@color/ds_accent" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_message" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonWhatsapp"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_success_wash"
                            android:contentDescription="@string/action_whatsapp"
                            android:src="@drawable/ic_whatsapp"
                            app:tint="@color/ds_success" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_whatsapp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonBlock"
                        style="@style/DetailAction">

                        <ImageView
                            android:id="@+id/imageBlockIcon"
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_danger_tint"
                            android:contentDescription="@string/action_block"
                            android:src="@drawable/ic_ds_block_slash"
                            app:tint="@color/ds_danger" />

                        <TextView
                            android:id="@+id/textBlockLabel"
                            style="@style/DetailActionLabel"
                            android:text="@string/action_block" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/fragment_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/main_butttion" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/ds_surface">

                <include layout="@layout/admob_big_native" />

            </com.facebook.shimmer.ShimmerFrameLayout>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
