<?xml version="1.0" encoding="utf-8"?>
<!-- One bottom-navigation cell: the glyph over its label.

     The handoff sat the active pair in a rounded wash, and there used to be a
     [navPill] wrapper here to carry it — the wash hugged its contents while the
     root still filled its weighted share, so the tap target stayed the full
     quarter of the bar. The wash is gone now: with the bar itself flat and
     full-bleed, a tinted lozenge was the only remaining chrome down there and it
     read as a leftover. With nothing left to wrap, the pill went with it.

     State is carried by [navIndicator] over the glyph, plus the accent colour
     and the bolder label. Colour and weight alone were not enough at 22dp/12sp:
     four cells in one row with nothing but a hue between them made it a hunt to
     see which was current.

     Both are tinted from MainShellActivity: the active accent is per tab, blue
     everywhere except Blocklist.

     19dp/10sp was sized to survive five destinations in a padded island. At four
     cells in a full-width bar there is room to read it: 22dp glyph, 12sp label. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingBottom="10dp"
        android:paddingTop="6dp">

        <!-- Selected marker. INVISIBLE rather than GONE on the idle cells: it
             holds its 3dp so the glyphs sit on one line across the bar instead
             of the current tab's dropping by the height of its own indicator. -->
        <View
            android:id="@+id/navIndicator"
            android:layout_width="22dp"
            android:layout_height="3dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_nav_indicator"
            android:visibility="invisible" />

        <ImageView
            android:id="@+id/navIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_ds_nav_recents"
            app:tint="@color/ds_nav_idle"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/navLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/mulish_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ds_nav_idle"
            android:textSize="12sp"
            tools:text="Recents" />
    </LinearLayout>
</layout>
