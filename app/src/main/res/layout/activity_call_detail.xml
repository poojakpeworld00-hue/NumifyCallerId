<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detailRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.insight.CallDetailsActivity">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/crownBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/padBack"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/glyph_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:text="@string/call_detail_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingBottom="@dimen/_10sdp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintTop_toBottomOf="@id/crownBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Centered identity hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/avatarRingVw"
                        android:layout_width="@dimen/_70sdp"
                        android:layout_height="@dimen/_70sdp"
                        android:background="@drawable/shape_detail_avatar_ring"
                        android:padding="@dimen/_3sdp">

                        <TextView
                            android:id="@+id/lblAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/shape_avatar"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_20ssp"
                            android:textStyle="bold"
                            tools:text="JD" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/lblName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_17ssp"
                        android:textStyle="bold"
                        tools:text="Emergency · 112" />

                    <TextView
                        android:id="@+id/lblNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_12ssp"
                        tools:text="112 · Mobile" />

                    <!-- "Not identified yet" chip — shown only for unknown numbers -->
                    <TextView
                        android:id="@+id/lblVerified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/neutral_soft"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:text="@string/detail_not_identified"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <!-- Identify CTA — shown only for unknown numbers -->
                    <LinearLayout
                        android:id="@+id/padIdentify"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/shape_btn_gradient"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_20sdp"
                        android:paddingVertical="@dimen/_10sdp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@null"
                            android:src="@drawable/glyph_search"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:text="@string/detail_identify"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/padCall"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/primary"
                            android:contentDescription="@string/action_call"
                            android:src="@drawable/glyph_call"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_call" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/padMessage"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/primary_container"
                            android:contentDescription="@string/action_message"
                            android:src="@drawable/glyph_message_square_alt"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_message" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/padWhatsapp"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/primary_container"
                            android:contentDescription="@string/action_whatsapp"
                            android:src="@drawable/glyph_whatsapp"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_whatsapp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/padBlock"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/cid_clay_100"
                            android:contentDescription="@string/action_block"
                            android:src="@drawable/glyph_block"
                            app:tint="@color/cid_clay" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_block" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Summary strip (single line) -->
                <LinearLayout
                    android:id="@+id/summaryStripVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/shape_cid_summary_pill"
                    android:elevation="@dimen/_1sdp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/card_shadow"
                    android:outlineSpotShadowColor="@color/card_shadow"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_11sdp">

                    <TextView
                        android:id="@+id/lblCallCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold"
                        tools:text="59" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:text="@string/detail_calls_word"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_6sdp"
                        android:text="·"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/lblTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_12ssp"
                        tools:text="No talk time" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/_6sdp"
                        android:text="·"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_last_30"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_12ssp" />
                </LinearLayout>

                <!-- Call history -->
                <LinearLayout
                    android:id="@+id/historyCardVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/shape_cid_card"
                    android:elevation="@dimen/_1sdp"
                    android:outlineAmbientShadowColor="@color/card_shadow"
                    android:outlineSpotShadowColor="@color/card_shadow"
                    android:orientation="vertical"
                    android:padding="@dimen/_13sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/detail_call_history"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_13ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/detail_last_30"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:orientation="vertical" />

                    <View
                        android:id="@+id/historyDividerVw"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_1sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:alpha="0.15"
                        android:background="@color/on_surface_variant" />

                    <TextView
                        android:id="@+id/padViewAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingVertical="@dimen/_12sdp"
                        android:text="@string/detail_view_all"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Empty history state (no calls with this number) -->
                <LinearLayout
                    android:id="@+id/lblEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_22sdp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_32sdp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/_56sdp"
                        android:layout_height="@dimen/_56sdp"
                        android:background="@drawable/shape_circle_surface"
                        android:contentDescription="@null"
                        android:padding="@dimen/_15sdp"
                        android:src="@drawable/glyph_phone_solid"
                        app:tint="@color/on_surface_variant" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:gravity="center"
                        android:text="@string/detail_history_empty_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_13ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/detail_history_empty_sub"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDividerVw"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
