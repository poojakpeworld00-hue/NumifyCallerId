<?xml version="1.0" encoding="utf-8"?>
<!--
    Dark-theme overrides. Only the SEMANTIC tokens are redefined here; every
    layout/drawable references these names, so the whole app flips light<->dark
    automatically. Brand/literal colors (primary, on_primary, accent, danger,
    warn, white, black) are intentionally NOT overridden — they stay defined
    once in values/colors.xml and apply to both themes.
-->
<resources>
    <!-- Surfaces & background — Visual System v1 true-dark ramp (OLED) -->
    <color name="background">#0B0E14</color>
    <color name="surface">#141824</color>
    <color name="surface_2">#1C2231</color>
    <color name="card_bg_light">#141824</color>

    <!-- Soft elevation shadow on dark surfaces -->
    <color name="card_shadow">#59000000</color>

    <!-- Text / icons on surfaces -->
    <color name="on_surface">#F2F4FA</color>
    <color name="on_surface_variant">#8A93A8</color>

    <!-- Lines & containers -->
    <color name="outline">#2A3145</color>
    <color name="ad_divider">#26FFFFFF</color>       <!-- hairline between app content and ads -->
    <color name="primary_container">#1C2231</color>
    <color name="on_primary_container">#8CA0EB</color>

    <!-- Language screen: unselected radio ring (dark) -->
    <color name="radio_unselected">#5D6579</color>

    <!-- Verdict containers (dark) -->
    <color name="identified_container">#143126</color>
    <color name="spam_container">#2A1518</color>
    <color name="spam_on">#F09A9A</color>
    <color name="spam_avatar_bg">#47232A</color>

    <!-- Lookup -->
    <color name="success">#7FD98A</color>

    <!-- Splash redesign dark overrides. Per Visual System, the hero gradient stays
         a rich Indigo→Orchid even in dark (just deepened) — not near-black. -->
    <color name="splash_grad_start">#13256A</color>
    <!-- Phone illustration (dark navy) -->

    <!-- FSI intro Activity — dark (navy) variant of the design. -->
    <color name="fsi_bg_center">#221A3F</color>
    <color name="fsi_bg_edge">#0F172A</color>
    <color name="fsi_title">#FFFFFF</color>
    <color name="fsi_subtitle">#99FFFFFF</color>
    <color name="fsi_benefit_card">#14FFFFFF</color>
    <color name="fsi_benefit_border">#1AFFFFFF</color>
    <color name="fsi_benefit_text">#D9FFFFFF</color>
    <color name="fsi_benefit_divider">#12FFFFFF</color>
    <color name="fsi_not_now">#80FFFFFF</color>
    <color name="fsi_orbit_ring">#5A60A5FA</color>
    <color name="fsi_glow">#472563EB</color>
    <color name="fsi_tile_blue">#2E2563EB</color>
    <color name="fsi_tile_red">#29EF4444</color>
    <color name="fsi_tile_green">#2922C55E</color>
    <color name="fsi_icon_blue">#60A5FA</color>
    <color name="fsi_icon_red">#F87171</color>
    <color name="fsi_icon_green">#4ADE80</color>

    <!-- Enable-Caller-ID dialog — dark variants. -->
    <color name="cid_hint_bg">#242563EB</color>         <!-- ~0.14 blue tint on dark -->
    <color name="cid_shield_check">#0B0E14</color>      <!-- dark checkmark on light-blue shield -->
    <color name="cid_toggle_off">#3A4256</color>

    <!-- Splash · "Scanline" — dark variant of the design: a deep plum core that
         falls off to near-black, brighter Indigo for anything that must stay
         legible on it. Same +35° hue-rotation off the design's Sapphire as the
         light theme (see values/colors.xml), so the two themes stay siblings.
         `splash_sl_brand`/`_brand_2` are deliberately NOT overridden — the icon
         tile keeps the same gradient in both themes. -->
    <color name="splash_sl_bg_center">#151027</color>
    <color name="splash_sl_bg_edge">#07050C</color>
    <color name="splash_sl_bar_track">#3A4256</color>
    <color name="splash_sl_sweep">#7360A5FA</color>
    <color name="splash_sl_sweep_edge">#0060A5FA</color>
    <color name="splash_sl_badge_bg">#1A1626</color>
    <color name="splash_sl_footer">#6A7285</color>
    <color name="splash_sl_icon_amber">#F0B03C</color>
    <color name="splash_sl_icon_blue">#A37FFF</color>
    <color name="splash_sl_icon_green">#38B47C</color>

    <!-- CID03 tool-screen ramp — dark. The ramp INVERTS: on a dark surface the
         "deep ink" end has to be the light one, so cid_900 becomes near-white and
         cid_050 becomes the darkest fill. Anything that reads the ramp by name
         (a dark filled button = cid_900) therefore keeps working in both themes
         without the layouts branching on the theme. The accents only lift enough
         to stay legible; their hue does not move. -->
    <color name="cid_900">#F2ECFF</color>
    <color name="cid_050">#181327</color>

    <color name="cid_amber">#F0B03C</color>
    <color name="cid_amber_100">#3A2C12</color>
    <color name="cid_teal">#3DBDAF</color>
    <color name="cid_teal_100">#123230</color>
    <color name="cid_clay">#DE8B63</color>
    <color name="cid_clay_100">#3A2118</color>

    <!-- ===== Redesign 2026 — dark counterpart =====
         The handoff only draws a light treatment, so these are derived rather than
         given. Two rules kept it honest:

         1. Surfaces darken and ink inverts, but hues do not drift. A card is still
            a card and the brand is still the brand.
         2. The accent LIGHTENS. #2E5FE8 is a mid-blue that reads well on white and
            muddies against a dark page, so the ramp shifts up a step; the deep and
            bright ends move with it so gradients keep their direction.

         `ds_on_accent` is deliberately absent: it is what sits ON a brand fill, and
         a gradient pill is the same blue in both themes, so its label stays white.
         Same for the language chips — those are the flags' own backdrop.

         The splash is likewise untouched: `splash_cs_*` is a fixed branded surface
         that is meant to look identical whatever the theme is. -->
    <color name="ds_page">#0E1117</color>
    <color name="ds_surface">#171B24</color>
    <color name="ds_ink">#F2F4FA</color>
    <color name="ds_ink_muted">#8A93A8</color>
    <color name="ds_ink_subtle">#98A0B4</color>
    <color name="ds_accent">#5B85FF</color>
    <color name="ds_accent_deep">#0548FF</color>
    <color name="ds_accent_bright">#5B85FF</color>
    <color name="ds_accent_on_tint">#8CA8FF</color>
    <color name="ds_selected_tint">#1B2340</color>
    <color name="ds_rule">#262C3A</color>
    <color name="ds_divider">#222834</color>
    <color name="ds_check_idle">#3A4256</color>
    <color name="ds_flag_chip">#222836</color>
    <color name="ds_flag_chip_ring">#333B4D</color>
    <color name="ds_card_shadow">#66000000</color>
    <!-- A tinted glow reads as haze on a dark page; the lift comes from a plain
         black shadow instead. -->
    <color name="ds_accent_shadow">#8C000000</color>

    <!-- Onboarding heroes -->
    <color name="ds_hero_blue_wash">#16203A</color>
    <color name="ds_hero_blue_border">#24304F</color>
    <color name="ds_hero_red_wash">#2A1719</color>
    <color name="ds_hero_red_border">#4A2226</color>
    <color name="ds_danger">#F0736F</color>
    <color name="ds_danger_tint">#3A1F21</color>
    <color name="ds_success">#38B47C</color>
    <color name="ds_field_border">#2A3352</color>
    <color name="ds_placeholder">#6A7285</color>
    <color name="ds_track_idle">#3A4256</color>
    <color name="ds_rail">#222834</color>
    <color name="ds_chip_ink">#C3C9D6</color>
    <color name="ds_success_wash">#14291F</color>

    <!-- Call / lookup detail hero.
         The light hero is near-black, which would vanish against a #0E1117 page —
         a dark card on a dark screen with nothing to separate them. So it lifts
         instead of darkening: both stops move UP, keeping the indigo cast and the
         gradient's direction, so the hero still reads as the raised surface it is.

         The white alphas on top of it (ds_on_hero*, ds_hero_tile/chip/stroke) are
         deliberately absent: the hero is a dark surface in both themes, so what
         sits on it does not change. -->
    <color name="ds_detail_hero_start">#302764</color>
    <color name="ds_detail_hero_end">#1C2236</color>
    <color name="ds_hero_shadow">#8C000000</color>
    <color name="ds_back_chip">#1E2430</color>
    <color name="ds_timeline_rail">#262C3A</color>

    <!-- Bottom navigation -->
    <color name="ds_nav_chip_idle">#1E2430</color>
    <color name="ds_nav_idle">#7B8398</color>
    <color name="ds_nav_chip_active">#1B2340</color>
<!-- Contacts Premium.
         Only the light-surface tokens flip. The hero is a dark card in both
         themes and its gradient, the gold crown, the brand blue, the CTA and
         the shine are brand colours that belong to the design rather than to a
         theme, so they stay as values/colors.xml defines them. -->
    <color name="premium_page">#0B0E14</color>
    <color name="premium_card">#141824</color>
    <color name="premium_card_shadow">#59000000</color>
    <color name="premium_ink">#F2F4FA</color>
    <color name="premium_ink_muted">#8A93A8</color>
    <color name="premium_rule">#2A3145</color>
    <color name="premium_divider">#232A3B</color>
    <color name="premium_table_header_bg">#1C2231</color>
    <color name="premium_table_free">#8A93A8</color>
    <color name="premium_price_muted">#7B8398</color>
    <color name="premium_radio_idle">#5D6579</color>
    <!-- The chosen plan wash and the Premium column tick both read as a pale
         blue on white; on dark they need a deep one or they glare. -->
    <color name="premium_accent_wash">#26325C</color>
    <color name="premium_tick_fg">#8CA0EB</color>
    <color name="premium_page_fade">#000B0E14</color>
    <!-- The close button is a light chip on a light page; on dark it becomes a
         raised surface with a light glyph. -->
    <color name="premium_close_bg">#1C2231</color>
    <color name="premium_close_icon">#C9CFDD</color>
</resources>
