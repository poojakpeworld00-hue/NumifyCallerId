<?xml version="1.0" encoding="utf-8"?>
<!-- Network identity chip under the speed dial. Teal is the design's "connection"
     signal and is deliberately not the brand hue — it labels the carrier, not us. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/cid_teal_100" />
    <corners android:radius="100dp" />
</shape>
