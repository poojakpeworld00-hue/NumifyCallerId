<?xml version="1.0" encoding="utf-8"?>
<!--
    Battery — CID03 redesign.

    The cell graphic and its charge chip, then "Right now" tiles and a "Details"
    group, then a shortcut into the system battery settings.

    Two figures the design shows are NOT here: cycle count and time remaining.
    Android exposes neither to a normal app, and inventing them on a screen whose
    whole job is to report the real battery would be the one thing this screen
    must not do.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/batteryRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.BatteryInfoActivity">

        <LinearLayout
            android:id="@+id/crownBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/padBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/glyph_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:text="@string/tools_battery"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/padSettings"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/battery_saver"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/glyph_settings"
                app:tint="@color/primary" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintTop_toBottomOf="@id/crownBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <!-- ===== Cell ===== -->
                <FrameLayout
                    android:layout_width="@dimen/_100sdp"
                    android:layout_height="@dimen/_155sdp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_6sdp">

                    <com.numify.callerid.lookup.feature.tools.BatteryGaugeView
                        android:id="@+id/cellVw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                        <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.03"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_28ssp"
                            android:textStyle="bold"
                            tools:text="68" />

                        <TextView
                            android:id="@+id/lblPercentSign"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_1sdp"
                            android:includeFontPadding="false"
                            android:text="@string/percent_sign"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
                    <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/shape_cid_pill_neutral"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_6sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_13sdp"
                        android:layout_height="@dimen/_13sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/glyph_battery_charging"
                        app:tint="@color/on_surface" />

                    <TextView
                        android:id="@+id/lblStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:includeFontPadding="false"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        tools:text="Charging" />
                </LinearLayout>

                <!-- ===== Right now ===== -->
                <LinearLayout style="@style/NetSectionRow">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/shape_section_dot" />

                    <TextView
                        style="@style/NetSectionLabel"
                        android:text="@string/battery_section_now" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginEnd="@dimen/_4sdp">
                            <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:src="@drawable/glyph_thermometer"
                                app:tint="@color/cid_clay" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/battery_temp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblTemp"
                            style="@style/BattStatValue"
                            tools:text="31 °C" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginStart="@dimen/_4sdp">
                            <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:src="@drawable/glyph_bolt"
                                app:tint="@color/cid_amber" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/battery_voltage" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblVoltage"
                            style="@style/BattStatValue"
                            tools:text="4.21 V" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginEnd="@dimen/_4sdp">
                            <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:src="@drawable/glyph_heartbeat"
                                app:tint="@color/cid_teal" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/battery_health" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblHealth"
                            style="@style/BattStatValue"
                            tools:text="Good" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginStart="@dimen/_4sdp">
                            <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:src="@drawable/glyph_battery"
                                app:tint="@color/primary" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/battery_tech" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblTech"
                            style="@style/BattStatValue"
                            tools:text="Li-ion" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Details ===== -->
                <LinearLayout style="@style/NetSectionRow">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/shape_section_dot" />

                    <TextView
                        style="@style/NetSectionLabel"
                        android:text="@string/battery_section_details" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/shape_cid_chip_brand"
                        android:src="@drawable/glyph_battery_charging"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/battery_capacity" />

                    <TextView
                        android:id="@+id/lblCapacity"
                        style="@style/NetRowValue"
                        tools:text="4285 mAh" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/shape_cid_chip_teal"
                        android:src="@drawable/glyph_plug"
                        app:tint="@color/cid_teal" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/battery_plugged" />

                    <TextView
                        android:id="@+id/lblPlugged"
                        style="@style/NetRowValue"
                        tools:text="USB" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/shape_cid_chip_amber"
                        android:src="@drawable/glyph_view"
                        app:tint="@color/cid_amber" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/battery_screen_on" />

                    <TextView
                        android:id="@+id/lblScreenOn"
                        style="@style/NetRowValue"
                        tools:text="3h 12m" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padSaver"
                    style="@style/ToolCta"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/battery_saver"
                    app:icon="@drawable/glyph_settings" />

                <FrameLayout
                    android:id="@+id/adNativeFrameVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmerVw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native_two" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDividerVw"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
