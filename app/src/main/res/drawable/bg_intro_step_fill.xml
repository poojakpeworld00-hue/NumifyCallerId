<?xml version="1.0" encoding="utf-8"?>
<!-- The current step while screen.onboarding.autonext is counting down: the idle
     track with the accent clipped over it from the start edge. IntroActivity
     drives the clip's level from 0 to 10000 over the autonext duration. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_ds_step_idle" />
    <item>
        <clip
            android:clipOrientation="horizontal"
            android:drawable="@drawable/bg_ds_step_active"
            android:gravity="start" />
    </item>
</layer-list>
