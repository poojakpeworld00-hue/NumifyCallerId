<?xml version="1.0" encoding="utf-8"?>
<!--
    Mulish, the handoff's body face, as a weight family.

    Declared as a family rather than four separate resources so that setting it once
    on the theme gives every TextView the right weight for its textStyle, and so
    `textStyle="bold"` anywhere in the app resolves to real Mulish Bold instead of
    a synthesised smear of the regular.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/mulish_regular"
        android:fontStyle="normal"
        android:fontWeight="400" />
    <font
        android:font="@font/mulish_medium"
        android:fontStyle="normal"
        android:fontWeight="500" />
    <font
        android:font="@font/mulish_semibold"
        android:fontStyle="normal"
        android:fontWeight="600" />
    <font
        android:font="@font/mulish_bold"
        android:fontStyle="normal"
        android:fontWeight="700" />
</font-family>
