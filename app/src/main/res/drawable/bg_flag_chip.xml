<?xml version="1.0" encoding="utf-8"?>
<!--
    Language row · flag chip backdrop.

    A soft rounded square sitting behind the emoji flag. The flag is NOT cropped
    into it — the emoji is sized smaller than the chip so the whole flag reads at
    its own aspect ratio, which a circular crop could not do (an emoji flag is
    wider than it is tall, so a circle ate the hoist and fly ends).

    The fill also gives near-white flags — Japan, and the white bands in several
    others — an edge to sit against on a white card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="@color/surface_2" />
    <corners android:radius="@dimen/_12sdp" />
</shape>
