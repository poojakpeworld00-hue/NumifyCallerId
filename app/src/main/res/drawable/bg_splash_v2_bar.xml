<?xml version="1.0" encoding="utf-8"?>
<!-- The bar that sweeps the groove: `linear-gradient(90deg,#3466F0,#1F3FAE)`. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="@color/ds_accent_bright"
        android:endColor="@color/ds_accent_deep"
        android:type="linear" />
    <corners android:radius="3dp" />
</shape>
