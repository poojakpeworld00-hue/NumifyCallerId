<?xml version="1.0" encoding="utf-8"?>
<!-- The check inside a language row's selection mark: white on the filled brand
     disc when selected, invisible otherwise, so the unselected state is a bare
     outline ring rather than a ring with a ghost tick in it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:color="@color/on_primary"
        android:state_activated="true" />
    <item android:color="@android:color/transparent" />
</selector>
