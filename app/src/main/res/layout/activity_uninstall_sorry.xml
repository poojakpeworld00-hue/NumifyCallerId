<?xml version="1.0" encoding="utf-8"?>
<!-- Uninstall flow · 1b "Sorry for the trouble" (Claude Design "Uninstall Flow Redesign"):
     header tile + title row, three quick-fix cards, primary "Don't uninstall yet",
     quiet "Still want to uninstall", native ad card. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/un_page"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp">

                    <View
                        android:id="@+id/headerTile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_un_tile_lg"
                        android:backgroundTint="@color/un_tile_amber_bg" />

                    <ImageView
                        android:id="@+id/headerIcon"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_un_sad"
                        app:tint="@color/un_tile_amber_fg" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.01"
                        android:text="@string/un_sorry_title"
                        android:textColor="@color/un_ink"
                        android:textSize="22sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/mulish_semibold"
                        android:includeFontPadding="false"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/un_sorry_sub"
                        android:textColor="@color/un_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/mulish_bold"
                android:includeFontPadding="false"
                android:text="@string/un_quick_fixes"
                android:textColor="@color/un_muted"
                android:textSize="12.5sp" />

            <!-- Quick fix 1: caller ID -->
            <LinearLayout
                android:id="@+id/fixCard1"
                style="@style/UnFixCard">

                <ImageView
                    style="@style/UnFixTile"
                    android:backgroundTint="@color/un_tile_blue_bg"
                    android:src="@drawable/ic_un_phone"
                    app:tint="@color/un_tile_blue_fg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/UnFixTitle"
                        android:text="@string/un_fix1_title" />

                    <TextView
                        style="@style/UnFixSub"
                        android:text="@string/un_fix1_sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnFix1"
                    style="@style/UnFixButton"
                    android:text="@string/un_fix" />
            </LinearLayout>

            <!-- Quick fix 2: lookup -->
            <LinearLayout
                android:id="@+id/fixCard2"
                style="@style/UnFixCard"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/UnFixTile"
                    android:backgroundTint="@color/un_tile_green_bg"
                    android:src="@drawable/ic_un_search"
                    app:tint="@color/un_tile_green_fg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/UnFixTitle"
                        android:text="@string/un_fix2_title" />

                    <TextView
                        style="@style/UnFixSub"
                        android:text="@string/un_fix2_sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnFix2"
                    style="@style/UnFixButton"
                    android:text="@string/un_try" />
            </LinearLayout>

            <!-- Quick fix 3: contacts -->
            <LinearLayout
                android:id="@+id/fixCard3"
                style="@style/UnFixCard"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/UnFixTile"
                    android:backgroundTint="@color/un_tile_purple_bg"
                    android:src="@drawable/ic_un_contacts"
                    app:tint="@color/un_tile_purple_fg" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/UnFixTitle"
                        android:text="@string/un_fix3_title" />

                    <TextView
                        style="@style/UnFixSub"
                        android:text="@string/un_fix3_sub" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnFix3"
                    style="@style/UnFixButton"
                    android:text="@string/un_try" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <LinearLayout
                android:id="@+id/btnDontUninstall"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_un_btn_primary"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_un_heart"
                    app:tint="@color/on_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:fontFamily="@font/mulish_bold"
                    android:includeFontPadding="false"
                    android:text="@string/un_dont_uninstall"
                    android:textColor="@color/on_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStillUninstall"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/un_still_uninstall"
                android:textColor="@color/un_muted"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout style="@style/UnAdCard">

        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/admob_big_native" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
</layout>
