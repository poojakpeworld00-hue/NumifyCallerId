<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash — "Scanline" (design: Splash Redesign · direction 1a).

    The app icon sits on a call waveform that runs behind it. The bars light up
    left to right as a sweep band passes across, so the icon reads as the point
    being identified. Six unlabelled feature badges — block, spam, lookup,
    protection, contact, location — pop in around it, mirrored three per side.
    Behind everything, three soft bubbles and two sparkles drift slowly.

    Wordmark + tagline rise in under the composition and the ad disclosure sits
    at the bottom. Geometry is lifted from the design's 412×892 frame, so the
    badge offsets and bar heights below are the design's own numbers in sdp.
    All motion is driven from SplashActivity (UI only — navigation is owned by
    getData()).
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/splashRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/shape_splash_sl_bg"
        android:clipChildren="false"
        android:clipToPadding="false"
        tools:context=".screen.launch.SplashActivity">

        <!-- ===== Ambient layer: four drifting bubbles + two sparkles =====
             Every element is constrained on BOTH axes (start+end, top+bottom) —
             ConstraintLayout ignores a bias unless the view is pinned on both
             sides of that axis. Biases spread the six across all four quadrants
             and keep clear of the centre composition and the wordmark block, so
             the page reads balanced rather than clustered. -->
        <View
            android:id="@+id/bubbleLgVw"
            android:layout_width="@dimen/_58sdp"
            android:layout_height="@dimen/_58sdp"
            android:background="@drawable/shape_splash_sl_bubble"
            android:backgroundTint="@color/splash_sl_bubble_lg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.10"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.14" />

        <View
            android:id="@+id/bubbleSmVw"
            android:layout_width="@dimen/_30sdp"
            android:layout_height="@dimen/_30sdp"
            android:background="@drawable/shape_splash_sl_bubble"
            android:backgroundTint="@color/splash_sl_bubble_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.90"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.28" />

        <View
            android:id="@+id/bubbleMdVw"
            android:layout_width="@dimen/_42sdp"
            android:layout_height="@dimen/_42sdp"
            android:background="@drawable/shape_splash_sl_bubble"
            android:backgroundTint="@color/splash_sl_bubble_md"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.18"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.82" />

        <View
            android:id="@+id/bubbleXsVw"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:background="@drawable/shape_splash_sl_bubble"
            android:backgroundTint="@color/splash_sl_bubble_sm"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.85"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.86" />

        <ImageView
            android:id="@+id/sparkleAVw"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:contentDescription="@null"
            android:src="@drawable/glyph_sl_sparkle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.80"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.13"
            app:tint="@color/splash_sl_sparkle_a" />

        <ImageView
            android:id="@+id/sparkleBVw"
            android:layout_width="@dimen/_14sdp"
            android:layout_height="@dimen/_14sdp"
            android:contentDescription="@null"
            android:src="@drawable/glyph_sl_sparkle"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.14"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.31"
            app:tint="@color/splash_sl_sparkle_b" />

        <!-- ===== Composition: waveform + sweep + icon tile + six badges =====
             Packed vertical chain with the wordmark and tagline, so the whole
             group sits optically centred like the design's flex column. -->
        <FrameLayout
            android:id="@+id/compositionVw"
            android:layout_width="@dimen/_268sdp"
            android:layout_height="@dimen/_136sdp"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintBottom_toTopOf="@id/lblAppName"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">

            <!-- Waveform. The wrapper hugs the bar row so the sweep can be
                 seated on its left edge and driven by translationX. It DOES clip,
                 unlike the rest of the scene, so the repeating scan band enters
                 and leaves at the ends of the wave instead of floating past the
                 badges — but `android:clipChildren` cannot do that here, because
                 compositionVw above switches clipping off for this whole subtree.
                 SplashActivity.startScan() applies the outline clip instead. -->
            <FrameLayout
                android:id="@+id/waveWrapVw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <LinearLayout
                    android:id="@+id/waveRowVw"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_64sdp"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/bar1Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar2Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_27sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar3Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar4Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar5Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_58sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar6Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar7Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_64sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar8Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar9Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar10Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar11Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_33sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />

                    <View
                        android:id="@+id/bar12Vw"
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_15sdp"
                        android:layout_marginStart="@dimen/_11sdp"
                        android:background="@drawable/shape_splash_sl_bar" />
                </LinearLayout>

                <!-- Scan band. Taller than the row so it overhangs top and
                     bottom like the design's -6px inset. -->
                <View
                    android:id="@+id/sweepVw"
                    android:layout_width="@dimen/_56sdp"
                    android:layout_height="@dimen/_76sdp"
                    android:layout_gravity="start|center_vertical"
                    android:alpha="0"
                    android:background="@drawable/shape_splash_sl_sweep" />
            </FrameLayout>

            <!-- Centred app-icon tile -->
            <FrameLayout
                android:id="@+id/iconTileVw"
                android:layout_width="@dimen/_76sdp"
                android:layout_height="@dimen/_76sdp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/shape_splash_sl_tile"
                android:elevation="@dimen/_12sdp"
                android:outlineAmbientShadowColor="@color/splash_sl_tile_shadow"
                android:outlineSpotShadowColor="@color/splash_sl_tile_shadow"
                tools:targetApi="p">

                <ImageView
                    android:layout_width="@dimen/_38sdp"
                    android:layout_height="@dimen/_38sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_phone_solid"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- ===== Six feature badges, mirrored three per side =====
                 Offsets are the design's, measured inside this 268×136 box. -->
            <FrameLayout
                android:id="@+id/badgeBlockVw"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="start|top"
                android:layout_marginStart="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:alpha="0"
                android:background="@drawable/shape_splash_sl_badge"
                android:elevation="@dimen/_6sdp"
                android:outlineAmbientShadowColor="@color/splash_sl_shadow"
                android:outlineSpotShadowColor="@color/splash_sl_shadow"
                tools:targetApi="p">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_block_circle"
                    app:tint="@color/splash_sl_icon_red" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/badgeSpamVw"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="end|top"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:alpha="0"
                android:background="@drawable/shape_splash_sl_badge"
                android:elevation="@dimen/_6sdp"
                android:outlineAmbientShadowColor="@color/splash_sl_shadow"
                android:outlineSpotShadowColor="@color/splash_sl_shadow"
                tools:targetApi="p">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_sl_spam"
                    app:tint="@color/splash_sl_icon_amber" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/badgeLookupVw"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:alpha="0"
                android:background="@drawable/shape_splash_sl_badge"
                android:elevation="@dimen/_6sdp"
                android:outlineAmbientShadowColor="@color/splash_sl_shadow"
                android:outlineSpotShadowColor="@color/splash_sl_shadow"
                tools:targetApi="p">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_search"
                    app:tint="@color/splash_sl_icon_blue" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/badgeProtectionVw"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="start|bottom"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:alpha="0"
                android:background="@drawable/shape_splash_sl_badge"
                android:elevation="@dimen/_6sdp"
                android:outlineAmbientShadowColor="@color/splash_sl_shadow"
                android:outlineSpotShadowColor="@color/splash_sl_shadow"
                tools:targetApi="p">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_sl_protection"
                    app:tint="@color/splash_sl_icon_green" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/badgeContactVw"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="start|top"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_marginTop="@dimen/_50sdp"
                android:alpha="0"
                android:background="@drawable/shape_splash_sl_badge"
                android:elevation="@dimen/_6sdp"
                android:outlineAmbientShadowColor="@color/splash_sl_shadow"
                android:outlineSpotShadowColor="@color/splash_sl_shadow"
                tools:targetApi="p">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_sl_contact"
                    app:tint="@color/splash_sl_icon_blue" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/badgeLocationVw"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:layout_gravity="end|top"
                android:layout_marginTop="@dimen/_50sdp"
                android:layout_marginEnd="@dimen/_2sdp"
                android:alpha="0"
                android:background="@drawable/shape_splash_sl_badge"
                android:elevation="@dimen/_6sdp"
                android:outlineAmbientShadowColor="@color/splash_sl_shadow"
                android:outlineSpotShadowColor="@color/splash_sl_shadow"
                tools:targetApi="p">

                <ImageView
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/glyph_row_city"
                    app:tint="@color/splash_sl_icon_blue" />
            </FrameLayout>
        </FrameLayout>

        <!-- ===== Wordmark + tagline ===== -->
        <TextView
            android:id="@+id/lblAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_22sdp"
            android:alpha="0"
            android:fontFamily="@font/figtree_bold"
            android:letterSpacing="-0.025"
            android:text="@string/splash_title"
            android:textColor="@color/splash_sl_title"
            android:textSize="@dimen/_30ssp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/lblTagline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/compositionVw" />

        <TextView
            android:id="@+id/lblTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:alpha="0"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:text="@string/splash_tagline"
            android:textColor="@color/splash_sl_tagline"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/lblAppName" />

        <!-- ===== Ad disclosure ===== -->
        <TextView
            android:id="@+id/lblAdDisclosure"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_14sdp"
            android:alpha="0"
            android:fontFamily="@font/figtree_semibold"
            android:gravity="center"
            android:text="@string/splash_footer"
            android:textColor="@color/splash_sl_footer"
            android:textSize="@dimen/_11ssp"
            app:layout_constraintBottom_toTopOf="@id/progTrack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== Boot progress + build stamp =====
             The bar fills while the getData() chain (consent → remote config →
             geo → permissions) runs, so a slow cold start still looks like it is
             getting somewhere. It is a progress INDICATOR, not a progress report:
             nothing here drives navigation. -->
        <View
            android:id="@+id/progTrack"
            android:layout_width="@dimen/_110sdp"
            android:layout_height="@dimen/_4sdp"
            android:layout_marginBottom="@dimen/_12sdp"
            android:alpha="0"
            android:background="@drawable/shape_splash_sl_prog_track"
            app:layout_constraintBottom_toTopOf="@id/secureRowVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Seeded to a small nub so the bar never reads as empty; SplashActivity
             animates its real width (not scaleX, which would stretch the rounded
             caps into a lens). -->
        <View
            android:id="@+id/progFill"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_4sdp"
            android:alpha="0"
            android:background="@drawable/shape_splash_sl_prog_fill"
            app:layout_constraintBottom_toBottomOf="@id/progTrack"
            app:layout_constraintStart_toStartOf="@id/progTrack"
            app:layout_constraintTop_toTopOf="@id/progTrack" />

        <LinearLayout
            android:id="@+id/secureRowVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_18sdp"
            android:alpha="0"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:contentDescription="@null"
                android:src="@drawable/glyph_sl_shield_check" />

            <!-- Text is set from BuildConfig in SplashActivity, so it tracks the
                 real build instead of a hardcoded string. -->
            <TextView
                android:id="@+id/lblSecureVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/figtree_semibold"
                android:letterSpacing="0.04"
                android:textColor="@color/splash_sl_footer"
                android:textSize="@dimen/_10ssp"
                tools:text="Secure v1.2 (3)" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
