<?xml version="1.0" encoding="utf-8"?>
<!--
    Onboarding illustration card (steps 1 and 3). Stays white in BOTH themes on
    purpose: the design renders this card light even on the dark step, because it
    is a picture of the product, not a surface of the current screen.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="285"
        android:endColor="#F7F4FF"
        android:startColor="#FFFFFF"
        android:type="linear" />
    <corners android:radius="@dimen/_23sdp" />
    <stroke
        android:width="1dp"
        android:color="#142563EB" />
</shape>
