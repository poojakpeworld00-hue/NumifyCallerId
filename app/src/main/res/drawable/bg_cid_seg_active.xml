<?xml version="1.0" encoding="utf-8"?>
<!-- The selected segment: the brand fill on an 11dp radius, not a white chip on
     a grey track. The handoff fills the active half so the choice is legible at
     a glance rather than by which half looks recessed. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_accent" />
    <corners android:radius="11dp" />
</shape>
