<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_page"
    android:orientation="vertical">

    <!-- Compact header (pads the status-bar inset from LookupFragment) -->
    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <!-- Lookup is its own Activity now rather than a tab, so it needs a way
             out that isn't the system gesture. -->
        <ImageView
            android:id="@+id/buttonLookupBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_ds_inner_search"
            android:contentDescription="@string/action_back"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/ds_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/nav_lookup"
                android:textColor="@color/ds_ink"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/mulish_semibold"
                android:includeFontPadding="false"
                android:text="@string/lookup_header_sub"
                android:textColor="@color/ds_ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/buttonLookupHistory"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ds_inner_search"
            android:contentDescription="@string/recent_lookups"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_history"
            app:tint="@color/ds_ink" />
    </LinearLayout>

    <!-- Single search pill: +country · number · clear · search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_ds_inner_field"
        android:elevation="@dimen/_2sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/ds_card_shadow"
        android:outlineSpotShadowColor="@color/ds_card_shadow"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingVertical="@dimen/_6sdp">

        <LinearLayout
            android:id="@+id/columnCountryPickerSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_6sdp">

            <!-- Flag and dial code both sit in a fixed-height box and centre inside
                 it. An emoji flag's font metrics are nothing like the Latin text
                 beside it, so with wrap_content heights the two optical centres do
                 not line up however they are gravitied — the box is what makes them
                 agree. Same textSize for the same reason. -->
            <TextView
                android:id="@+id/textFlagSearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="@dimen/_11ssp"
                tools:text="🇮🇳" />

            <TextView
                android:id="@+id/textCountrySearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                tools:text="+91" />

            <!-- Caret as a sized ImageView: a compound drawable draws at its own
                 intrinsic 24dp, which towers over an 11ssp label. -->
            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_caret_down"
                app:tint="@color/ds_ink_muted" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@color/ds_rule" />

        <EditText
            android:id="@+id/inputNumberInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/lookup_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="@color/ds_ink"
            android:textColorHint="@color/ds_ink_muted"
            android:textSize="@dimen/_11ssp" />

        <ImageView
            android:id="@+id/imageClear"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/ic_close"
            android:visibility="gone"
            app:tint="@color/ds_ink_muted" />

        <ImageView
            android:id="@+id/buttonSearch"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_2sdp"
            android:background="@drawable/bg_circle_primary"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lookup_search_number"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/ic_search"
            app:tint="@color/ds_on_accent" />
    </LinearLayout>

    <!-- Paste suggestion — shown only when the clipboard holds a phone number.
         40dp lavender pill: clipboard glyph + "Paste" + mono number (per design). -->
    <LinearLayout
        android:id="@+id/chipPaste"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/bg_cta_pill"
        android:clickable="true"
        android:elevation="@dimen/_2sdp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:contentDescription="@string/lookup_paste"
            android:src="@drawable/ic_paste"
            app:tint="@color/ds_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/lookup_paste"
            android:textColor="@color/ds_accent"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textPasteNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/ds_accent"
            android:textSize="@dimen/_11ssp"
            tools:text="+91 98220 41177" />
    </LinearLayout>

    <!-- Native-banner ad slot, directly under the flag/paste row. Filled by
         BaseFragment.showScreenAd() from this fragment's own `ScreenAds` entry;
         stays GONE when ads are off or `show:false`. Outside the scroll view so
         it holds its position at the top of the tab. -->
    <FrameLayout
        android:id="@+id/adNativeFrame"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:visibility="gone">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/adShimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/admob_native_banner" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Shimmer skeleton shown during search loading -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_border"
                android:orientation="vertical"
                android:padding="@dimen/_12sdp">

                <View
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:alpha="0.18"
                    android:background="@drawable/bg_shimmer_placeholder" />

                <View
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:alpha="0.18"
                    android:background="@drawable/bg_shimmer_placeholder" />

                <View
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:alpha="0.18"
                    android:background="@drawable/bg_shimmer_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginVertical="@dimen/_14sdp"
                    android:alpha="0.12"
                    android:background="@color/ds_ink_muted" />

                <View
                    android:layout_width="@dimen/_140sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:alpha="0.18"
                    android:background="@drawable/bg_shimmer_placeholder" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/_16sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Result card.
                     Built in the same language as the block-a-number dialog: a
                     rounded icon chip heading the block, one bordered container
                     holding the facts, and an outlined/filled action pair at the
                     foot. Sharing the language matters because both surfaces are
                     "here is a number, decide what to do about it". -->
                <LinearLayout
                    android:id="@+id/cardResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_ds_card"
                    android:elevation="@dimen/_1sdp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:padding="@dimen/_14sdp"
                    android:visibility="gone">

                    <!-- ===== Header ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_38sdp"
                            android:layout_height="@dimen/_38sdp"
                            android:background="@drawable/bg_cid_chip_brand"
                            android:contentDescription="@null"
                            android:padding="@dimen/_9sdp"
                            android:src="@drawable/ic_search"
                            app:tint="@color/ds_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/mulish_bold"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.057"
                                android:text="@string/number_lookup"
                                android:textAllCaps="true"
                                android:textColor="@color/ds_ink_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/textResNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/space_grotesk_bold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/ds_ink"
                                android:textSize="19sp"
                                tools:text="+91 704 605 4874" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/textResName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:fontFamily="@font/mulish_semibold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/ds_ink_muted"
                                    android:textSize="12.5sp"
                                    tools:text="Unknown caller" />

                                <ImageView
                                    android:id="@+id/imageRevealName"
                                    android:layout_width="@dimen/_20sdp"
                                    android:layout_height="@dimen/_20sdp"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:contentDescription="@string/lookup_unknown_caller"
                                    android:padding="@dimen/_2sdp"
                                    android:src="@drawable/ic_view"
                                    android:visibility="gone"
                                    app:tint="@color/ds_accent" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/buttonResCall"
                            android:layout_width="@dimen/_38sdp"
                            android:layout_height="@dimen/_38sdp"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:background="@drawable/bg_cid_chip_teal"
                            android:contentDescription="@string/action_call"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="@dimen/_9sdp"
                            android:src="@drawable/ic_call"
                            app:tint="@color/cid_teal" />
                    </LinearLayout>

                    <!-- Verdict pill. Text, colours and icon are all set from
                         NumberFinderFragment.bindStatusPill(). -->
                    <TextView
                        android:id="@+id/textResValid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/success_soft"
                        android:drawablePadding="@dimen/_5sdp"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/_11sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:textColor="@color/success"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/ic_verified"
                        app:drawableTint="@color/success"
                        tools:text="Valid number" />

                    <!-- ===== Facts =====
                         Three tiles across, not three stacked rows: country,
                         carrier and line type are one-word answers of equal
                         standing, and a list gave them an order and three icons
                         they did not need. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            style="@style/LookupFactTile"
                            android:layout_marginEnd="4dp">

                            <TextView
                                style="@style/LookupFactTileLabel"
                                android:text="@string/lookup_country" />

                            <TextView
                                android:id="@+id/textResCountry"
                                style="@style/LookupFactTileValue"
                                tools:text="India" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/LookupFactTile"
                            android:layout_marginHorizontal="4dp">

                            <TextView
                                style="@style/LookupFactTileLabel"
                                android:text="@string/lookup_carrier" />

                            <TextView
                                android:id="@+id/textResCarrier"
                                style="@style/LookupFactTileValue"
                                tools:text="Idea" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/LookupFactTile"
                            android:layout_marginStart="4dp">

                            <TextView
                                style="@style/LookupFactTileLabel"
                                android:text="@string/lookup_line_type" />

                            <TextView
                                android:id="@+id/textResType"
                                style="@style/LookupFactTileValue"
                                tools:text="Mobile" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ===== Actions ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:orientation="horizontal">

                        <!-- Share is a tinted inset, not an outlined button, and the
                             primary action takes the wider share of the row — the
                             handoff's 1 : 1.4 split. Both on a 14dp radius rather
                             than a full pill, to match the tiles above them. -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonResShare"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/action_share"
                            android:textAllCaps="false"
                            android:textColor="@color/ds_ink"
                            android:textSize="13sp"
                            app:backgroundTint="@color/ds_page"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_share"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconSize="15dp"
                            app:iconTint="@color/ds_ink" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonShowFullDetail"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1.4"
                            android:fontFamily="@font/mulish_bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/show_full_detail"
                            android:textAllCaps="false"
                            android:textColor="@color/ds_on_accent"
                            android:textSize="13sp"
                            app:backgroundTint="@color/ds_accent"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>


                <!-- Empty state — animated breathing search icon (no Lottie) -->
                <LinearLayout
                    android:id="@+id/columnEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_32sdp"
                    android:visibility="gone">

                    <!-- Two badges orbit the pulsing disc: one says "we name
                         callers", the other "we flag spam". They are what makes
                         the empty state describe the feature rather than just
                         decorate the gap. -->
                    <FrameLayout
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="@dimen/_86sdp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.numify.callerid.lookup.feature.widgets.RippleIconView
                            android:layout_width="@dimen/_82sdp"
                            android:layout_height="@dimen/_82sdp"
                            android:layout_gravity="center"
                            app:ripple_disc="@drawable/bg_empty_circle_tools"
                            app:ripple_icon="@drawable/ic_search_plus"
                            app:ripple_iconSize="@dimen/_34sdp"
                            app:ripple_iconTint="@color/ds_accent"
                            app:ripple_ring="@drawable/bg_ring_tools" />

                        <ImageView
                            android:id="@+id/badgeNamed"
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/bg_cid_chip_teal"
                            android:contentDescription="@null"
                            android:padding="@dimen/_6sdp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/cid_teal" />

                        <ImageView
                            android:id="@+id/badgeSpam"
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/bg_cid_chip_clay"
                            android:contentDescription="@null"
                            android:padding="@dimen/_6sdp"
                            android:src="@drawable/ic_block_circle"
                            app:tint="@color/cid_clay" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:gravity="center"
                        android:letterSpacing="-0.025"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/lookup_empty_title"
                        android:textColor="@color/ds_ink"
                        android:textSize="@dimen/_17ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/lookup_empty_sub"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="@dimen/_11ssp" />

                    <LinearLayout
                        android:id="@+id/buttonEmptySearch"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_18sdp"
                        android:background="@drawable/bg_cid_cta_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_20sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@string/lookup_empty_cta"
                            android:src="@drawable/ic_search"
                            app:tint="@color/ds_on_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:text="@string/lookup_empty_cta"
                            android:textColor="@color/ds_on_accent"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- History Header -->
                <LinearLayout
                    android:id="@+id/columnHistoryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:visibility="gone">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/bg_section_dot" />

                    <TextView
                        android:id="@+id/textHistoryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="@string/recent_lookups"
                        android:textAllCaps="true"
                        android:textColor="@color/ds_ink"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textHistoryClearAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/_4sdp"
                        android:text="@string/clear_all"
                        android:textColor="@color/ds_accent"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- One grouped card, as on every other list in the app. It
                     wraps its content, so the card ends where the history does. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:background="@drawable/bg_ds_card"
                    android:clipToOutline="true"
                    android:clipToPadding="false"
                    android:elevation="6dp"
                    android:nestedScrollingEnabled="false"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:listitem="@layout/item_search_history" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/ds_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:text="@string/lookup_privacy"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

</LinearLayout>
