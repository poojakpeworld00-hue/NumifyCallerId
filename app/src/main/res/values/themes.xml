<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CallerIDPhoneLookup" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- App-wide body face: Mulish, the handoff's body font, as a weight family
             so textStyle="bold" resolves to real Mulish Bold rather than a
             synthesised one. Display text sets Space Grotesk explicitly where the
             design calls for it.

             @font/mulish_ui, not @font/mulish: the UI ramp maps the default weight
             to Mulish Medium so unstyled text is not the thin Regular. See that
             file for why, and for why bold is left where it is. -->
<!--        <item name="android:fontFamily">@font/mulish_ui</item>-->
<!--        <item name="fontFamily">@font/mulish_ui</item>-->

        <item name="colorPrimary">@color/primary</item>
        <!-- Paired with colorPrimary. Without it Material3 falls back to its own

             baseline, which in dark mode is a purple: the Call button drew that

             against a blue ground and the label was all but unreadable. -->

        <item name="colorOnPrimary">@color/on_primary</item>

        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/background</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <!-- Transparent, because the bar is hidden (BaseActivity.applyImmersiveNavigation)
             and only ever returns as a transient overlay on a swipe. A solid
             colour would paint a band over the content underneath it for the
             seconds it is up. enforceNavigationBarContrast turns off the scrim
             the platform would otherwise add behind a transparent bar on API 29+. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.CallerIDPhoneLookup" parent="Base.Theme.CallerIDPhoneLookup" />

    <!--
        Transparent host for the overlay-permission guide. The window is
        translucent so the screen behind shows through, with a system-applied
        dim to focus attention on the bottom guide card.
    -->
    <style name="Theme.OverlayGuide" parent="Theme.CallerIDPhoneLookup">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
    <!--
        Host for the missed-call reply picker. Translucent like Theme.OverlayGuide
        but with the system dim OFF: activity_smart_reply paints its own scrim, and
        the two together read as almost-black.
    -->
    <style name="Theme.SmartReply" parent="Theme.CallerIDPhoneLookup">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>