<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/home_caller_id"
                android:textColor="@color/ds_ink"
                android:textSize="24sp" />

            <!-- Live counts, set from CallLogFragment. -->
            <TextView
                android:id="@+id/textRecentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/mulish_semibold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink_muted"
                android:textSize="13sp"
                tools:text="32 calls · 14 missed" />
        </LinearLayout>

        <ImageView
            android:id="@+id/buttonRecentsFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ds_header_chip"
            android:contentDescription="@string/filter_all"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_filter_list"
            app:tint="@color/ds_ink" />

        <ImageView
            android:id="@+id/buttonSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_ds_header_chip"
            android:contentDescription="@string/nav_settings"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/ds_ink" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_page"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardProtection"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_protection_on"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/imageProtection"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_ds_shield_check" />

                <TextView
                    android:id="@+id/textProtectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/mulish_bold"
                    android:lineSpacingMultiplier="1.25"
                    android:text="@string/home_protection_off_line"
                    android:textColor="@color/ds_success"
                    android:textSize="12.5sp" />

                <!-- The two-line form is gone; kept (and hidden) because
                     CallLogFragment still sets it, and a status line reads better
                     as one sentence than as a heading with a caption. -->
                <TextView
                    android:id="@+id/textProtectionSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    tools:ignore="SpeakableTextPresentCheck" />

                <TextView
                    android:id="@+id/buttonProtectionAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/mulish_bold"
                    android:minHeight="32dp"
                    android:gravity="center"
                    android:text="@string/home_protection_manage"
                    android:textColor="@color/ds_success"
                    android:textSize="12.5sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/columnPermHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/ds_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/home_perm_hint"
                android:textColor="@color/ds_ink"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/buttonPermManage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/home_perm_manage"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardLookup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <!-- No heading above the field any more: the design folds the question
                 into the placeholder ("Who\'s calling? Search a number") and lets
                 the row stand on its own, which is what keeps the top of Home to a
                 title, a field and a status line instead of three stacked cards. -->

            <!-- Search and Ask AI share a row: asking about a number and
                 searching for one are the same intent, so they read as a pair.
                 Deliberately NOT in the header icon cluster next to the gear,
                 where an entry point this new gets missed. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_home_field"
                android:elevation="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:outlineAmbientShadowColor="@color/ds_card_shadow"
                android:outlineSpotShadowColor="@color/ds_card_shadow"
                android:padding="6dp">

                <LinearLayout
                    android:id="@+id/columnHomeCountry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_5sdp"
                    android:paddingVertical="@dimen/_6sdp">

                    <!-- Flag and dial code both sit in a fixed-height box and centre
                         inside it. An emoji flag's font metrics are nothing like the
                         Latin text beside it, so with wrap_content heights the two
                         optical centres never line up however they are gravitied.
                         Same textSize for the same reason. -->
                    <TextView
                        android:id="@+id/textHomeFlag"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textSize="@dimen/_11ssp"
                        tools:text="🇮🇳" />

                    <TextView
                        android:id="@+id/textHomeDial"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_22sdp"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/ds_ink"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        tools:text="+91" />

                    <!-- Caret as a sized ImageView: a compound drawable draws at its
                         own intrinsic 24dp, which towers over an 11ssp label. -->
                    <ImageView
                        android:layout_width="@dimen/_11sdp"
                        android:layout_height="@dimen/_11sdp"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_caret_down"
                        app:tint="@color/ds_ink_muted" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:layout_marginEnd="@dimen/_9sdp"
                    android:background="@color/ds_rule" />

                <EditText
                    android:id="@+id/inputSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/mulish_semibold"
                    android:hint="@string/home_search_placeholder"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:includeFontPadding="false"
                    android:inputType="text"
                    android:lineSpacingMultiplier="1.15"
                    android:paddingHorizontal="2dp"
                    android:textColor="@color/ds_ink"
                    android:textColorHint="@color/ds_placeholder"
                    android:textSize="13.5sp"
                    tools:ignore="TextFields" />

                <ImageView
                    android:id="@+id/buttonClearSearch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/action_cancel"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="@color/ds_ink_muted" />

                <ImageView
                    android:id="@+id/buttonHomeSearch"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_ds_search_square"
                    android:contentDescription="@string/lookup_hint"
                    android:padding="9dp"
                    android:src="@drawable/ic_ds_search"
                    app:tint="@color/ds_on_accent" />
            </LinearLayout>

                <!-- Icon-only, as the design draws it. The label is carried by
                     contentDescription for screen readers and by the first-run
                     tooltip below for everyone else, so dropping it costs nothing. -->
                <com.numify.callerid.lookup.feature.widgets.AiTileView
                    android:id="@+id/buttonAskAi"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:contentDescription="@string/ai_ask_button"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:outlineAmbientShadowColor="@color/ds_fab_shadow"
                    android:outlineSpotShadowColor="@color/ds_fab_shadow"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_ai_sparkle"
                        app:tint="@color/ds_on_accent" />
                </com.numify.callerid.lookup.feature.widgets.AiTileView>
            </LinearLayout>

            <!-- First-run only, 3s, then never again. Right-aligned so it points
                 back at the button it is explaining. -->
            <TextView
                android:id="@+id/textAskAiTooltip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/_5sdp"
                android:background="@drawable/bg_ai_tooltip"
                android:paddingHorizontal="@dimen/_10sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/ai_tooltip_first_run"
                android:textColor="@color/ds_page"
                android:textSize="@dimen/_9ssp"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:id="@+id/adNativeDivider"
            android:layout_marginTop="@dimen/_10sdp"
            style="@style/AdDivider" />

        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_2">

                <include layout="@layout/admob_native_banner" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <View
            android:id="@+id/adNativeDivider1"
            style="@style/AdDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:letterSpacing="-0.01"
            android:text="@string/home_recent_label"
            android:textColor="@color/ds_ink"
            android:textSize="@dimen/_13ssp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_16sdp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/ic_recent_all"
                    android:text="@string/filter_all" />

                <TextView
                    android:id="@+id/tabIncoming"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/filter_incoming"
                    android:text="@string/filter_incoming" />

                <TextView
                    android:id="@+id/tabOutgoing"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/filter_outgoing"
                    android:text="@string/filter_outgoing" />

                <TextView
                    android:id="@+id/tabMissed"
                    style="@style/RecentFilterTab"
                    android:layout_marginEnd="0dp"
                    android:drawableStart="@drawable/ic_call_missed"
                    android:text="@string/filter_missed" />
            </LinearLayout>
        </HorizontalScrollView>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- One grouped card rather than loose rows — the handoff's
             `background:#fff; border-radius:18px; overflow:hidden`, and the same
             frame item_contact already sits in.

             The 16dp bottom margin is the handoff's `margin-bottom:16px`, and it
             is doing real work here: the content area ends flush with the top of
             the nav island, so without it a row is guillotined exactly where the
             island's white begins and the two read as one shape. This keeps a
             band of page colour between them at every scroll position. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listRecents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_ds_card"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_call" />

        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/recents_empty"
            android:textColor="@color/ds_ink_muted"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/buttonRecentsDial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_16sdp"
            android:background="@drawable/bg_home_protection"
            android:clickable="true"
            android:elevation="@dimen/_6sdp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:paddingHorizontal="@dimen/_18sdp"
            android:paddingVertical="@dimen/_12sdp">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:contentDescription="@string/quick_dialer"
                android:src="@drawable/ic_dialpad"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="@string/quick_dialer"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
            A NestedScrollView, not a plain column, and that is load-bearing.

            Everything above the list — protection banner, permission hint,
            lookup card, native ad, Recent label, filter tabs — rides in the
            AppBarLayout, which only scrolls off when a nested-scrolling child
            reports a drag. While the permission state is up, [listRecents] is
            GONE, so if this were a LinearLayout nothing would report anything:
            the header could not collapse, and on a shorter phone its lower half
            (and every button in it) sat below the fold, unreachable and
            untappable. fillViewport keeps the content centred when it does fit.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/permState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/_70sdp"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_32sdp">

            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/bg_icon_box"
                android:contentDescription="@string/perm_calllog_title"
                android:padding="@dimen/_16sdp"
                android:src="@drawable/ic_history"
                app:tint="@color/ds_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="@string/perm_calllog_title"
                android:textColor="@color/ds_ink"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:text="@string/perm_calllog_message"
                android:textColor="@color/ds_ink_muted"
                android:textSize="@dimen/_11ssp" />

            <TextView
                android:id="@+id/buttonGrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_24sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:text="@string/action_grant"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
