<?xml version="1.0" encoding="utf-8"?>
<!-- Back chevron for the detail screens: `M15 6l-6 6 6 6`, 2.2 stroke, round
     caps — the mirror of ic_ds_chevron_right, so back and forward are the same
     mark pointing opposite ways. Tinted at the use site. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal"
    android:autoMirrored="true">
    <path
        android:pathData="M15,6L9,12L15,18"
        android:strokeWidth="2.2"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
