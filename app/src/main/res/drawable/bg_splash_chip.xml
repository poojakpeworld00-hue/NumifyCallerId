<?xml version="1.0" encoding="utf-8"?>
<!-- One of the three capability chips under the tagline: the app surface at a
     12dp radius. The design's `0 4px 12px rgba(20,30,60,0.06)` comes from
     elevation at the use site so it tracks the rounded outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface" />
    <corners android:radius="12dp" />
</shape>
