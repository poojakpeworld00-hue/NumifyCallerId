<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- The icon sits in a 38dp tinted chip on an 11dp radius. The tint is
             per row and set by SettingsActivity, which is what the handoff's
             `r.bg` does - a different wash for each destination so the list is
             scannable by colour as well as by label. -->
        <ImageView
            android:id="@+id/imageIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:padding="10dp"
            tools:src="@drawable/ic_star"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulish_bold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink"
                android:textSize="14.5sp"
                tools:text="Rate Us" />

            <TextView
                android:id="@+id/textSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/mulish_semibold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink_muted"
                android:textSize="11.5sp"
                tools:text="Love the app? Let us know." />
        </LinearLayout>

        <ImageView
            android:id="@+id/imageTrailing"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/ds_chevron"
            tools:ignore="ContentDescription" />
    </LinearLayout>
</layout>
