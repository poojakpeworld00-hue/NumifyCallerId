<?xml version="1.0" encoding="utf-8"?>
<!-- Tools category header (Measure · Device · Time), spans the whole grid row.
     The rule runs from the label to the edge so the eye is carried across the
     group it labels rather than stopping at the text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="20dp"
    android:layout_marginBottom="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="6dp">

    <TextView
        android:id="@+id/textToolCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/mulish_bold"
        android:letterSpacing="0.0909"
        android:textAllCaps="true"
        android:textColor="@color/ds_ink_muted"
        android:textSize="11sp"
        tools:text="Measure" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@color/ds_rule" />
</LinearLayout>
