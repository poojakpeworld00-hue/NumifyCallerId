<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared by both assistant tools: Spam Scanner and Unsaved callers. They are the
    same shape — scan the call log, rank what comes back, offer one action per row
    — so they share a layout and differ only in title, empty copy and row action.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:id="@+id/scanRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_10sdp">

            <ImageView
                android:id="@+id/buttonScanBack"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textScanTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_15ssp"
                    android:textStyle="bold"
                    tools:text="Spam scanner" />

                <TextView
                    android:id="@+id/textScanSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_9ssp"
                    tools:text="6 numbers worth blocking" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressScan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/_40sdp" />

        <!-- Empty state doubles as the success state: nothing to block is good news. -->
        <LinearLayout
            android:id="@+id/columnScanEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_28sdp"
            android:visibility="gone"
            tools:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_ai_sparkle"
                app:tint="@color/on_surface_variant" />

            <TextView
                android:id="@+id/textScanEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_11ssp"
                tools:text="Nothing worth blocking" />
        </LinearLayout>

        <!-- One grouped card, as on recents, contacts and the blocklist. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listScan"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="20dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ds_card"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:listitem="@layout/item_ai_scan"
            tools:visibility="visible" />
    </LinearLayout>
</layout>
