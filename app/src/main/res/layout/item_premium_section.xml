<?xml version="1.0" encoding="utf-8"?>
<!--
    Section heading, from the design:

        6px brand dot · 8px gap · 11px/800 label at 1.3px tracking · 1px rule

    Used twice - "What you unlock" and "Choose your plan" - so the label text is
    set at the use site. Wrapped in <layout> because activity_premium.xml is a
    DataBinding layout and only a DataBinding include yields a typed field for
    the row.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_premium_section_dot" />

        <TextView
            android:id="@+id/textSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/mulish_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.118"
            android:textColor="@color/premium_ink_muted"
            android:textSize="11sp"
            tools:text="What you unlock" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@color/premium_rule" />
    </LinearLayout>
</layout>
