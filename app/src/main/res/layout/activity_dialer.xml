<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/dialerRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".screen.keypad.DialerActivity">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                style="@style/ToolHeaderBack"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                style="@style/ToolHeaderTitle"
                android:text="@string/dialer_title" />
        </LinearLayout>

        <!--
            Matches and the number actions share the band between the title and
            the keypad, and both start at the top of it.

            They were bottom-aligned, hugging the keypad, on the reasoning that a
            single match should not be stranded up by the title. What that
            actually produced was the opposite complaint: a short card pushed to
            the bottom leaves a hand's width of empty page directly under
            "Dialer", which reads as a missing element rather than as breathing
            room. Top-aligned, the band fills from the title downwards and the
            slack collects above the keypad, where it looks like the gap it is —
            which is also how the handoff's reference dialer draws it.

            It scrolls because the two together can outgrow the band — the
            action card plus a few matches is taller than what is left over a
            keypad sheet on a short screen, and before this they simply had
            nowhere to go.

            The bottom margin is what keeps that from reading as a bug. The band
            ended flush against the sheet, so the last match was sliced through
            the middle by the sheet's edge and its card lost its rounded bottom —
            which looks like the list running underneath the number field rather
            than a list that scrolls. A strip of page colour between the two says
            "there is more below" instead.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/matchesScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/dialpadPanel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:id="@+id/matchesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="vertical">

                <!--
                    What you can do with the number you have typed, as a list of
                    rows — the shape every stock dialer uses.

                    First in the band, above the matches, which is where Google's
                    dialer puts it and is the right order for what this block
                    means: it appears only for a number that is *not* in your
                    contacts, so it is the answer to "this number is unknown —
                    here is what you can do with it". Below the matches it read
                    as a footnote to a list it has nothing to do with.

                    This replaces a single "Add to contacts" pill that sat inside
                    the keypad sheet. One action had room there; five do not, and
                    a row of chips would have had to abbreviate every label.

                    GONE, not INVISIBLE: the block only exists once digits are
                    typed, and reserving five rows' worth of empty space above an
                    untouched keypad would leave the screen looking broken. The
                    pill needed INVISIBLE because it sat between the number and
                    the keys, where a reflow made the number appear to blink;
                    nothing below this moves when it appears.
                -->
                <LinearLayout
                    android:id="@+id/columnDialActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginBottom="@dimen/_10sdp"
                    android:background="@drawable/bg_ds_card"
                    android:clipToOutline="true"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!--
                        The typed number as a row, not a caption: avatar, number
                        over its status, and a call button on the end — the same
                        three-part shape a contact row has, which is how the
                        reference dialer heads this block.

                        It is the object the five verbs below act on. As a plain
                        line of text it read as a label on the card; as a row it
                        reads as "this number", and it can carry the one action
                        that should not need scrolling past four others to reach.
                    -->
                    <LinearLayout
                        android:id="@+id/rowDialNumberHead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="10dp">

                        <!-- The same avatar every list in the app draws: a disc
                             tinted from AvatarPalette with the initials over it,
                             set by DialerFragment. It was a flat grey chip with a
                             generic person glyph, which made this row the one
                             place a number is shown without the avatar treatment
                             Recents and Contacts give it. -->
                        <TextView
                            android:id="@+id/textDialHeadAvatar"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_ds_avatar_circle"
                            android:fontFamily="@font/mulish_bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:textColor="@color/ds_on_accent"
                            android:textSize="13sp"
                            tools:text="+" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textDialActionsNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/mulish_bold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/ds_ink"
                                android:textSize="15sp"
                                tools:text="+1 234 567" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/mulish_semibold"
                                android:includeFontPadding="false"
                                android:text="@string/dialer_number_not_saved"
                                android:textColor="@color/ds_ink_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/buttonDialHeadCall"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_circle_surface"
                            android:contentDescription="@string/action_call"
                            android:padding="9dp"
                            android:src="@drawable/ic_call"
                            app:tint="@color/ds_accent" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="16dp"
                        android:background="@color/ds_divider" />

                    <LinearLayout
                        android:id="@+id/rowAddContact"
                        style="@style/DialerAction">

                        <ImageView
                            style="@style/DialerActionIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_person_add" />

                        <TextView
                            style="@style/DialerActionLabel"
                            android:text="@string/add_to_contacts" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowDialMessage"
                        style="@style/DialerAction">

                        <ImageView
                            style="@style/DialerActionIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_message" />

                        <TextView
                            style="@style/DialerActionLabel"
                            android:text="@string/dialer_send_message" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowDialLookup"
                        style="@style/DialerAction">

                        <ImageView
                            style="@style/DialerActionIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_nav_lookup" />

                        <TextView
                            style="@style/DialerActionLabel"
                            android:text="@string/dialer_lookup_number" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowDialWhatsApp"
                        style="@style/DialerAction">

                        <ImageView
                            style="@style/DialerActionIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_whatsapp" />

                        <TextView
                            style="@style/DialerActionLabel"
                            android:text="@string/dialer_send_whatsapp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rowDialAskAi"
                        style="@style/DialerAction">

                        <ImageView
                            style="@style/DialerActionIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ai_sparkle" />

                        <TextView
                            style="@style/DialerActionLabel"
                            android:text="@string/ai_ask_button" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Section label — shown while matches exist -->
                <TextView
                    android:id="@+id/textMatchesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/mulish_bold"
                    android:letterSpacing="0.118"
                    android:text="@string/dialer_matches"
                    android:textAllCaps="true"
                    android:textColor="@color/ds_ink_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- Match list (vertical, filtered by the dialed number), in one
                     grouped card like every other list in the app. It wraps its
                     content rather than filling the screen, so the card ends where
                     the matches do. -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listFrequent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:background="@drawable/bg_ds_card"
                    android:clipToOutline="true"
                    android:clipToPadding="false"
                    android:elevation="6dp"
                    android:nestedScrollingEnabled="false"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_frequent" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Zero-state (no dialed number / no matches) -->
        <LinearLayout
            android:id="@+id/textEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_40sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/dialpadPanel"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <ImageView
                android:layout_width="@dimen/_64sdp"
                android:layout_height="@dimen/_64sdp"
                android:background="@drawable/bg_circle_surface"
                android:contentDescription="@null"
                android:padding="@dimen/_18sdp"
                android:src="@drawable/ic_dialpad"
                app:tint="@color/ds_ink_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="@string/dialer_empty_title"
                android:textColor="@color/ds_ink"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.4"
                android:text="@string/dialer_empty_sub"
                android:textColor="@color/ds_ink_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom dial pad + call -->
        <LinearLayout
            android:id="@+id/dialpadPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_dialer_sheet"
            android:elevation="12dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!--
                Number and backspace on one row. Backspace used to sit beside the
                Call button, a keypad's height away from the digits it deletes;
                here it is next to them, which is also where every stock dialer
                puts it.

                The end padding the field carries is the button's own width, so
                the digits stay optically centred on the sheet rather than
                shunted left by it.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Number display. An EditText (not a TextView) so it shows a blinking
                     cursor, but the on-screen keypad is the only input: the soft keyboard
                     is suppressed (showSoftInputOnFocus=false) and it's not directly
                     editable. Selection is kept at the end from code. -->
                <EditText
                    android:id="@+id/textDialNumber"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:cursorVisible="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:minHeight="48dp"
                    android:paddingStart="@dimen/_44sdp"
                    android:paddingEnd="0dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/ds_ink"
                    android:textColorHint="@color/ds_ink_muted"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    tools:ignore="LabelFor"
                    tools:text="+1 234 567" />

                <ImageView
                    android:id="@+id/buttonBackspace"
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="@dimen/_44sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dialer_backspace"
                    android:padding="@dimen/_11sdp"
                    android:src="@drawable/ic_backspace"
                    android:visibility="invisible"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <GridLayout
                android:id="@+id/gridKeypad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:rowCount="4"
                android:useDefaultMargins="false">

                <LinearLayout style="@style/DialKey" android:tag="1">
                    <TextView style="@style/DialKeyDigit" android:text="1" />
                    <TextView style="@style/DialKeyLetters" android:text="" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="2">
                    <TextView style="@style/DialKeyDigit" android:text="2" />
                    <TextView style="@style/DialKeyLetters" android:text="ABC" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="3">
                    <TextView style="@style/DialKeyDigit" android:text="3" />
                    <TextView style="@style/DialKeyLetters" android:text="DEF" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="4">
                    <TextView style="@style/DialKeyDigit" android:text="4" />
                    <TextView style="@style/DialKeyLetters" android:text="GHI" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="5">
                    <TextView style="@style/DialKeyDigit" android:text="5" />
                    <TextView style="@style/DialKeyLetters" android:text="JKL" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="6">
                    <TextView style="@style/DialKeyDigit" android:text="6" />
                    <TextView style="@style/DialKeyLetters" android:text="MNO" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="7">
                    <TextView style="@style/DialKeyDigit" android:text="7" />
                    <TextView style="@style/DialKeyLetters" android:text="PQRS" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="8">
                    <TextView style="@style/DialKeyDigit" android:text="8" />
                    <TextView style="@style/DialKeyLetters" android:text="TUV" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="9">
                    <TextView style="@style/DialKeyDigit" android:text="9" />
                    <TextView style="@style/DialKeyLetters" android:text="WXYZ" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="*">
                    <TextView style="@style/DialKeyDigit" android:text="*" />
                    <TextView style="@style/DialKeyLetters" android:text="" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="0">
                    <TextView style="@style/DialKeyDigit" android:text="0" />
                    <TextView style="@style/DialKeyLetters" android:text="+" />
                </LinearLayout>

                <LinearLayout style="@style/DialKey" android:tag="#">
                    <TextView style="@style/DialKeyDigit" android:text="#" />
                    <TextView style="@style/DialKeyLetters" android:text="" />
                </LinearLayout>
            </GridLayout>

            <!-- Call, on its own row now that backspace has gone up to the
                 number it edits. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDialCall"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_46sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_10sdp"
                android:minWidth="@dimen/_130sdp"
                android:paddingHorizontal="@dimen/_24sdp"
                android:text="@string/action_call"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/_24sdp"
                app:icon="@drawable/ic_call"
                app:iconGravity="textStart"
                app:iconSize="@dimen/_18sdp"
                app:iconTint="@color/white" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
