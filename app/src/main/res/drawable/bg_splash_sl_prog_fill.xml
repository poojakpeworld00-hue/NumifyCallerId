<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash boot progress · fill. Runs the brand gradient left→right, matching the
    icon tile, so the bar reads as the same object filling up rather than a
    separate flat swatch.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="0"
        android:endColor="@color/splash_sl_brand_2"
        android:startColor="@color/splash_sl_brand"
        android:type="linear" />
    <corners android:radius="@dimen/_99sdp" />
</shape>
