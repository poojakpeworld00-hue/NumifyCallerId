<?xml version="1.0" encoding="utf-8"?>
<!--
    Light meter — CID03 redesign.

    Sunburst, lux readout, a five-band scale showing which lighting condition the
    reading falls in, then the session's lowest/highest and a pause control.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lightRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.LightMeterActivity">

        <LinearLayout
            android:id="@+id/crownBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/padBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/glyph_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:text="@string/tools_light"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/padZero"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_reset"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/glyph_undo"
                app:tint="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblNoSensor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_32sdp"
            android:gravity="center"
            android:text="@string/light_no_sensor"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/crownBar" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/contentVw"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintTop_toBottomOf="@id/crownBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <FrameLayout
                    android:layout_width="@dimen/_180sdp"
                    android:layout_height="@dimen/_180sdp"
                    android:layout_marginTop="@dimen/_4sdp">

                    <com.numify.callerid.lookup.feature.tools.RadiantBurstView
                        android:id="@+id/burstVw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/glyph_tool_light"
                        app:tint="@color/cid_amber" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblLux"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_36ssp"
                        android:textStyle="bold"
                        tools:text="486" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_4sdp"
                        android:includeFontPadding="false"
                        android:text="@string/light_unit"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lblCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/shape_cid_chip_amber"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_5sdp"
                    android:textColor="@color/cid_amber"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold"
                    tools:text="Good for reading" />

                <!-- Five bands; the active one is lit by LightMeterActivity. -->
                <LinearLayout
                    android:id="@+id/bandsVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_18sdp"
                    android:background="@drawable/shape_cid_panel"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_12sdp">

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band1Vw"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band1Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_dark" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band2Vw"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band2Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_dim" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band3Vw"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band3Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_indoor" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band4Vw"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band4Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_bright" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band5Vw"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band5Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_sun" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginEnd="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:rotation="90"
                                android:src="@drawable/glyph_arrow_forward"
                                app:tint="@color/cid_teal" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/light_lowest" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblMin"
                            style="@style/BattStatValue"
                            tools:text="120 lux" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginStart="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:rotation="-90"
                                android:src="@drawable/glyph_arrow_forward"
                                app:tint="@color/cid_amber" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/light_highest" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblMax"
                            style="@style/BattStatValue"
                            tools:text="2340 lux" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/padCapture"
                    style="@style/ToolCta"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/meter_pause"
                    app:icon="@drawable/glyph_pause" />

                <FrameLayout
                    android:id="@+id/adNativeFrameVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmerVw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/gads_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDividerVw"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/part_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
