<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding hero card, "identified" variant: `linear-gradient(155deg,#EAF0FE,#F6F8FC)`
     with a 1px #E1E9FB hairline and a 22dp radius.

     The angle is 315 (CSS 135deg) rather than the authored 155: a shape drawable
     only accepts 45-degree steps. The two stops are both near-white blue-greys a
     couple of percent apart, so the 20-degree difference is not resolvable — this
     is the one place in the handoff where rounding the angle costs nothing, unlike
     the splash gradient, which needed a custom view. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/ds_page"
        android:startColor="@color/ds_hero_blue_wash"
        android:type="linear" />
    <stroke
        android:width="1dp"
        android:color="@color/ds_hero_blue_border" />
    <corners android:radius="22dp" />
</shape>
