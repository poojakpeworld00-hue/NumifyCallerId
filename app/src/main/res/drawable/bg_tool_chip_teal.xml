<?xml version="1.0" encoding="utf-8"?>
<!--
    Tools grid · teal icon chip. A soft tint of the hue, with the glyph drawn in
    the hue itself (tinted by ToolboxAdapter) — the saturated colour is carried by
    the small glyph, not by a whole filled disc, so a grid of ten stays calm.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#290D9488" />
    <corners android:radius="@dimen/_13sdp" />
</shape>
