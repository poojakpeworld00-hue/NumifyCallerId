<?xml version="1.0" encoding="utf-8"?>
<!-- Number details (design: Numify Call Details, applied to the lookup result).

     The sibling of activity_call_detail and deliberately the same screen: same
     back chip, same dark hero, same grouped action strip. They answer the same
     question about the same kind of thing — one from the call log, one from a
     search — and arriving at two different-looking screens made them feel like
     two different features.

     What differs is what fills the hero's three stats. Call details counts calls;
     here the facts about the line itself are the subject, so country, carrier and
     line type take those slots, and city joins spam type in the card below.

     Dark mode: every colour is a ds_ token with a values-night counterpart. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lookupDetailRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.finder.ReportNumberActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ds_back_chip"
                android:contentDescription="@string/onboarding_skip"
                android:padding="10dp"
                android:src="@drawable/ic_ds_chevron_left"
                app:tint="@color/ds_ink_strong" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/lookup_detail_title"
                android:textColor="@color/ds_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="14dp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDivider"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ===== Identity hero ===== -->
                <LinearLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_detail_hero"
                    android:clipToOutline="true"
                    android:elevation="10dp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/ds_hero_shadow"
                    android:outlineSpotShadowColor="@color/ds_hero_shadow"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_ds_hero_avatar">

                            <TextView
                                android:id="@+id/textAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/space_grotesk_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/ds_on_hero"
                                android:textSize="24sp"
                                tools:text="PC" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/space_grotesk_bold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/ds_on_hero"
                                android:textSize="22sp"
                                tools:text="Pooja Chudhri" />

                            <TextView
                                android:id="@+id/textNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/mulish_semibold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/ds_on_hero_muted"
                                android:textSize="12.5sp"
                                tools:text="+91 704 602 4874" />

                            <!-- Verdict pill: valid / invalid / spam / in contacts.
                                 Tinted by ReportNumberActivity.bindStatus(). -->
                            <TextView
                                android:id="@+id/textStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:background="@drawable/bg_ds_hero_pill"
                                android:drawablePadding="5dp"
                                android:fontFamily="@font/mulish_bold"
                                android:gravity="center_vertical"
                                android:includeFontPadding="false"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:textColor="@color/ds_on_hero_muted"
                                android:textSize="11.5sp"
                                tools:text="Valid number" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- The line's own facts, where call details puts its counts. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/DetailHeroStat">

                            <TextView
                                android:id="@+id/textCountry"
                                style="@style/DetailHeroStatValue"
                                android:textSize="14sp"
                                tools:text="India" />

                            <TextView
                                style="@style/DetailHeroStatCaption"
                                android:text="@string/lookup_country" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DetailHeroStat"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:id="@+id/textCarrier"
                                style="@style/DetailHeroStatValue"
                                android:textSize="14sp"
                                tools:text="Idea" />

                            <TextView
                                style="@style/DetailHeroStatCaption"
                                android:text="@string/lookup_carrier" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DetailHeroStat"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:id="@+id/textLineType"
                                style="@style/DetailHeroStatValue"
                                android:textSize="14sp"
                                tools:text="Mobile" />

                            <TextView
                                style="@style/DetailHeroStatCaption"
                                android:text="@string/lookup_line_type" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Actions: one grouped strip ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ds_card"
                    android:baselineAligned="false"
                    android:elevation="4dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:id="@+id/buttonCall"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_accent"
                            android:contentDescription="@string/action_call"
                            android:src="@drawable/ic_ds_phone"
                            app:tint="@color/ds_on_accent" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_call" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonMessage"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_hero_blue_wash"
                            android:contentDescription="@string/action_message"
                            android:src="@drawable/ic_message_square_alt"
                            app:tint="@color/ds_accent" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_message" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonShare"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_hero_blue_wash"
                            android:contentDescription="@string/settings_share"
                            android:src="@drawable/ic_share"
                            app:tint="@color/ds_accent" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/settings_share" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonBlock"
                        style="@style/DetailAction">

                        <ImageView
                            android:id="@+id/imageBlockIcon"
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_danger_tint"
                            android:contentDescription="@string/action_block"
                            android:src="@drawable/ic_ds_block_slash"
                            app:tint="@color/ds_danger" />

                        <TextView
                            android:id="@+id/textBlockLabel"
                            style="@style/DetailActionLabel"
                            android:text="@string/action_block" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Everything else about the number ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_ds_status_dot"
                        android:backgroundTint="@color/ds_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/mulish_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.11"
                        android:text="@string/lookup_section_about"
                        android:textAllCaps="true"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="11sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/ds_rule" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:paddingHorizontal="16dp">

                    <!-- City -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingVertical="13dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/lookup_city"
                            android:src="@drawable/ic_row_city"
                            app:tint="@color/ds_ink_muted" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_semibold"
                            android:text="@string/lookup_city"
                            android:textColor="@color/ds_ink_muted"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/textCity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:textColor="@color/ds_ink"
                            android:textSize="12.5sp"
                            tools:text="Mumbai" />
                    </LinearLayout>

                    <!-- Spam type (only when flagged) -->
                    <View
                        android:id="@+id/spamDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ds_divider"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/spamRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingVertical="13dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/lookup_spam_type"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/ds_danger" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_semibold"
                            android:text="@string/lookup_spam_type"
                            android:textColor="@color/ds_ink_muted"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/textSpamType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:textColor="@color/ds_danger"
                            android:textSize="12.5sp"
                            tools:text="Telemarketer" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Also known as — per-name reveal (one rewarded ad per name) ===== -->
                <LinearLayout
                    android:id="@+id/nicknamesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ds_card"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:padding="16dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:text="@string/lookup_also_known_as"
                            android:textColor="@color/ds_ink"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/textNickCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:textColor="@color/ds_ink_muted"
                            android:textSize="11sp"
                            tools:text="1 of 4 revealed" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/columnNicknames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/textNickFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/mulish_semibold"
                        android:gravity="center"
                        android:text="@string/lookup_nick_footer"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
