<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding hero 1 — the incoming call, identified.

     A gradient card holding the caller's initials tile, the "INCOMING CALL"
     eyebrow over the resolved name and its verified line, and the answer/decline
     pair stacked on the trailing edge. Every id below is animated in by
     IntroAnimations; the ids are what pair a view with its authored delay. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_hero_blue"
    android:padding="16dp">

    <TextView
        android:id="@+id/heroAvatar"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_ds_caller_tile"
        android:elevation="8dp"
        android:fontFamily="@font/space_grotesk_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:outlineAmbientShadowColor="@color/ds_accent_shadow"
        android:outlineSpotShadowColor="@color/ds_accent_shadow"
        android:text="@string/onboarding_hero_caller_initials"
        android:textColor="@color/ds_on_accent"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Eyebrow, name and verified line move as one block, so they sit in a
         packed chain rather than each being pinned to the avatar. -->
    <TextView
        android:id="@+id/heroEyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/mulish_bold"
        android:letterSpacing="0.0952"
        android:text="@string/onboarding_hero_incoming"
        android:textColor="@color/ds_accent"
        android:textSize="10.5sp"
        app:layout_constraintBottom_toTopOf="@id/heroName"
        app:layout_constraintEnd_toStartOf="@id/heroActions"
        app:layout_constraintStart_toEndOf="@id/heroAvatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/heroName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/space_grotesk_bold"
        android:maxLines="1"
        android:text="@string/onboarding_hero_caller_name"
        android:textColor="@color/ds_ink"
        android:textSize="16.5sp"
        app:layout_constraintBottom_toTopOf="@id/heroVerifiedRow"
        app:layout_constraintEnd_toStartOf="@id/heroActions"
        app:layout_constraintStart_toEndOf="@id/heroAvatar"
        app:layout_constraintTop_toBottomOf="@id/heroEyebrow" />

    <LinearLayout
        android:id="@+id/heroVerifiedRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/heroActions"
        app:layout_constraintStart_toEndOf="@id/heroAvatar"
        app:layout_constraintTop_toBottomOf="@id/heroName">

        <ImageView
            android:layout_width="11dp"
            android:layout_height="11dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_shield_check" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="@font/mulish_bold"
            android:text="@string/onboarding_hero_verified"
            android:textColor="@color/ds_accent_on_tint"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/heroActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/heroAccept"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_ds_accept_disc"
            android:contentDescription="@null"
            android:padding="11dp"
            android:src="@drawable/ic_ds_phone" />

        <!-- Same handset, turned 135 degrees: that is how the design draws
             "decline" rather than shipping a second glyph. -->
        <ImageView
            android:id="@+id/heroDecline"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ds_decline_disc"
            android:contentDescription="@null"
            android:padding="11dp"
            android:rotation="135"
            android:src="@drawable/ic_ds_phone"
            app:tint="@color/ds_danger" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
