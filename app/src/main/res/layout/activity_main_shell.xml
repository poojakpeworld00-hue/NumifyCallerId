<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.MainShellActivity">

        <com.numify.callerid.lookup.feature.widgets.SwipeNavigationLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/overlayBanner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Overlay-permission prompt: sits above the nav once call-log & contacts
             are granted but the overlay permission isn't.

             Anchored to footerBar, NOT to fabLookup. The FAB used to straddle the
             bar's top edge, so pinning to it kept clear of the nav; now that it is
             centred INSIDE the pill, its top sits a dozen dp within the nav — and
             because fragmentContainer chains its own bottom through this banner,
             anchoring here dragged every tab's content underneath the nav bar.

             This view is the bottom of the content area whether it is visible or
             gone (a gone widget collapses to a point at its resolved position), so
             it has to line up with the top of the nav, not with something inside it. -->
        <LinearLayout
            android:id="@+id/overlayBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/primary_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/footerBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/overlay_banner_desc"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/buttonEnableOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="@string/perm_allow"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom navigation: full-bleed, flush on the banner ad beneath it.
             A floating pill was tried first and lost on this screen — its shadow,
             its side margins and its bottom gap all landed on top of an ad rather
             than on the page, so the foot of every tab read as three stacked
             objects, and it cost about 26dp of content to do it.
             Flush and hairlined, the nav and the ad read as one bottom edge. -->
        <LinearLayout
            android:id="@+id/footerBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ds_nav_bar_flat"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingTop="9dp"
            android:paddingBottom="11dp"
            app:layout_constraintBottom_toTopOf="@+id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/navRecents"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navContacts"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Reserves the slot the raised Lookup action sits over. -->
            <Space
                android:id="@+id/navFabSlot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navBlocklist"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navTools"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Lookup, the centre action. It sits INSIDE the bar rather than straddling
             its top edge: an overhang eats into the last list row, which on a call
             log is exactly the row you are most likely to want to tap.

             Still a sibling of footerBar rather than a child, so its elevation puts
             it above the bar and it keeps its own shadow. -->
        <FrameLayout
            android:id="@+id/fabLookup"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_ds_nav_fab"
            android:clickable="true"
            android:contentDescription="@string/nav_lookup"
            android:elevation="8dp"
            android:focusable="true"
            android:outlineAmbientShadowColor="@color/ds_fab_shadow"
            android:outlineSpotShadowColor="@color/ds_fab_shadow"
            app:layout_constraintBottom_toBottomOf="@id/footerBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/footerBar">

            <ImageView
                android:id="@+id/fabLookupIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_nav_lookup" />
        </FrameLayout>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
