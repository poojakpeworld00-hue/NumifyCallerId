<?xml version="1.0" encoding="utf-8"?>
<!--
    Sound meter — CID03 redesign.

    Half-dial, dB readout with a plain-language category, a rolling waveform of
    the last half-minute, then min/avg/max and a pause control.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/soundRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.NoiseMeterActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                style="@style/ToolHeaderBack"
                android:contentDescription="@string/onboarding_skip"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/ToolHeaderTitle"
                android:text="@string/tools_sound" />

            <ImageView
                android:id="@+id/buttonReset"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_reset"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_undo"
                app:tint="@color/primary" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <com.numify.callerid.lookup.feature.tools.NoiseGaugeView
                    android:id="@+id/gauge"
                    android:layout_width="@dimen/_200sdp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textDb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/ds_ink"
                        android:textSize="52sp"
                        tools:text="55" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/mulish_bold"
                        android:includeFontPadding="false"
                        android:text="@string/sound_unit"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ds_chip_accent"
                    android:fontFamily="@font/mulish_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/ds_accent"
                    android:textSize="13sp"
                    tools:text="Normal conversation" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:gravity="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp"
                    tools:text="" />

                <!-- Rolling window of recent levels. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:background="@drawable/bg_cid_panel"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_12sdp">

                    <com.numify.callerid.lookup.feature.tools.AudioWaveView
                        android:id="@+id/spectrum"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_62sdp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_7sdp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sound_window"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_9ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/sound_now"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/SpeedStatCard"
                        android:layout_marginEnd="@dimen/_4sdp">

                        <TextView
                            style="@style/SpeedStatLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/sound_min" />

                        <TextView
                            android:id="@+id/textMin"
                            style="@style/SpeedStatValue"
                            android:textColor="@color/cid_teal"
                            tools:text="41" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/SpeedStatCard"
                        android:layout_marginHorizontal="@dimen/_4sdp">

                        <TextView
                            style="@style/SpeedStatLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/sound_avg" />

                        <TextView
                            android:id="@+id/textAvg"
                            style="@style/SpeedStatValue"
                            tools:text="59" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/SpeedStatCard"
                        android:layout_marginStart="@dimen/_4sdp">

                        <TextView
                            style="@style/SpeedStatLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/sound_max" />

                        <TextView
                            android:id="@+id/textPeak"
                            style="@style/SpeedStatValue"
                            android:textColor="@color/cid_amber"
                            tools:text="88" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonHold"
                    style="@style/ToolCta"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/meter_pause"
                    app:icon="@drawable/ic_pause" />

                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
