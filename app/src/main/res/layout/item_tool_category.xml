<?xml version="1.0" encoding="utf-8"?>
<!-- One tools category: a small-caps label with a rule, over a horizontally
     scrolling rail of tool cards.

     The rail carries the screen's 20dp side padding itself rather than inheriting
     it from the outer list, with clipToPadding off — that way the first card lines
     up with the header above it, and cards still scroll out to the screen edge
     instead of stopping short at a padded boundary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/categorySection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/textToolCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mulish_bold"
            android:letterSpacing="0.0909"
            android:textAllCaps="true"
            android:textColor="@color/ds_ink_muted"
            android:textSize="11sp"
            tools:text="Measure" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@color/ds_rule" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listCategoryTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:paddingHorizontal="20dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_tool" />

</LinearLayout>
