<?xml version="1.0" encoding="utf-8"?>
<!-- Icon tile inside the dark hero: a lightened wash of the card itself, so it
     works whichever way round the ramp is in the current theme. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#24FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="@color/outline" />
    <corners android:radius="@dimen/_17sdp" />
</shape>
