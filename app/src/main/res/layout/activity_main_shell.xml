<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.MainShellActivity">

        <com.numify.callerid.lookup.feature.widgets.SwipeNavigationLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/overlayBanner"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Overlay-permission prompt: sits above the nav once call-log & contacts
             are granted but the overlay permission isn't.

             Anchored to footerBar, NOT to fabLookup. The FAB used to straddle the
             bar's top edge, so pinning to it kept clear of the nav; now that it is
             centred INSIDE the pill, its top sits a dozen dp within the nav — and
             because fragmentContainer chains its own bottom through this banner,
             anchoring here dragged every tab's content underneath the nav bar.

             This view is the bottom of the content area whether it is visible or
             gone (a gone widget collapses to a point at its resolved position), so
             it has to line up with the top of the nav, not with something inside it. -->
        <LinearLayout
            android:id="@+id/overlayBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/primary_container"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/footerBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:visibility="visible">


            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/overlay_banner_desc"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>

            <TextView
                android:id="@+id/buttonEnableOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingVertical="@dimen/_5sdp"
                android:text="@string/perm_allow"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom navigation as the handoff draws it: a white island on a 28dp
             radius, inset 20dp from each edge, lifted off the page by its own
             shadow, with a 14dp gap under it.

             This reverses an earlier call. Full-bleed was chosen because the
             island's shadow and its bottom gap land on the banner ad rather than
             on the page, so the foot of the screen reads as stacked objects —
             that trade has not changed, and it is the reason the gap below is
             14dp rather than the design's full breathing room. The handoff asks
             for the island, so the island is what this is. -->
        <LinearLayout
            android:id="@+id/footerBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_ds_nav_island"
            android:baselineAligned="false"
            android:elevation="10dp"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/ds_fab_shadow"
            android:outlineSpotShadowColor="@color/ds_fab_shadow"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp"
            app:layout_constraintBottom_toTopOf="@+id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/navRecents"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navContacts"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- Reserves the slot the raised Lookup action sits over. -->
            <Space
                android:id="@+id/navFabSlot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navBlocklist"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/navTools"
                layout="@layout/item_nav"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- The ring that pulses out from under the centre action — the handoff's
             `fabPulse`. Declared before the action so it draws behind it, and at
             an elevation between the island and the action so it expands over the
             white rather than under it. outlineProvider="none" because an
             elevated oval would otherwise cast a shadow of its own, and this is
             meant to read as light, not as a second object.

             Driven from MainShellActivity, which also stops it while the screen is
             away: a 2s loop that never ends is fine in a canvas and is not fine
             on a battery. -->
        <View
            android:id="@+id/fabPulse"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_ds_nav_pulse"
            android:elevation="11dp"
            android:outlineProvider="none"
            android:translationY="-14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/footerBar" />

        <!-- Lookup, the centre action. The handoff raises it 14dp through the top
             edge of the island (a 54dp circle at `margin-top:-24px` inside 10px of
             bar padding), which the 4dp page-coloured ring on its drawable turns
             into a punched-through hole rather than a sticker.

             The overhang does eat into the last list row, which was the reason it
             previously sat flush inside the bar. The list pads 70dp at the foot,
             so what it eats is padding.

             Still a sibling of footerBar rather than a child, so its elevation puts
             it above the bar and it keeps its own shadow. -->
        <FrameLayout
            android:id="@+id/fabLookup"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_ds_nav_fab"
            android:clickable="true"
            android:contentDescription="@string/nav_lookup"
            android:elevation="12dp"
            android:focusable="true"
            android:outlineAmbientShadowColor="@color/ds_fab_shadow"
            android:outlineSpotShadowColor="@color/ds_fab_shadow"
            android:translationY="-14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/footerBar">

            <ImageView
                android:id="@+id/fabLookupIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_ds_nav_lookup" />
        </FrameLayout>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
