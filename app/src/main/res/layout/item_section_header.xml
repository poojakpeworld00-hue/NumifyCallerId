<?xml version="1.0" encoding="utf-8"?>
<!-- Date group header in the recents list. Same "dot · label · rule" pattern the
     rest of the redesign uses for section headings, so the list reads as part of
     the same app rather than a plain date caption. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <View
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:background="@drawable/bg_section_dot" />

    <TextView
        android:id="@+id/textHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/mulish_bold"
        android:letterSpacing="0.0909"
        android:textAllCaps="true"
        android:textColor="@color/ds_ink_muted"
        android:textSize="11sp"
        tools:text="Today" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@color/ds_rule" />
</LinearLayout>
