<?xml version="1.0" encoding="utf-8"?>
<!--
    Contacts Premium, built from the handoff's "Numify Premium.dc.html".

    Every dimension, colour, radius and weight below is transcribed from that
    file. The design canvas is 412x892 (see the x-import hint-size), so its CSS
    px map 1:1 onto dp and are used as written.

    Structure, top to bottom, exactly as the design orders it:
      close + Restore  ->  "Free vs Premium" hero  ->  comparison table
      ->  plan rows  ->  fine print                        [scrolling]
      CTA + legal links                                    [pinned footer]

    The entrance groups carry ids so PremiumActivity can stagger them; the
    design does it with CSS animation-delay on .a1 / .a2 / .a3 / .a1b, and with
    per-word delays inside the hero title.

    Table rows and plan rows are inflated at runtime, not laid out statically:
    the design generates the rows from a list, and the plans carry live prices
    from Play. Everything else is declarative.

    ONE SUBSTITUTION. The design sets four labels in Mulish 800 - Restore, the
    three column heads, and BEST VALUE in the plan row. This project ships
    Mulish 400/500/600/700 and no ExtraBold, so those four carry
    textStyle="bold" on top of @font/mulish_bold: the platform then synthesises
    the extra weight over the real Bold, which lands close to 800 at these
    sizes. Drop the textStyle the day a mulish_extrabold.ttf is added.
    Everything else in the design is 600 or 700 and maps to a real file.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/premiumRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/premium_page">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/premiumScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- 18px top, 20px sides — the design's `padding:18px 20px 0`. The
                 bottom padding clears the pinned footer so the last row can
                 scroll out from under it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="150dp">

                <!-- ===== a1 · close + Restore ===== -->
                <LinearLayout
                    android:id="@+id/groupHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/buttonClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_premium_close"
                        android:contentDescription="@string/action_back"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="10dp"
                        android:src="@drawable/ic_premium_close" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/buttonRestore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/mulish_bold"
                        android:textStyle="bold"
                        android:gravity="center_vertical"
                        android:minHeight="36dp"
                        android:paddingHorizontal="6dp"
                        android:text="@string/premium_restore"
                        android:textColor="@color/premium_ink_muted"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>

                <!-- ===== hero =====
                     The card itself has no entrance in the design — only its
                     contents do, word by word. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_premium_hero"
                    android:elevation="9dp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/premium_hero_shadow"
                    android:outlineSpotShadowColor="@color/premium_hero_shadow"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="16dp">

                    <!-- "✦ Free vs Premium ♛" — one row, five pieces, each with
                         its own delay and its own entrance. baseline alignment
                         rather than centre so the two icons sit on the type
                         rather than floating in the line box. -->
                    <LinearLayout
                        android:id="@+id/groupHeroTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iconHeroSpark"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_premium_spark_duo" />

                        <TextView
                            android:id="@+id/textHeroFree"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:fontFamily="@font/space_grotesk_bold"
                            android:includeFontPadding="false"
                            android:text="@string/premium_hero_free"
                            android:textColor="@color/premium_hero_title"
                            android:textSize="@dimen/_20sdp" />

                        <TextView
                            android:id="@+id/textHeroVs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:fontFamily="@font/mulish_semibold"
                            android:includeFontPadding="false"
                            android:text="@string/premium_hero_vs"
                            android:textColor="@color/premium_hero_vs"
                            android:textSize="16sp" />

                        <com.contacts.callerid.number.lookup.feature.premium.ShineTextView
                            android:id="@+id/textHeroPremium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:fontFamily="@font/space_grotesk_bold"
                            android:includeFontPadding="false"
                            android:text="@string/premium_hero_premium"
                            android:textSize="@dimen/_20sdp" />

                        <ImageView
                            android:id="@+id/iconHeroCrown"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="9dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_premium_crown"
                            app:tint="@color/premium_badge" />
                    </LinearLayout>

                    <!-- a1b -->
                    <TextView
                        android:id="@+id/textHeroSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/mulish_semibold"
                        android:text="@string/premium_hero_sub"
                        android:textColor="@color/premium_hero_sub"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>

                <!-- ===== a2 · comparison table ===== -->
                <LinearLayout
                    android:id="@+id/cardCompare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_premium_card"
                    android:clipToOutline="true"
                    android:elevation="5dp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/premium_card_shadow"
                    android:outlineSpotShadowColor="@color/premium_card_shadow">

                    <!-- The head strip runs to the card's edges; the card's own
                         outline clipping rounds its top corners, so it needs no
                         shape of its own. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/premium_table_header_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="11dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.076"
                            android:textStyle="bold"
                            android:text="@string/premium_col_feature"
                            android:textAllCaps="true"
                            android:textColor="@color/premium_ink_muted"
                            android:textSize="@dimen/_9ssp" />

                        <TextView
                            android:layout_width="@dimen/_64sdp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.076"
                            android:textStyle="bold"
                            android:text="@string/premium_col_free"
                            android:textAllCaps="true"
                            android:textColor="@color/premium_table_free"
                            android:textSize="@dimen/_9ssp" />

                        <TextView
                            android:layout_width="@dimen/_62sdp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.076"
                            android:textStyle="bold"
                            android:text="@string/premium_col_premium"
                            android:textAllCaps="true"
                            android:textColor="@color/premium_accent"
                            android:textSize="@dimen/_9ssp" />
                    </LinearLayout>

                    <!-- Rows land here. -->
                    <LinearLayout
                        android:id="@+id/listCompare"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- ===== a3 · plans =====
                     The BEST VALUE badge overhangs the row's top edge by 10dp,
                     so this container must not clip its children and needs that
                     10dp back as padding. -->
                <LinearLayout
                    android:id="@+id/listPlans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingTop="10dp" />

                <TextView
                    android:id="@+id/textPlansStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:textColor="@color/premium_price_muted"
                    android:textSize="@dimen/_10ssp"
                    tools:text="Loading plans…" />

                <!-- ===== a3 · fine print ===== -->
                <TextView
                    android:id="@+id/textFinePrint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.6"
                    android:text="@string/premium_fine_print_plain"
                    android:textColor="@color/premium_price_muted"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Pinned footer ===== -->
        <LinearLayout
            android:id="@+id/premiumFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_premium_footer_scrim"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:id="@+id/buttonSubscribe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_premium_cta"
                android:clickable="true"
                android:elevation="12dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:outlineAmbientShadowColor="@color/premium_cta_glow"
                android:outlineSpotShadowColor="@color/premium_cta_glow"
                android:padding="17dp">

                <ImageView
                    android:id="@+id/iconCta"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_premium_sparkle" />

                <TextView
                    android:id="@+id/textCta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:fontFamily="@font/mulish_bold"
                    android:includeFontPadding="false"
                    android:text="@string/premium_cta"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14ssp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/mulish_bold"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/premium_terms_link"
                    android:textColor="@color/premium_ink_muted"
                    android:textSize="@dimen/_10ssp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="16dp"
                    android:background="@color/premium_radio_idle" />

                <TextView
                    android:id="@+id/buttonPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/mulish_bold"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="6dp"
                    android:text="@string/premium_privacy_link"
                    android:textColor="@color/premium_ink_muted"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Replaces the offer once Premium is held. The design has no owned
             state, so this one is the app's own and is deliberately plain. -->
        <LinearLayout
            android:id="@+id/stateOwned"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/premium_page"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            tools:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_premium_crown"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/premium_crown_shadow"
                android:outlineSpotShadowColor="@color/premium_crown_shadow">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_premium_crown" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="@string/premium_owned_title"
                android:textColor="@color/premium_ink"
                android:textSize="@dimen/_19ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/premium_owned_sub"
                android:textColor="@color/premium_ink_muted"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/buttonManage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:text="@string/premium_manage"
                android:textColor="@color/premium_accent"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
