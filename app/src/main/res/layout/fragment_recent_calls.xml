<?xml version="1.0" encoding="utf-8"?><!--
    The call list under the actions on the post-call screen.

    Framed like the call history on the call detail screen - dot, label, rule,
    then one grouped card - so the two screens read as the same screen about the
    same number rather than two different takes on a list of calls.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/rowHistoryHead"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_ds_status_dot"
            android:backgroundTint="@color/ds_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/mulish_bold"
            android:includeFontPadding="false"
            android:letterSpacing="0.01"
            android:text="@string/detail_call_history"
            android:textColor="@color/ds_ink_muted"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:background="@color/ds_rule" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/listRecents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_ds_card"
        android:clipToOutline="true"
        android:clipToPadding="false"
        android:elevation="4dp"
        android:outlineAmbientShadowColor="@color/ds_card_shadow"
        android:outlineSpotShadowColor="@color/ds_card_shadow"
        android:overScrollMode="never"
        android:paddingVertical="@dimen/_4sdp" />

    <!--
        The empty state takes the whole remaining height rather than sharing it
        with the list: both used to carry weight 1, so an empty list still held
        half the space and the message sat in the lower half of a gap.
    -->
    <com.callerid.numberlookup.home.feature.widgets.EmptyStateView
        android:id="@+id/textEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

</LinearLayout>
