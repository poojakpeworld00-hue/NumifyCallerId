<?xml version="1.0" encoding="utf-8"?>
<!-- The selected bottom-nav cell's marker: a short rounded bar over the glyph.

     The design's rounded wash behind the icon and label was removed — on a flat
     bar it was the only chrome left and read as a leftover — but colour and a
     bolder label alone were not carrying the state at 22dp/12sp. This says the
     same thing with a shape instead of a fill. Tinted per tab from the shell,
     which is why the solid here is a placeholder. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_accent" />
    <corners android:radius="2dp" />
</shape>
