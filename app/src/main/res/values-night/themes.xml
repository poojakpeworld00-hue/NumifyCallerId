<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CallerIDPhoneLookup" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- App-wide body face — the same UI weight ramp as the light theme, so
             dark mode does not quietly fall back to thin Mulish Regular. -->
<!--        <item name="android:fontFamily">@font/mulish_ui</item>-->
<!--        <item name="fontFamily">@font/mulish_ui</item>-->

        <item name="colorPrimary">@color/primary</item>
        <!-- Paired with colorPrimary. Without it Material3 falls back to its own

             baseline, which in dark mode is a purple: the Call button drew that

             against a blue ground and the label was all but unreadable. -->

        <item name="colorOnPrimary">@color/on_primary</item>

        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorSurface">@color/background</item>

        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <!-- Transparent, because the bar is hidden (BaseActivity.applyImmersiveNavigation)
             and only ever returns as a transient overlay on a swipe. A solid
             colour would paint a band over the content underneath it for the
             seconds it is up. enforceNavigationBarContrast turns off the scrim
             the platform would otherwise add behind a transparent bar on API 29+. -->
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>