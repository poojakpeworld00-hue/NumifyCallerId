<?xml version="1.0" encoding="utf-8"?>
<!-- Chip label: white on the filled selected chip, near-ink on the rest. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/ds_on_accent" android:state_activated="true" />
    <item android:color="@color/ds_on_accent" android:state_selected="true" />
    <item android:color="@color/ds_chip_ink" />
</selector>
