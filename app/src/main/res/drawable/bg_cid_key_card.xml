<?xml version="1.0" encoding="utf-8"?>
<!-- One keypad key. The design gives each digit its own card so the pad reads as
     a grid of targets rather than numbers floating on the sheet. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/surface" />
    <stroke
        android:width="1dp"
        android:color="@color/outline" />
    <corners android:radius="@dimen/_18sdp" />
</shape>
