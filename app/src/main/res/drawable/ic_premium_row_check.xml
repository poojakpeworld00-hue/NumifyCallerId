<?xml version="1.0" encoding="utf-8"?>
<!-- The trailing tick on each benefit row. The design draws it as a single 15px
     svg: an #E3F5EC disc (r=10 in a 24 viewport) with a #1E9E5A tick at stroke
     width 2.2 over it, so both live in one vector here rather than a background
     plus an icon. -->
<!-- Arc flags are written out in full ("0 1 0 0 18", not "100 18"): Android
     PathParser rejects the packed form the design's SVG uses, at runtime only. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="15dp"
    android:height="15dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:pathData="M12 2a10 10 0 1 0 0 20a10 10 0 0 0 0 -20z"
        android:fillColor="@color/premium_check_circle" />

    <path
        android:pathData="M8 12.5l2.6 2.6L16 9.5"
        android:strokeColor="@color/premium_check_tick"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
