<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <!-- No "Contacts" heading: the bottom nav chip already names the tab, and
             the count is the only part that was telling the user something they
             could not see, so it stays — as the whole of the left-hand side. -->
        <TextView
            android:id="@+id/textContactsCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/mulish_bold"
            android:includeFontPadding="false"
            android:textColor="@color/ds_ink_muted"
            android:textSize="13sp"
            tools:text="3 contacts" />

        <!-- Search is a destination, not a field on this page: tapping it opens
             ContactSearchActivity, which owns the keyboard, the voice button and
             the results. The same move Google Contacts and Samsung Contacts make,
             and the reason the in-page search field is gone. -->
        <ImageView
            android:id="@+id/buttonContactsSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_ds_search_square"
            android:contentDescription="@string/contacts_search_hint"
            android:padding="12dp"
            android:src="@drawable/ic_ds_search"
            app:tint="@color/ds_ink" />

        <ImageView
            android:id="@+id/buttonContactsAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ds_action_tile"
            android:contentDescription="@string/action_add"
            android:elevation="8dp"
            android:outlineAmbientShadowColor="@color/ds_accent_shadow"
            android:outlineSpotShadowColor="@color/ds_accent_shadow"
            android:padding="13dp"
            android:src="@drawable/ic_person_add"
            app:tint="@color/ds_on_accent" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_page"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll">


        <!-- Directory card: the search field and the filter rail are one object in
             the design, not two floating controls, so they share a card. -->
        <LinearLayout
            android:id="@+id/directoryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/bg_ds_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:padding="12dp">

        <!-- Filter chips. The search field that used to sit above them is gone —
             it is ContactSearchActivity now, reached from the header. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/ic_group"
                    android:text="@string/contacts_tab_all" />

                <TextView
                    android:id="@+id/tabFavorites"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/ic_rate_contact"
                    android:text="@string/contacts_tab_favorites" />

                <TextView
                    android:id="@+id/tabRecents"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/ic_history"
                    android:text="@string/contacts_tab_recents" />

                <TextView
                    android:id="@+id/tabGroups"
                    style="@style/RecentFilterTab"
                    android:layout_marginEnd="0dp"
                    android:drawableStart="@drawable/ic_group"
                    android:text="@string/contacts_tab_groups" />
            </LinearLayout>
        </HorizontalScrollView>
        </LinearLayout>

        <!--
            Favourites, as a section the user can collapse — the disclosure Google
            Contacts puts on the same group.

            The rail is a shortcut, and a shortcut nobody uses is just a band of
            screen taken from the directory underneath it. Tapping the header
            folds it away and the choice is remembered, so someone who does not
            use favourites stops paying for them on every launch.

            The whole header is the control, not the caret alone: a 12dp chevron
            is a poor target, and the row is already the width of the screen.
            ContactListFragment still hides the section outright when nobody is
            starred, so the header never sits over an empty rail.
        -->
        <LinearLayout
            android:id="@+id/favSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mulish_bold"
                android:letterSpacing="0.0909"
                android:text="@string/contacts_tab_favorites"
                android:textAllCaps="true"
                android:textColor="@color/ds_ink_muted"
                android:textSize="11sp" />

            <ImageView
                android:id="@+id/iconFavExpand"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/contacts_favorites_toggle"
                android:src="@drawable/ic_ds_chevron_down"
                app:tint="@color/ds_ink_muted" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_14sdp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_contact_favorite" />

        <!-- Full-bleed hairline separating the filters from the ad below -->
        <View
            android:id="@+id/adNativeDivider"
            android:layout_marginTop="@dimen/_10sdp"
            style="@style/AdDivider" />

        <!-- Native ad -->
        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
           >

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/admob_native_banner" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
        <!-- Full-bleed hairline separating the filters from the ad below -->
        <View
            android:id="@+id/adNativeDivider1"
            style="@style/AdDivider" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- One grouped card rather than loose rows, which is how the design frames
             the directory. The end margin clears the alphabet index so the card
             stops before it instead of running underneath it. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_ds_card"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_contact" />

        <!-- Alphabet fast-scroll index -->
        <LinearLayout
            android:id="@+id/alphaIndex"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/_4sdp" />

        <TextView
            android:id="@+id/letterBubble"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_letter_bubble"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="A"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/contacts_empty"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone" />

        <!--
            Permission state. A NestedScrollView for the same reason as the one
            in fragment_recents: while this is up [listContacts] is GONE, so
            without a nested-scrolling child here the AppBarLayout header above
            cannot scroll off, and on a shorter phone its lower half is left
            unreachable and untappable.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/permState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/_70sdp"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_32sdp">

            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/bg_icon_box"
                android:contentDescription="@string/perm_contacts_title"
                android:padding="@dimen/_16sdp"
                android:src="@drawable/ic_group"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="@string/perm_contacts_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:text="@string/perm_contacts_message"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_11ssp" />

            <TextView
                android:id="@+id/buttonGrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_24sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:text="@string/action_grant"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
