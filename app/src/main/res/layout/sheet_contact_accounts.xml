<?xml version="1.0" encoding="utf-8"?>
<!-- Account picker for the Contacts tab.

     A grabber, then one row per store of contacts with its count, the selected
     one ticked. Rows are inflated into containerAccounts at runtime because the
     list is whatever accounts this phone happens to have — one on a fresh device,
     half a dozen on a well-used one.

     Scrollable: a phone with several Google sign-ins plus a SIM can produce more
     rows than half a screen holds, and a sheet that clips its last account is a
     sheet that cannot select it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_ds_grabber" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerAccounts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
