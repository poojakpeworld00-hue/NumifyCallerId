<?xml version="1.0" encoding="utf-8"?>
<!-- 22dp radio: a 2dp #D6DAE5 ring when idle, a solid brand disc when chosen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/premium_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="@color/premium_radio_idle" />
        </shape>
    </item>
</selector>
