<?xml version="1.0" encoding="utf-8"?>
<!--
    Block a number — dialog.

    The form itself lives in part_block_add_form so the blocklist's empty state
    can present exactly the same thing inline; this file only adds the card and
    the Cancel / Block pair.

    There is deliberately no "also block messages" switch: the app blocks calls
    through the CallScreening role and has no SMS capability at all, so such a
    toggle could not do anything.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_card"
    android:orientation="vertical"
    android:padding="@dimen/_16sdp">

    <include
        android:id="@+id/formVw"
        layout="@layout/part_block_add_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/padCancel"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:background="@drawable/shape_btn_outline"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/action_cancel"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/padAdd"
            android:layout_width="0dp"
            android:layout_height="@dimen/_44sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_weight="1.4"
            android:background="@drawable/shape_btn_danger"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:text="@string/action_block"
            android:textColor="@color/white"
            android:textSize="@dimen/_12ssp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
