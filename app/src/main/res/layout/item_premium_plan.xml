<?xml version="1.0" encoding="utf-8"?>
<!-- One purchasable plan. Selected state is driven by isActivated, the same way
     every other selectable row in this app works (see item_language.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rowPlan"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_ds_plan_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/iconPlanTick"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_ds_checkbox"
        android:contentDescription="@null"
        android:padding="4dp"
        android:src="@drawable/ic_check"
        app:tint="@color/selector_ds_check" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textPlanTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/mulish_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ds_ink"
            android:textSize="14.5sp"
            tools:text="Yearly" />

        <TextView
            android:id="@+id/textPlanSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/mulish_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ds_ink_muted"
            android:textSize="11.5sp"
            tools:text="Billed every 12 months" />
    </LinearLayout>

    <TextView
        android:id="@+id/textPlanPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/mulish_bold"
        android:textColor="@color/ds_ink"
        android:textSize="15sp"
        tools:text="₹1,499" />
</LinearLayout>
