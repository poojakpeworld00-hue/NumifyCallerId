<?xml version="1.0" encoding="utf-8"?>
<!--
    One switched Ask AI surface: title, a line explaining what it actually does,
    and the switch. The subtitle is not optional here — "Caller verdict" means
    nothing on its own, and a switch whose effect is unclear gets left alone.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:id="@+id/rowAiSettingRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/_13sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textAiSettingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_11ssp"
                tools:text="Ask AI on Home" />

            <TextView
                android:id="@+id/textAiSettingSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_10sdp"
                android:includeFontPadding="false"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_9ssp"
                tools:text="The button beside the search field" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchAiSetting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:duplicateParentState="true"
            android:focusable="false" />
    </LinearLayout>
</layout>
