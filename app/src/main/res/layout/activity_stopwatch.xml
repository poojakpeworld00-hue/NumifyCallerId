<?xml version="1.0" encoding="utf-8"?>
<!--
    Stopwatch — CID03 redesign.

    Header (back · title · Stopwatch/Timer segmented) over an analog face with the
    readout inside it, three round transport controls, then the lap list.

    The dial is StopwatchDialView: the design lays its sixty ticks out as sixty
    absolutely-positioned spans, which cannot re-proportion for a smaller dial.
    Ad slots are unchanged from the previous layout.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stopwatchRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.StopwatchActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                style="@style/ToolHeaderBack"
                android:contentDescription="@string/onboarding_skip"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/ToolHeaderTitle"
                android:text="@string/tools_stopwatch" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cid_seg_track"
                android:orientation="horizontal"
                android:padding="@dimen/_3sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cid_seg_active"
                    android:fontFamily="@font/mulish_bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/tools_stopwatch"
                    android:textColor="@color/ds_on_accent"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/buttonSegTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:fontFamily="@font/mulish_bold"
                    android:gravity="center"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:text="@string/timer_tool"
                    android:textColor="@color/ds_ink_muted"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <!-- ===== Face ===== -->
                <FrameLayout
                    android:layout_width="@dimen/_210sdp"
                    android:layout_height="@dimen/_210sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:elevation="@dimen/_3sdp"
                    android:outlineAmbientShadowColor="@color/card_shadow"
                    android:outlineSpotShadowColor="@color/card_shadow">

                    <com.contacts.callerid.number.lookup.feature.tools.StopwatchDialView
                        android:id="@+id/face"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Readout sits above centre so the hand's lower sweep is
                         never hidden behind the digits. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_62sdp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/ds_ink"
                                android:textSize="46sp"
                                tools:text="00:00" />

                            <!-- The hundredths stay blue at half the size: they are
                                 the part that never stops moving, and at the same
                                 weight as the seconds they pull the eye off the
                                 figure that actually matters. -->
                            <TextView
                                android:id="@+id/textFraction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk_bold"
                                android:includeFontPadding="false"
                                android:textColor="@color/ds_accent"
                                android:textSize="22sp"
                                tools:text=".00" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_ds_chip_accent"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="6dp"
                            android:textColor="@color/ds_accent"
                            android:textSize="12.5sp"
                            tools:text="Ready" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ===== Transport ===== -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/buttonReset"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:background="@drawable/bg_cid_circle_outline"
                        android:contentDescription="@string/action_reset"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_13sdp"
                        android:src="@drawable/ic_undo"
                        app:tint="@color/on_surface" />

                    <ImageView
                        android:id="@+id/buttonStartPause"
                        android:layout_width="@dimen/_66sdp"
                        android:layout_height="@dimen/_66sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:background="@drawable/bg_cid_circle_dark"
                        android:contentDescription="@string/action_start"
                        android:elevation="@dimen/_6sdp"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:outlineAmbientShadowColor="@color/card_shadow"
                        android:outlineSpotShadowColor="@color/card_shadow"
                        android:padding="@dimen/_18sdp"
                        android:src="@drawable/ic_play"
                        app:tint="@color/on_primary" />

                    <ImageView
                        android:id="@+id/buttonLap"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:background="@drawable/bg_cid_circle_outline"
                        android:contentDescription="@string/stopwatch_lap"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_13sdp"
                        android:src="@drawable/ic_flag"
                        app:tint="@color/on_surface" />
                </LinearLayout>

                <!-- ===== Laps ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/bg_section_dot" />

                    <TextView
                        android:id="@+id/textLapCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        tools:text="Laps" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:gravity="center"
                    android:text="@string/stopwatch_empty"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_11ssp" />

                <LinearLayout
                    android:id="@+id/columnLaps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
