<?xml version="1.0" encoding="utf-8"?>
<!-- Host for the number-search screen.

     Lookup used to be a nav-less tab inside MainShellActivity, reached from the
     raised centre action. That action is gone and its only entry point now is a
     tile in Tools, next to tools that are all Activities — so it is one too, and
     it gets a real back stack instead of a tab the bar never showed.

     The screen itself is still NumberFinderFragment: it carries the search
     field, the country picker, the result card and its own ad slot, and it pads
     its own status-bar inset, so all this has to supply is a container and the
     bottom banner every other Activity gets. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lookupRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page">

        <FrameLayout
            android:id="@+id/lookupContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDivider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
