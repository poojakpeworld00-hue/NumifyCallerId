<?xml version="1.0" encoding="utf-8"?>
<!-- App-icon tile in the hint strip. Takes the brand ramp from tokens rather than
     literals, so it follows the palette instead of stranding an old blue here. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/primary"
        android:endColor="@color/primary_dark" />
    <corners android:radius="@dimen/_15sdp" />
</shape>
