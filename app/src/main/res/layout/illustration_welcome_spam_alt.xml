<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding hero 3 — a number looked up.

     A mock search field over the resolved result: initials inside a progress ring
     that draws itself, then the owner's name and region. The ring is a custom view
     (LookupRingView) because the design animates its stroke-dashoffset, which no
     stock progress widget reproduces. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_hero_blue"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/heroSearchField"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ds_search_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="11dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_ds_search" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/mulish_semibold"
            android:text="@string/onboarding_hero_query"
            android:textColor="@color/ds_placeholder"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/heroResultBox"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginTop="14dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/heroSearchField">

        <com.numify.callerid.lookup.feature.intro.LookupRingView
            android:id="@+id/heroRing"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/heroAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_ds_avatar_disc"
            android:fontFamily="@font/space_grotesk_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/onboarding_hero_lookup_initials"
            android:textColor="@color/ds_on_accent"
            android:textSize="13sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/heroName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:ellipsize="end"
        android:fontFamily="@font/space_grotesk_bold"
        android:maxLines="1"
        android:text="@string/onboarding_hero_lookup_name"
        android:textColor="@color/ds_ink"
        android:textSize="16.5sp"
        app:layout_constraintBottom_toTopOf="@id/heroRegion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/heroResultBox"
        app:layout_constraintTop_toTopOf="@id/heroResultBox"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/heroRegion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/mulish_semibold"
        android:maxLines="1"
        android:text="@string/onboarding_hero_lookup_region"
        android:textColor="@color/ds_ink_muted"
        android:textSize="12.5sp"
        app:layout_constraintBottom_toBottomOf="@id/heroResultBox"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/heroResultBox"
        app:layout_constraintTop_toBottomOf="@id/heroName" />

</androidx.constraintlayout.widget.ConstraintLayout>
