<?xml version="1.0" encoding="utf-8"?>
<!--
    An answer, plus whatever it earned: action buttons and follow-up chips.

    The text alone is not the product. An answer that says a number is spam and
    then makes the user go and find the blocklist has spent the insight and
    collected nothing, so the actions sit directly under the words. The follow-up
    chips exist for the same reason in the other direction: a transcript that
    ends at one answer ends the session.

    Both rows collapse when empty, so a plain informational answer stays a plain
    bubble rather than a bubble with an empty tray under it.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textAiAnswer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ai_bubble_bot"
            android:lineSpacingExtra="@dimen/_2sdp"
            android:maxWidth="@dimen/_245sdp"
            android:paddingHorizontal="@dimen/_13sdp"
            android:paddingVertical="@dimen/_10sdp"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_10ssp"
            tools:text="Probably. It rang 4 times and not one of those calls was answered." />

        <!-- Actions. Populated in code so the set matches the answer. -->
        <LinearLayout
            android:id="@+id/rowAiActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/buttonAiActionOne"
                style="@style/AiActionButton"
                tools:text="Block" />

            <TextView
                android:id="@+id/buttonAiActionTwo"
                style="@style/AiActionButton"
                android:layout_marginStart="@dimen/_6sdp"
                tools:text="Report" />

            <TextView
                android:id="@+id/buttonAiActionThree"
                style="@style/AiActionButton"
                android:layout_marginStart="@dimen/_6sdp"
                tools:text="Details" />
        </LinearLayout>

        <!-- Follow-ups. Two at most: more reads as a menu, not a nudge. -->
        <LinearLayout
            android:id="@+id/rowAiFollowUps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_7sdp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/buttonAiFollowOne"
                style="@style/AiFollowUpChip"
                tools:text="Who called me most this week?" />

            <TextView
                android:id="@+id/buttonAiFollowTwo"
                style="@style/AiFollowUpChip"
                android:layout_marginTop="@dimen/_5sdp"
                tools:text="How many numbers have I blocked?" />
        </LinearLayout>
    </LinearLayout>
</layout>
