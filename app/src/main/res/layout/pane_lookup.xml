<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Compact header (pads the status-bar inset from LookupFragment) -->
    <LinearLayout
        android:id="@+id/heroHeaderVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/_16sdp"
        android:paddingTop="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:text="@string/nav_lookup"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_20ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:includeFontPadding="false"
                android:text="@string/lookup_header_sub"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_10ssp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/padLookupHistory"
            android:layout_width="@dimen/_36sdp"
            android:layout_height="@dimen/_36sdp"
            android:background="@drawable/shape_cid_pill_neutral"
            android:contentDescription="@string/recent_lookups"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/glyph_history"
            app:tint="@color/on_surface" />
    </LinearLayout>

    <!-- Single search pill: +country · number · clear · search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/shape_home_search"
        android:elevation="@dimen/_2sdp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:outlineAmbientShadowColor="@color/card_shadow"
        android:outlineSpotShadowColor="@color/card_shadow"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_6sdp"
        android:paddingVertical="@dimen/_6sdp">

        <LinearLayout
            android:id="@+id/rowCountryPickerSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/_6sdp">

            <!-- Flag and dial code both sit in a fixed-height box and centre inside
                 it. An emoji flag's font metrics are nothing like the Latin text
                 beside it, so with wrap_content heights the two optical centres do
                 not line up however they are gravitied — the box is what makes them
                 agree. Same textSize for the same reason. -->
            <TextView
                android:id="@+id/lblFlagSearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textSize="@dimen/_11ssp"
                tools:text="🇮🇳" />

            <TextView
                android:id="@+id/lblCountrySearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_11ssp"
                android:textStyle="bold"
                tools:text="+91" />

            <!-- Caret as a sized ImageView: a compound drawable draws at its own
                 intrinsic 24dp, which towers over an 11ssp label. -->
            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:layout_marginStart="@dimen/_3sdp"
                android:contentDescription="@null"
                android:src="@drawable/glyph_caret_down"
                app:tint="@color/on_surface_variant" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/_22sdp"
            android:layout_marginStart="@dimen/_6sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:background="@color/outline" />

        <EditText
            android:id="@+id/inpNumberInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="@string/lookup_search_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="phone"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:textSize="@dimen/_11ssp" />

        <ImageView
            android:id="@+id/picClear"
            android:layout_width="@dimen/_26sdp"
            android:layout_height="@dimen/_26sdp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_cancel"
            android:padding="@dimen/_6sdp"
            android:src="@drawable/glyph_close"
            android:visibility="gone"
            app:tint="@color/on_surface_variant" />

        <ImageView
            android:id="@+id/padSearch"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_marginStart="@dimen/_2sdp"
            android:background="@drawable/shape_circle_primary"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/lookup_search_number"
            android:padding="@dimen/_9sdp"
            android:src="@drawable/glyph_search"
            app:tint="@color/on_primary" />
    </LinearLayout>

    <!-- Paste suggestion — shown only when the clipboard holds a phone number.
         40dp lavender pill: clipboard glyph + "Paste" + mono number (per design). -->
    <LinearLayout
        android:id="@+id/flagPaste"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_38sdp"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:background="@drawable/shape_cta_pill"
        android:clickable="true"
        android:elevation="@dimen/_2sdp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_16sdp"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/_15sdp"
            android:layout_height="@dimen/_15sdp"
            android:contentDescription="@string/lookup_paste"
            android:src="@drawable/glyph_paste"
            app:tint="@color/on_primary_container" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="@string/lookup_paste"
            android:textColor="@color/on_primary_container"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblPasteNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/on_primary_container"
            android:textSize="@dimen/_11ssp"
            tools:text="+91 98220 41177" />
    </LinearLayout>

    <!-- Native-banner ad slot, directly under the flag/paste row. Filled by
         BaseFragment.showScreenAd() from this fragment's own `ScreenAds` entry;
         stays GONE when ads are off or `show:false`. Outside the scroll view so
         it holds its position at the top of the tab. -->
    <FrameLayout
        android:id="@+id/adNativeFrameVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:visibility="gone">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/adShimmerVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/gads_native_banner" />
        </com.facebook.shimmer.ShimmerFrameLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Shimmer skeleton shown during search loading -->
        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shmResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_card_border"
                android:orientation="vertical"
                android:padding="@dimen/_12sdp">

                <View
                    android:layout_width="@dimen/_110sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:alpha="0.18"
                    android:background="@drawable/shape_shimmer_placeholder" />

                <View
                    android:layout_width="@dimen/_160sdp"
                    android:layout_height="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_8sdp"
                    android:alpha="0.18"
                    android:background="@drawable/shape_shimmer_placeholder" />

                <View
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:alpha="0.18"
                    android:background="@drawable/shape_shimmer_placeholder" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/_1sdp"
                    android:layout_marginVertical="@dimen/_14sdp"
                    android:alpha="0.12"
                    android:background="@color/on_surface_variant" />

                <View
                    android:layout_width="@dimen/_140sdp"
                    android:layout_height="@dimen/_12sdp"
                    android:alpha="0.18"
                    android:background="@drawable/shape_shimmer_placeholder" />
            </LinearLayout>
        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrlContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/_16sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Result card.
                     Built in the same language as the block-a-number dialog: a
                     rounded icon chip heading the block, one bordered container
                     holding the facts, and an outlined/filled action pair at the
                     foot. Sharing the language matters because both surfaces are
                     "here is a number, decide what to do about it". -->
                <LinearLayout
                    android:id="@+id/cvResultVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_16sdp"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/shape_cid_card"
                    android:elevation="@dimen/_1sdp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/card_shadow"
                    android:outlineSpotShadowColor="@color/card_shadow"
                    android:padding="@dimen/_14sdp"
                    android:visibility="gone">

                    <!-- ===== Header ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_38sdp"
                            android:layout_height="@dimen/_38sdp"
                            android:background="@drawable/shape_cid_chip_brand"
                            android:contentDescription="@null"
                            android:padding="@dimen/_9sdp"
                            android:src="@drawable/glyph_search"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.1"
                                android:text="@string/number_lookup"
                                android:textAllCaps="true"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/_9ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/lblResNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.02"
                                android:maxLines="1"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_16ssp"
                                android:textStyle="bold"
                                tools:text="+91 846 085 3367" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/lblResName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/on_surface_variant"
                                    android:textSize="@dimen/_11ssp"
                                    tools:text="N••••" />

                                <ImageView
                                    android:id="@+id/picRevealName"
                                    android:layout_width="@dimen/_20sdp"
                                    android:layout_height="@dimen/_20sdp"
                                    android:layout_marginStart="@dimen/_5sdp"
                                    android:contentDescription="@string/lookup_unknown_caller"
                                    android:padding="@dimen/_2sdp"
                                    android:src="@drawable/glyph_view"
                                    android:visibility="gone"
                                    app:tint="@color/primary" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/padResCall"
                            android:layout_width="@dimen/_38sdp"
                            android:layout_height="@dimen/_38sdp"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:background="@drawable/shape_cid_chip_teal"
                            android:contentDescription="@string/action_call"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="@dimen/_9sdp"
                            android:src="@drawable/glyph_call"
                            app:tint="@color/cid_teal" />
                    </LinearLayout>

                    <!-- Verdict pill. Text, colours and icon are all set from
                         NumberFinderFragment.bindStatusPill(). -->
                    <TextView
                        android:id="@+id/lblResValid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/shape_pill"
                        android:backgroundTint="@color/success_soft"
                        android:drawablePadding="@dimen/_5sdp"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="@dimen/_11sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:textColor="@color/success"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        app:drawableStartCompat="@drawable/glyph_verified"
                        app:drawableTint="@color/success"
                        tools:text="Valid number" />

                    <!-- ===== Facts ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:background="@drawable/shape_block_field"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_4sdp">

                        <LinearLayout style="@style/LookupFactRow">

                            <ImageView
                                style="@style/LookupFactIcon"
                                android:src="@drawable/glyph_language"
                                app:tint="@color/cid_teal" />

                            <TextView
                                style="@style/LookupFactLabel"
                                android:text="@string/lookup_country" />

                            <TextView
                                android:id="@+id/lblResCountry"
                                style="@style/LookupFactValue"
                                tools:text="India" />
                        </LinearLayout>

                        <View style="@style/LookupFactDivider" />

                        <LinearLayout style="@style/LookupFactRow">

                            <ImageView
                                style="@style/LookupFactIcon"
                                android:src="@drawable/glyph_sim_card"
                                app:tint="@color/primary" />

                            <TextView
                                style="@style/LookupFactLabel"
                                android:text="@string/lookup_carrier" />

                            <TextView
                                android:id="@+id/lblResCarrier"
                                style="@style/LookupFactValue"
                                tools:text="Tata Docomo" />
                        </LinearLayout>

                        <View style="@style/LookupFactDivider" />

                        <LinearLayout style="@style/LookupFactRow">

                            <ImageView
                                style="@style/LookupFactIcon"
                                android:src="@drawable/glyph_info"
                                app:tint="@color/cid_amber" />

                            <TextView
                                style="@style/LookupFactLabel"
                                android:text="@string/lookup_line_type" />

                            <TextView
                                android:id="@+id/lblResType"
                                style="@style/LookupFactValue"
                                tools:text="Mobile" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- ===== Actions ===== -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/padResShare"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginEnd="@dimen/_5sdp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/action_share"
                            android:textAllCaps="false"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            app:cornerRadius="@dimen/_21sdp"
                            app:icon="@drawable/glyph_share"
                            app:iconGravity="textStart"
                            app:iconPadding="@dimen/_5sdp"
                            app:iconSize="@dimen/_15sdp"
                            app:iconTint="@color/on_surface"
                            app:strokeColor="@color/outline" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/padShowFullDetail"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_weight="1.4"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/show_full_detail"
                            android:textAllCaps="false"
                            android:textColor="@color/on_primary"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="@dimen/_21sdp" />
                    </LinearLayout>
                </LinearLayout>


                <!-- Empty state — animated breathing search icon (no Lottie) -->
                <LinearLayout
                    android:id="@+id/rowEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_32sdp"
                    android:visibility="gone">

                    <!-- Two badges orbit the pulsing disc: one says "we name
                         callers", the other "we flag spam". They are what makes
                         the empty state describe the feature rather than just
                         decorate the gap. -->
                    <FrameLayout
                        android:layout_width="@dimen/_100sdp"
                        android:layout_height="@dimen/_86sdp"
                        android:clipChildren="false"
                        android:clipToPadding="false">

                        <com.numify.callerid.lookup.feature.widgets.RippleIconView
                            android:layout_width="@dimen/_82sdp"
                            android:layout_height="@dimen/_82sdp"
                            android:layout_gravity="center"
                            app:ripple_disc="@drawable/shape_empty_circle_tools"
                            app:ripple_icon="@drawable/glyph_search_plus"
                            app:ripple_iconSize="@dimen/_34sdp"
                            app:ripple_iconTint="@color/on_primary_container"
                            app:ripple_ring="@drawable/shape_ring_tools" />

                        <ImageView
                            android:id="@+id/badgeNamedVw"
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_gravity="top|end"
                            android:background="@drawable/shape_cid_chip_teal"
                            android:contentDescription="@null"
                            android:padding="@dimen/_6sdp"
                            android:src="@drawable/glyph_person"
                            app:tint="@color/cid_teal" />

                        <ImageView
                            android:id="@+id/badgeSpamVw"
                            android:layout_width="@dimen/_24sdp"
                            android:layout_height="@dimen/_24sdp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/shape_cid_chip_clay"
                            android:contentDescription="@null"
                            android:padding="@dimen/_6sdp"
                            android:src="@drawable/glyph_block_circle"
                            app:tint="@color/cid_clay" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:gravity="center"
                        android:letterSpacing="-0.025"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/lookup_empty_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_17ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/lookup_empty_sub"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_11ssp" />

                    <LinearLayout
                        android:id="@+id/padEmptySearch"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_18sdp"
                        android:background="@drawable/shape_cid_cta_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_20sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@string/lookup_empty_cta"
                            android:src="@drawable/glyph_search"
                            app:tint="@color/on_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:text="@string/lookup_empty_cta"
                            android:textColor="@color/on_primary"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- History Header -->
                <LinearLayout
                    android:id="@+id/rowHistoryHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_20sdp"
                    android:visibility="gone">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/shape_section_dot" />

                    <TextView
                        android:id="@+id/lblHistoryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:layout_weight="1"
                        android:letterSpacing="0.1"
                        android:text="@string/recent_lookups"
                        android:textAllCaps="true"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_9ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/lblHistoryClearAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/_4sdp"
                        android:text="@string/clear_all"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rollHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:visibility="gone"
                    tools:listitem="@layout/cell_search_history" />

                <LinearLayout
