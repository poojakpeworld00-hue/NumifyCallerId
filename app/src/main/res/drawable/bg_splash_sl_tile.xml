<?xml version="1.0" encoding="utf-8"?>
<!--
    The app-icon tile at the centre of the waveform: Sapphire → light Sapphire,
    top-left to bottom-right. Same gradient in light and dark, per the design.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:angle="315"
        android:endColor="@color/splash_sl_brand_2"
        android:startColor="@color/splash_sl_brand"
        android:type="linear" />
    <corners android:radius="@dimen/_23sdp" />
</shape>
