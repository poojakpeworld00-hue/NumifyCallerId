<?xml version="1.0" encoding="utf-8"?>
<!-- Language row: round country flag leads, then native name (titleMedium) over
     English name (bodySmall), custom radio on the trailing edge. Selection tint +
     radio state are driven from LanguageAdapter via View.isActivated. ~56dp tall. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/columnLanguage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/_1sdp"
    android:background="@drawable/bg_language_row"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="@dimen/_46sdp"
    android:paddingHorizontal="@dimen/_12sdp"
    android:paddingVertical="@dimen/_5sdp">

    <!-- Country flag leading the row. The emoji is sized SMALLER than the chip so
         the whole flag shows at its own aspect ratio — it is deliberately not
         cropped. The chip behind it is what gives the row a consistent leading
         block whatever shape the flag is. -->
    <FrameLayout
        android:id="@+id/chipChip"
        android:layout_width="@dimen/_30sdp"
        android:layout_height="@dimen/_30sdp"
        android:background="@drawable/bg_flag_chip"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textFlag"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textSize="@dimen/_20sdp"
            tools:ignore="SpUsage"
            tools:text="🇮🇳" />
    </FrameLayout>

    <TextView
        android:id="@+id/textNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/textName"
        app:layout_constraintEnd_toStartOf="@id/radio"
        app:layout_constraintStart_toEndOf="@id/chipChip"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Hindi" />

    <TextView
        android:id="@+id/textName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_1sdp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/radio"
        app:layout_constraintStart_toEndOf="@id/chipChip"
        app:layout_constraintTop_toBottomOf="@id/textNative"
        tools:text="Hindi" />

    <ImageView
        android:id="@+id/radio"
        android:layout_width="@dimen/_18sdp"
        android:layout_height="@dimen/_18sdp"
        android:background="@drawable/bg_language_radio"
        android:contentDescription="@null"
        android:padding="@dimen/_3sdp"
        android:src="@drawable/ic_check"
        app:tint="@color/selector_language_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
