<?xml version="1.0" encoding="utf-8"?>
<!--
    Language (design: Numify Language Screen).

    A title block and a gradient "Continue" pill sit across the top, then two
    grouped white cards — "Suggested" and "All languages" — each introduced by a
    small-caps label with a rule running out to the edge. Rows carry a coloured
    two-letter chip, the endonym over the English name, and a trailing checkbox;
    the selected row takes the brand wash. Rows fade and rise in on a 60ms stagger
    (RowEntrance), which is the handoff's `.lang-row` keyframe.

    Flow is untouched: the same two RecyclerViews, the same Continue button, and
    the native ad still pinned below the list. Only the surface changed.

    Sizes are the design's px carried straight over as dp. The project's sdp/ssp
    scale is not 1:1 with dp — `_20sdp` is 24dp on a sw360dp phone — so using it
    here would inflate the screen by a fifth against the design.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/languageRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.language.LanguagePickerActivity">

        <!-- ===== Header ===== -->
        <ImageView
            android:id="@+id/buttonBack"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="20dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/onboarding_skip"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/textTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/textTitle"
            app:tint="@color/ds_ink" />

        <TextView
            android:id="@+id/textTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:letterSpacing="0.0038"
            android:text="@string/language_title"
            tools:text="Language: English"
            android:textColor="@color/ds_ink"
            android:textSize="26sp"
            app:layout_constraintEnd_toStartOf="@id/buttonContinue"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/buttonInfo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/language_info_title"
            android:padding="6dp"
            android:src="@drawable/ic_info"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/buttonContinue"
            app:layout_constraintEnd_toStartOf="@id/buttonContinue"
            app:layout_constraintTop_toTopOf="@id/buttonContinue"
            app:tint="@color/ds_ink_muted" />

        <!-- Gradient confirm pill. It carries a label, not just a glyph: this is
             the only action on the screen. -->
        <TextView
            android:id="@+id/buttonContinue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_ds_continue_pill"
            android:drawableStart="@drawable/ic_check"
            android:drawablePadding="6dp"
            android:elevation="8dp"
            android:fontFamily="@font/mulish_bold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:outlineAmbientShadowColor="@color/ds_accent_shadow"
            android:outlineSpotShadowColor="@color/ds_accent_shadow"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="@string/language_continue"
            android:textColor="@color/ds_on_accent"
            android:textSize="14sp"
            app:drawableTint="@color/ds_on_accent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- The list starts below whichever of the title block or the confirm pill
             runs deeper — at a large system font scale, or with a long language
             name wrapping the title, that is the title; at the default it is the
             pill. -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/headerBottomBarrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="textTitle,buttonContinue" />

        <!-- ===== Suggested + All languages — one continuous scroll ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="32dp"
            app:layout_constraintBottom_toTopOf="@id/adNativeFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerBottomBarrier">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <!-- Suggested — the dot marks this as the recommended group -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_section_dot" />

                    <TextView
                        android:id="@+id/textSuggested"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/mulish_bold"
                        android:letterSpacing="0.1217"
                        android:text="@string/language_suggested"
                        android:textAllCaps="true"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="11.5sp" />

                    <!-- Rule runs from the label to the edge, so the eye is carried
                         across the group it labels rather than stopping at the text. -->
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/ds_rule" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listSuggested"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_card"
                    android:clipToOutline="true"
                    android:clipToPadding="false"
                    android:elevation="6dp"
                    android:nestedScrollingEnabled="false"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:overScrollMode="never"
                    tools:itemCount="2"
                    tools:listitem="@layout/item_language" />

                <!-- All languages -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textAll"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mulish_bold"
                        android:letterSpacing="0.1217"
                        android:text="@string/language_all"
                        android:textAllCaps="true"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="11.5sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@color/ds_rule" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/listLanguages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_card"
                    android:clipToOutline="true"
                    android:clipToPadding="false"
                    android:elevation="6dp"
                    android:nestedScrollingEnabled="false"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_language" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating the list from the ad below -->
        <View
            android:id="@+id/adNativeDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/adNativeFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== Native ad (labelled card, pinned below the list) ===== -->
        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/admob_big_native" />

            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
