    <!-- ===== Splash · "Scanline" (design: Splash Redesign · direction 1a) =====
         The design ships this screen in Sapphire, but the splash is the first
         thing the user sees and it handed off to an Indigo app — so every
         Sapphire value below is the design's colour hue-rotated +35° onto the
         app's brand hue, with saturation, lightness and alpha left untouched.
         That keeps the design's tuned contrast relationships (see the waveform
         note) while the splash reads as the same product as the rest of the app.
         Verdict colours stay reserved for the verdict badges. Dark in
         values-night. -->
    <color name="splash_sl_bg_center">#F7F4FF</color>     <!-- radial bg, at 50%/34% -->
    <color name="splash_sl_bg_edge">#FFFFFF</color>       <!-- radial bg, edge -->
    <color name="splash_sl_brand">#2563EB</color>         <!-- Indigo · icon-tile start (= @color/primary) -->
    <color name="splash_sl_brand_2">#60A5FA</color>       <!-- icon-tile end (same in dark) -->
    <!-- Waveform. The design's unlit #DCE3F2 sits at ~1.15:1 against this
         backdrop and reads as blank space on a real screen, so the track is
         deepened well past the design value until the wave is clearly legible
         before it lights — while staying far enough off `_bar_lit` that the
         light-up still lands. The scan band is likewise carried up to 40%; below
         that it disappears into a near-white background. -->
    <color name="splash_sl_bar_track">#CBD0DB</color>     <!-- waveform bar, unlit (neutral grey — the brand hue is reserved for lit) -->
    <color name="splash_sl_sweep">#662563EB</color>       <!-- 40% band that lights the bars -->
    <color name="splash_sl_sweep_edge">#002563EB</color>  <!-- same hue at 0 alpha, no grey fringe -->
    <color name="splash_sl_badge_bg">#FFFFFF</color>      <!-- the six feature badges -->
    <color name="splash_sl_footer">#9BA3B4</color>
    <color name="splash_sl_icon_amber">#E5920A</color>    <!-- badge · spam -->
    <color name="splash_sl_icon_blue">#2563EB</color>     <!-- badge · lookup / contact / location (brand hue) -->
    <color name="splash_sl_icon_green">#1E8E5A</color>    <!-- badge · protection -->

