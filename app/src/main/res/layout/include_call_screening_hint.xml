<?xml version="1.0" encoding="utf-8"?>
<!--
    One-time coach-mark under the call-screening card. Shares the search
    hint's treatment so the two coach-marks read as the same mechanism.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_16sdp">

    <!-- See include_tools_tour_hint: CoachMarkOverlay finds @id/coachCaret and
         centres it under the spotlight. -->
    <ImageView
        android:id="@+id/coachCaret"
        android:layout_width="@dimen/_16sdp"
        android:layout_height="@dimen/_8sdp"
        android:layout_marginStart="@dimen/_24sdp"
        android:contentDescription="@null"
        android:src="@drawable/ic_hint_caret"
        app:tint="@color/surface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hint_bubble"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_12sdp"
        android:paddingEnd="@dimen/_12sdp"
        android:paddingVertical="@dimen/_12sdp">

        <ImageView
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:background="@drawable/bg_cid_chip_brand"
            android:contentDescription="@null"
            android:padding="@dimen/_8sdp"
            android:src="@drawable/ic_hand_tap"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_weight="1"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/call_screening_hint_tip"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_11ssp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_cid_cta_pill"
            android:gravity="center"
            android:paddingHorizontal="@dimen/_14sdp"
            android:text="@string/got_it"
            android:textColor="@color/on_primary"
            android:textSize="@dimen/_10ssp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
