<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/home_recent_label"
                android:textColor="@color/ds_ink"
                android:textSize="24sp" />

            <!-- Live counts, set from CallLogFragment. -->
            <TextView
                android:id="@+id/textRecentsCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/mulish_semibold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink_muted"
                android:textSize="13sp"
                tools:text="32 calls · 14 missed" />
        </LinearLayout>

        <!-- Premium sits at the head of the action cluster, before the filter.
             Hidden outright once the entitlement is held - see
             CallLogFragment.bindPremiumBadge. -->
        <com.callerid.numberlookup.home.feature.premium.PremiumBadgeView
            android:id="@+id/buttonRecentsPremium"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp" />

        <ImageView
            android:id="@+id/buttonRecentsFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_ds_header_chip"
            android:contentDescription="@string/filter_all"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_filter_list"
            app:tint="@color/ds_ink" />

        <ImageView
            android:id="@+id/buttonSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_ds_header_chip"
            android:contentDescription="@string/nav_settings"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="11dp"
            android:src="@drawable/ic_settings"
            app:tint="@color/ds_ink" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarRecents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_page"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll">



        <LinearLayout
            android:id="@+id/columnPermHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_12sdp"
            android:paddingEnd="@dimen/_6sdp"
            android:paddingVertical="@dimen/_8sdp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="@dimen/_18sdp"
                android:layout_height="@dimen/_18sdp"
                android:contentDescription="@null"
                android:src="@drawable/ic_shield_check"
                app:tint="@color/ds_accent" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_weight="1"
                android:text="@string/home_perm_hint"
                android:textColor="@color/ds_ink"
                android:textSize="@dimen/_10ssp" />

            <TextView
                android:id="@+id/buttonPermManage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_6sdp"
                android:text="@string/home_perm_manage"
                android:textColor="@color/white"
                android:textSize="@dimen/_10ssp"
                android:textStyle="bold" />
        </LinearLayout>


        <!-- The "Recent" section label is gone: the screen's own title says it now.

             Ask AI used to be pinned at the right end of this row, which cost the
             chips a third of their width and still clipped "Outgoing" mid-word.
             It lives in Tools now, with the other assistant entry points, and the
             filters have the row to themselves. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fadingEdgeLength="20dp"
            android:requiresFadingEdge="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_16sdp"
            android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tabAll"
                        style="@style/RecentFilterTab"
                        android:drawableStart="@drawable/ic_recent_all"
                        android:text="@string/filter_all" />

                    <TextView
                        android:id="@+id/tabIncoming"
                        style="@style/RecentFilterTab"
                        android:drawableStart="@drawable/filter_incoming"
                        android:text="@string/filter_incoming" />

                    <TextView
                        android:id="@+id/tabOutgoing"
                        style="@style/RecentFilterTab"
                        android:drawableStart="@drawable/filter_outgoing"
                        android:text="@string/filter_outgoing" />

                    <TextView
                        android:id="@+id/tabMissed"
                        style="@style/RecentFilterTab"
                        android:layout_marginEnd="0dp"
                        android:drawableStart="@drawable/ic_call_missed"
                        android:text="@string/filter_missed" />
                </LinearLayout>
        </HorizontalScrollView>

        <!-- The ad sits under the chips, so nothing paid-for comes between the
             screen's title and the control that filters it. -->
        <View
            android:id="@+id/adNativeDivider"
            android:layout_marginTop="@dimen/_10sdp"
            style="@style/AdDivider" />

        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/surface_2">

                <include layout="@layout/admob_native_banner" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <View
            android:id="@+id/adNativeDivider1"
            style="@style/AdDivider" />

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- One grouped card rather than loose rows — the handoff's
             `background:#fff; border-radius:18px; overflow:hidden`, and the same
             frame item_contact already sits in.

             The 16dp bottom margin is the handoff's `margin-bottom:16px`, and it
             is doing real work here: the content area ends flush with the top of
             the nav island, so without it a row is guillotined exactly where the
             island's white begins and the two read as one shape. This keeps a
             band of page colour between them at every scroll position. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listRecents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_ds_card"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/_76sdp"
            tools:listitem="@layout/item_call" />

        <com.callerid.numberlookup.home.feature.widgets.EmptyStateView
            android:id="@+id/textEmpty"
            android:layout_width="match_parent"
            android:elevation="8dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!--
            A NestedScrollView, not a plain column, and that is load-bearing.

            Everything above the list — protection banner, permission hint,
            lookup card, native ad, Recent label, filter tabs — rides in the
            AppBarLayout, which only scrolls off when a nested-scrolling child
            reports a drag. While the permission state is up, [listRecents] is
            GONE, so if this were a LinearLayout nothing would report anything
            and the header could not collapse.

            It used to also set fillViewport with the column centred, which put
            it straight back into that hole: fillViewport stretches the child to
            the viewport, so a short column had nothing to scroll, reported no
            drag, and the header stayed put — and centring what was left in the
            sliver below a 1100px header pushed the title, the message and the
            Grant button off the bottom of the screen. All that showed was the
            icon, half behind the nav island.

            So: no fillViewport, content top-aligned, and CallLogFragment
            collapses the header while this is up. The card is then the first
            thing in view, and if it ever does outgrow the space it scrolls.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/permState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp"
            android:visibility="gone">

            <!-- A card, like everything else the user is asked to act on. As
                 loose centred text it read as an empty state — something to be
                 waited out — rather than a thing with a button on it. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_ds_card"
                android:elevation="4dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:outlineAmbientShadowColor="@color/ds_card_shadow"
                android:outlineSpotShadowColor="@color/ds_card_shadow"
                android:paddingHorizontal="24dp"
                android:paddingVertical="22dp">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_icon_box"
                    android:contentDescription="@string/perm_calllog_title"
                    android:padding="15dp"
                    android:src="@drawable/ic_history"
                    app:tint="@color/ds_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="@string/perm_calllog_title"
                    android:textColor="@color/ds_ink"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.3"
                    android:text="@string/perm_calllog_message"
                    android:textColor="@color/ds_ink_muted"
                    android:textSize="12.5sp" />

                <!-- Full width and 48dp tall: this is the only thing to do on
                     the screen, so it should be impossible to miss or mis-tap. -->
                <TextView
                    android:id="@+id/buttonGrant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/bg_ds_identify_cta"
                    android:fontFamily="@font/mulish_bold"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:minHeight="48dp"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="14dp"
                    android:text="@string/action_grant"
                    android:textColor="@color/ds_on_accent"
                    android:textSize="14.5sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- Quick dialer: the glyph alone. The label was redundant next to a keypad
         icon and, on a list this dense, a word-wide button covered a row's worth
         of numbers wherever it came to rest. The string stays as the content
         description so the action is still named to TalkBack.

         A direct child of the CoordinatorLayout, NOT of the scrolling frame
         above. `appbar_scrolling_view_behavior` lays that frame out at full
         height starting below the AppBar, so its bottom hangs off the screen by
         the header's height — and a button gravitied to the bottom of it went
         with it. With the header expanded, which is how the screen opens, all
         that showed was the top of a blue disc behind the nav bar. Here it is
         anchored to the screen, which is what a floating action is.

         32dp of margin, being the card's own 20dp plus a 12dp inset, so it
         floats over the card rather than straddling its rounded corner; 12dp of
         elevation to clear the card's 6dp; and the list carries enough bottom
         padding to scroll its last row out from under it. -->
    <ImageView
        android:id="@+id/buttonRecentsDial"
        android:layout_width="@dimen/_44sdp"
        android:layout_height="@dimen/_44sdp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_dial_fab"
        android:clickable="true"
        android:contentDescription="@string/quick_dialer"
        android:elevation="12dp"
        android:focusable="true"
        android:outlineAmbientShadowColor="@color/ds_card_shadow"
        android:outlineSpotShadowColor="@color/ds_card_shadow"
        android:padding="@dimen/_13sdp"
        android:src="@drawable/ic_dialpad"
        app:tint="@color/white" />
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
