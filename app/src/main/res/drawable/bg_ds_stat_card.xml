<?xml version="1.0" encoding="utf-8"?>
<!-- A tool screen's stat tile: `background:#fff; border-radius:16px` under
     `box-shadow: 0 4px 12px rgba(20,30,60,0.05)`, which the style supplies as
     elevation so the shadow tracks the rounded outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface" />
    <corners android:radius="16dp" />
</shape>
