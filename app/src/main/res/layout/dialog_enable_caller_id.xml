<?xml version="1.0" encoding="utf-8"?>
<!--
    Enable-Caller-ID bottom sheet (design: "Enable Caller ID Dialog").
    Shown from the Block List when the CallScreening role is off. The sheet springs
    up over a dimmed scrim; the shield pops with a pulse ring + drawing checkmark,
    a "next step" hint strip previews the system toggle, and the CTA breathes.
    Animations are wired in BlocklistActivity.animateEnableCallerIdDialog().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cid_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="26dp">

    <!-- Shield tile with pulse ring -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/shieldRing"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_cid_ring" />

        <FrameLayout
            android:id="@+id/shieldTile"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_cid_shield_tile">

            <ImageView
                android:id="@+id/shieldIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="@string/blocklist_enable_cid_title"
                android:src="@drawable/ic_cid_shield" />
        </FrameLayout>
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="@font/space_grotesk_bold"
        android:text="@string/blocklist_enable_cid_title"
        android:textColor="@color/ds_ink"
        android:textSize="21sp"
        android:textStyle="bold" />

    <!-- Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.5"
        android:text="@string/blocklist_enable_cid_message"
        android:fontFamily="@font/mulish_semibold"
        android:textColor="@color/ds_ink_subtle"
        android:textSize="14sp" />

    <!-- "Next step" hint strip: previews the system Caller-ID toggle -->
    <LinearLayout
        android:id="@+id/hintStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_cid_hint"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:layout_marginHorizontal="@dimen/_14sdp"
            android:letterSpacing="0.095"
            android:text="@string/blocklist_enable_cid_hint_label"
            android:textAllCaps="true"
            android:textColor="@color/ds_hero_label"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="@dimen/_12sdp">

            <!-- App-icon tile -->
            <FrameLayout
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_cid_app_icon">

                <ImageView
                    android:layout_width="@dimen/_16sdp"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_call"
                    app:tint="@color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_11ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:text="@string/blocklist_enable_cid_hint_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_9ssp" />
            </LinearLayout>

            <!-- Demo toggle (animated off→on in code) -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/flipRipple"
                    android:layout_width="@dimen/_44sdp"
                    android:layout_height="@dimen/_44sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_cid_toggle_ripple" />

                <View
                    android:id="@+id/flipTrack"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_cid_toggle_track"
                    android:backgroundTint="@color/cid_toggle_off" />

                <View
                    android:id="@+id/flipThumb"
                    android:layout_width="@dimen/_18sdp"
                    android:layout_height="@dimen/_18sdp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="@dimen/_3sdp"
                    android:background="@drawable/bg_cid_toggle_thumb" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- "Not now" is plain text at the same size as the CTA's label, and the
             CTA takes the rest of the row. The handoff weights the choice that
             way deliberately: declining stays available without being styled as
             an equal-and-opposite button. -->
        <TextView
            android:id="@+id/buttonNotNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/mulish_bold"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="8dp"
            android:text="@string/blocklist_enable_cid_not_now"
            android:textColor="@color/ds_ink_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/buttonEnable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@drawable/bg_cid_cta"
            android:elevation="8dp"
            android:fontFamily="@font/mulish_bold"
            android:gravity="center"
            android:outlineAmbientShadowColor="@color/ds_fab_shadow"
            android:outlineSpotShadowColor="@color/ds_fab_shadow"
            android:paddingVertical="15dp"
            android:text="@string/blocklist_enable_cid_confirm"
            android:textColor="@color/ds_on_accent"
            android:textSize="15.5sp" />
    </LinearLayout>
</LinearLayout>
