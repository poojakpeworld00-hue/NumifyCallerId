<?xml version="1.0" encoding="utf-8"?>
<!--
    One benefit row, transcribed from the design:

        display:flex; align-items:center; gap:11px; padding:10px 14px;
        border-bottom:1px solid #F0F2F7;

    The tile is one shape tinted per benefit (the design varies only its fill),
    and the glyph inside already carries its own stroke colour, so neither needs
    tinting here.

    The hairline is a real child rather than a decoration so PremiumActivity can
    drop it on the last row — the design hides it with the card's overflow:hidden
    instead, which Android has no equivalent of on a plain LinearLayout.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <FrameLayout
            android:id="@+id/tileBenefit"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_premium_tile">

            <ImageView
                android:id="@+id/iconBenefit"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                tools:src="@drawable/ic_premium_benefit_lookup" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textBenefitTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/mulish_bold"
                android:maxLines="1"
                android:textColor="@color/premium_ink"
                android:textSize="14sp"
                tools:text="Unlimited number lookup" />

            <TextView
                android:id="@+id/textBenefitSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/mulish_semibold"
                android:maxLines="1"
                android:textColor="@color/premium_ink_muted"
                android:textSize="11sp"
                tools:text="No daily search cap" />
        </LinearLayout>

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="11dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_premium_row_check" />
    </LinearLayout>

    <View
        android:id="@+id/benefitDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/premium_divider" />
</LinearLayout>
