<?xml version="1.0" encoding="utf-8"?>
<!-- Recent-call row (design: Numify Caller ID Home).

     Same rhythm as item_contact and item_blocklist: a 40dp leading disc, a 14.5sp
     title over a 12sp subtitle, and a trailing action — so the app's three lists
     scan as one family rather than three sizes of the same idea.

     The trailing slot is either a tinted call disc or, for an unknown number,
     "Identify" as plain text with a chevron. Text rather than a filled pill: a row
     action should not out-rank the screen's own primary buttons.

     Row background + avatar colours are still set per verdict in CallAdapter
     (spam rows get a red-tinted container). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/columnCall"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_ds_card"
    android:clipToOutline="true"
    android:elevation="4dp"
    android:foreground="?attr/selectableItemBackground"
    android:outlineAmbientShadowColor="@color/ds_card_shadow"
    android:outlineSpotShadowColor="@color/ds_card_shadow"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="13dp">

    <TextView
        android:id="@+id/textAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_ds_call_disc"
        android:fontFamily="@font/mulish_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/ds_accent"
        android:textSize="15sp"
        tools:text="112" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/mulish_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ds_ink"
            android:textSize="14.5sp"
            tools:text="Emergency · 112" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imageType"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/call_incoming"
                android:src="@drawable/ic_call_received"
                app:tint="@color/ds_ink_muted" />

            <TextView
                android:id="@+id/textSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:fontFamily="@font/mulish_semibold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink_muted"
                android:textSize="12sp"
                tools:text="Outgoing · Jul 13" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/buttonCall"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_ds_call_disc"
        android:contentDescription="@string/action_call"
        android:padding="10dp"
        android:src="@drawable/ic_ds_phone"
        app:tint="@color/ds_accent" />

    <!-- Shown instead of Call for unknown / unsaved numbers → opens Lookup. -->
    <TextView
        android:id="@+id/buttonIdentify"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:drawableEnd="@drawable/ic_ds_chevron_right"
        android:drawablePadding="2dp"
        android:focusable="true"
        android:fontFamily="@font/mulish_bold"
        android:gravity="center"
        android:minHeight="40dp"
        android:paddingHorizontal="4dp"
        android:text="@string/action_identify"
        android:textColor="@color/ds_accent"
        android:textSize="12.5sp"
        app:drawableTint="@color/ds_accent"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
