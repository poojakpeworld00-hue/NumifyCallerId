<?xml version="1.0" encoding="utf-8"?>
<!-- Ask AI, as its own 48dp tile beside the field. It takes the same violet-to-blue
     gradient as the nav's centre action, which is what marks both as "this is the
     app doing something for you" rather than a plain control. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:endColor="@color/ds_fab_end"
        android:startColor="@color/ds_fab_start"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
