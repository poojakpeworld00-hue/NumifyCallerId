<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash backdrop — a soft radial lift centred behind the app icon (design:
    `radial-gradient(120% 80% at 50% 34%, …)`). Android's radial gradient is
    circular, so the design's wide ellipse is approximated with one radius;
    centerY matches the design's 34%. Colours flip via values(-night).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <gradient
        android:centerX="0.5"
        android:centerY="0.34"
        android:endColor="@color/splash_sl_bg_edge"
        android:gradientRadius="@dimen/_300sdp"
        android:startColor="@color/splash_sl_bg_center"
        android:type="radial" />
</shape>
