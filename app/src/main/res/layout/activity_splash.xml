<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash — "Call card stack" (design: Numify Splash Redesign).

    Three frosted call cards fly in from off-screen, settle into a fanned stack,
    and the top one turns over to a "Verified" face. The wordmark and tagline rise
    in underneath, then the ad disclosure, loader pill and build stamp fade up at
    the foot of the screen. Behind all of it sits a 155-degree three-stop gradient
    with two soft white discs bleeding off opposite corners.

    Two custom views carry the parts XML cannot express: SplashBackdropView draws
    the off-axis gradient (shape drawables only do 45-degree steps) and the discs,
    and CallCardStackView draws and animates the three cards, including the flip.
    Everything else is ordinary ConstraintLayout.

    Geometry comes from the design's 396x812 content box — that is its 412x892
    frame less the 8px bezel, the 40px status bar and the 24px gesture bar. The
    vertical anchors below are that box's fractions, so the composition keeps its
    proportions on any aspect ratio; the custom views scale their own internals off
    the same box. Motion is driven from SplashActivity against SplashTimeline
    (UI only — navigation is owned by getData()).
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <FrameLayout
        android:id="@+id/splashRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/splash_cs_grad_mid"
        tools:context=".feature.splash.SplashActivity">

        <!-- Layer 0 · the gradient and its two discs, edge to edge behind the
             transparent system bars. It is told where those bars are so the discs
             stay anchored to the content box rather than sliding under them. -->
        <com.numify.callerid.lookup.feature.splash.SplashBackdropView
            android:id="@+id/splashBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <!-- Layer 1 · everything that has to keep clear of the system bars. The
             window insets are applied as padding here, which makes this view the
             on-device equivalent of the design's 396x812 content box. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/splashContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- The stack is full-bleed within the content box: the cards start
                 well outside the frame and are meant to be clipped by its edges on
                 the way in, exactly as the design's overflow:hidden does. -->
            <com.numify.callerid.lookup.feature.splash.CallCardStackView
                android:id="@+id/cardStack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Design tops of 468 and 512 in an 812-tall box. -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.5764" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.6305" />

            <!-- The footer block sits 60 up from the bottom of the same box. -->
            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.9261" />

            <TextView
                android:id="@+id/textAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:letterSpacing="0.0059"
                android:text="@string/splash_title"
                android:textColor="@color/splash_cs_ink"
                android:textSize="@dimen/splash_wordmark_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/guideWordmark" />

            <TextView
                android:id="@+id/textTagline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center_horizontal"
                android:paddingHorizontal="@dimen/splash_footer_gap"
                android:text="@string/splash_tagline"
                android:textColor="@color/splash_cs_muted"
                android:textSize="@dimen/splash_tagline_text"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/guideTagline" />

            <!-- Footer, built bottom-up so the build stamp pins to the guideline
                 and the disclosure and loader stack above it on the design's
                 14-unit gaps. -->
            <TextView
                android:id="@+id/textSecureVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:fontFamily="@font/mulish_semibold"
                android:textColor="@color/splash_cs_muted"
                android:textSize="@dimen/splash_version_text"
                app:layout_constraintBottom_toBottomOf="@id/guideFooter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="Secure v1.0.1 (2)" />

            <FrameLayout
                android:id="@+id/loaderTrack"
                android:layout_width="0dp"
                android:layout_height="@dimen/splash_loader_height"
                android:layout_marginBottom="@dimen/splash_footer_gap"
                android:background="@drawable/bg_splash_cs_loader_track"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toTopOf="@id/textSecureVersion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent="0.5051">

                <View
                    android:id="@+id/loaderFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_splash_cs_loader_fill" />

            </FrameLayout>

            <TextView
                android:id="@+id/textAdDisclosure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/splash_footer_gap"
                android:fontFamily="@font/mulish_semibold"
                android:text="@string/splash_footer"
                android:textColor="@color/splash_cs_muted"
                android:textSize="@dimen/splash_disclosure_text"
                app:layout_constraintBottom_toTopOf="@id/loaderTrack"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</layout>
