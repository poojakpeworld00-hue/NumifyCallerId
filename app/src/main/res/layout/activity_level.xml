<?xml version="1.0" encoding="utf-8"?>
<!--
    Bubble level — CID03 redesign.

    Tilt readout, the dial with its bubble, a resting hint, then roll and pitch
    broken out separately with their own travel indicators.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/levelRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.SpiritLevelActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- The handoff puts back in a 36dp chip rather than leaving it a bare
                 glyph, which is also how the home header carries its two actions. -->
            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ds_header_chip"
                android:contentDescription="@string/onboarding_skip"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/space_grotesk_bold"
                android:text="@string/tools_level"
                android:textColor="@color/ds_ink"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/buttonCalibrate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ds_chip_accent"
                android:fontFamily="@font/mulish_bold"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="9dp"
                android:text="@string/level_calibrate"
                android:textColor="@color/ds_accent"
                android:textSize="12.5sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <TextView
                    android:id="@+id/textTilt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:includeFontPadding="false"
                    android:textColor="@color/ds_ink"
                    android:textSize="40sp"
                    tools:text="1.1°" />

                <TextView
                    android:id="@+id/textStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ds_chip_accent"
                    android:fontFamily="@font/mulish_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/ds_accent"
                    android:textSize="12.5sp"
                    tools:text="Adjusting" />

                <FrameLayout
                    android:id="@+id/dialArea"
                    android:layout_width="280dp"
                    android:layout_height="280dp"
                    android:layout_marginTop="24dp"
                    android:elevation="@dimen/_3sdp"
                    android:outlineAmbientShadowColor="@color/card_shadow"
                    android:outlineSpotShadowColor="@color/card_shadow">

                    <com.callerid.numberlookup.home.feature.tools.LevelIndicatorView
                        android:id="@+id/bubble"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/_13sdp"
                        android:layout_height="@dimen/_13sdp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_hand_tap"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_5sdp"
                        android:text="@string/level_hint"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginEnd="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="@color/cid_teal" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/level_roll" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textX"
                            style="@style/BattStatValue"
                            tools:text="+0.3°" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginStart="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:rotation="90"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="@color/cid_amber" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/level_pitch" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textY"
                            style="@style/BattStatValue"
                            tools:text="−0.2°" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_12sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
