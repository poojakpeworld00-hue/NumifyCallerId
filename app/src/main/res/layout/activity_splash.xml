<?xml version="1.0" encoding="utf-8"?>
<!--
    Splash (design: Numify Splash v2).

    The screen is now the app's own light page rather than a deep blue gradient,
    and the composition is a single centred mark: three rings turning at three
    speeds around the brand tile, the wordmark and tagline under it, three
    capability chips under those, and the loader and disclosure at the foot.

    That replaces the "call card stack" — three frosted cards flying in and one
    flipping over — which took the best part of four seconds to finish telling
    its story. A splash is a screen the user wants to be past; this one says the
    app's name and what it does and gets out of the way, and the getData chain
    behind it is usually what the wait is really spent on.

    SplashMarkView draws the rings. Everything else is ordinary views: the wash,
    the tile, the chips and the loader are all shape drawables.

    Being light rather than branded-dark also means the system bars follow the
    theme here like everywhere else — SplashActivity no longer overrides them.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <FrameLayout
        android:id="@+id/splashRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.splash.SplashActivity">

        <!-- The bloom sits behind everything and bleeds off the top edge, which is
             why it is outside the inset content box. -->
        <View
            android:id="@+id/splashWash"
            android:layout_width="440dp"
            android:layout_height="440dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="-120dp"
            android:background="@drawable/bg_splash_wash"
            android:importantForAccessibility="no" />

        <!-- Everything that has to clear the system bars. The window insets are
             applied here as padding, so this is the on-device stand-in for the
             design's content box. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/splashContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ===== Centre block: mark, wordmark, tagline, chips ===== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/splashCentre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@id/loaderTrack"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.44">

                <FrameLayout
                    android:id="@+id/markBox"
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <com.callerid.numberlookup.home.feature.splash.SplashMarkView
                        android:id="@+id/splashMark"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no" />

                    <ImageView
                        android:id="@+id/imageMarkTile"
                        android:layout_width="104dp"
                        android:layout_height="104dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_splash_mark"
                        android:contentDescription="@null"
                        android:elevation="12dp"
                        android:outlineAmbientShadowColor="@color/ds_accent_shadow"
                        android:outlineSpotShadowColor="@color/ds_accent_shadow"
                        android:padding="29dp"
                        android:src="@drawable/ic_ds_phone"
                        app:tint="@color/ds_on_accent" />
                </FrameLayout>

                <TextView
                    android:id="@+id/textAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:fontFamily="@font/space_grotesk_bold"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.0125"
                    android:text="@string/splash_title"
                    android:textColor="@color/ds_ink"
                    android:textSize="40sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/markBox" />

                <TextView
                    android:id="@+id/textTagline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center_horizontal"
                    android:paddingHorizontal="32dp"
                    android:text="@string/splash_tagline"
                    android:textColor="@color/ds_ink_subtle"
                    android:textSize="14.5sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textAppName" />

                <!-- Three chips naming what the app is for. They are the one place
                     the splash says anything beyond the name, so they carry the
                     app's three verbs rather than decoration. -->
                <LinearLayout
                    android:id="@+id/rowChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/textTagline">

                    <LinearLayout
                        android:id="@+id/chipShield"
                        style="@style/SplashChip">

                        <ImageView
                            style="@style/SplashChipIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_shield_check"
                            app:tint="@color/ds_accent" />

                        <TextView
                            style="@style/SplashChipLabel"
                            android:text="@string/splash_chip_shield" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chipLookup"
                        style="@style/SplashChip"
                        android:layout_marginStart="8dp">

                        <ImageView
                            style="@style/SplashChipIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ds_search"
                            app:tint="@color/ds_success" />

                        <TextView
                            style="@style/SplashChipLabel"
                            android:text="@string/splash_chip_lookup" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/chipAi"
                        style="@style/SplashChip"
                        android:layout_marginStart="8dp">

                        <ImageView
                            style="@style/SplashChipIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_ai_sparkle"
                            app:tint="@color/ds_warning" />

                        <TextView
                            style="@style/SplashChipLabel"
                            android:text="@string/ai_ask_button" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ===== Foot: loader, disclosure, build stamp ===== -->
            <FrameLayout
                android:id="@+id/loaderTrack"
                android:layout_width="0dp"
                android:layout_height="5dp"
                android:layout_marginHorizontal="40dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_splash_v2_track"
                android:clipToOutline="true"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toTopOf="@id/textAdDisclosure"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <View
                    android:id="@+id/loaderFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_splash_v2_bar" />
            </FrameLayout>

            <TextView
                android:id="@+id/textAdDisclosure"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:drawablePadding="6dp"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center_vertical"
                android:text="@string/splash_footer"
                android:textColor="@color/ds_band_label"
                android:textSize="11.5sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="@color/ds_band_label"
                app:layout_constraintBottom_toTopOf="@id/textSecureVersion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/textSecureVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="26dp"
                android:fontFamily="@font/mulish_semibold"
                android:textColor="@color/ds_chevron"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="v1.0.1 (2)" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</layout>
