<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blocklistRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.blocklist.BlockedNumbersFragment">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:id="@+id/textBlocklistTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/space_grotesk_bold"
                android:text="@string/blocklist_title"
                android:textColor="@color/ds_ink"
                android:textSize="24sp" />
        </LinearLayout>

        <!-- ===== POPULATED ===== -->

        <!-- Slim summary strip (not a hero card celebrating a number) -->
        <LinearLayout
            android:id="@+id/summaryStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_row_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingVertical="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/adNativeFrame">

            <ImageView
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_summary_tile"
                android:contentDescription="@string/blocklist_section_blocked"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_shield_summary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textSummaryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    tools:text="12 numbers blocked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/blocklist_summary_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mid-native ad slot. It sits BELOW the empty column, which is where the
             design puts it: block card, then the "nothing blocked yet" note, then
             the ad.

             It is anchored to emptyScroll rather than to the note itself so that one
             slot serves both states. On a populated list emptyScroll is GONE, and a
             gone widget collapses to a point at its own resolved top — which is the
             bottom of topBar — so the ad lands directly under the toolbar and
             summaryStrip flows below it, exactly as it did before. Anchoring to
             summaryStrip instead would collapse the slot INTO the empty state and
             draw the two on top of each other. -->
        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/emptyScroll">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/admob_mid_native" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/textHeaderBlocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:letterSpacing="0.08"
            android:text="@string/blocklist_section_blocked"
            android:textAllCaps="true"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/summaryStrip" />

        <!-- One grouped card rather than loose rows, matching the recents and
             contacts lists: the container holds the white, the 18dp radius and
             the single shadow, and ListDividerDecoration draws the hairlines
             between rows.

             The bottom margin keeps a band of page colour between the card and
             the nav island below it. Both are white, so without it the two
             surfaces meet on a seam and read as one shape. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listBlocklist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_ds_card"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/_80sdp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDivider"
            app:layout_constraintTop_toBottomOf="@id/textHeaderBlocked"
            tools:listitem="@layout/item_blocklist" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20sdp"
            android:contentDescription="@string/blocklist_add"
            android:src="@drawable/ic_add"
            app:backgroundTint="@color/primary"
            app:elevation="@dimen/_6sdp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDivider"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Fab.Rounded"
            app:tint="@color/white" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/populatedGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="summaryStrip,textHeaderBlocked,listBlocklist,fabAdd" />

        <!-- ===== EMPTY STATE: breathing icon + headline + the three methods ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@id/adBannerDivider"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintVertical_bias="0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp">

                <!-- The action card leads the screen. With nothing blocked yet the
                     only useful thing here is adding the first number, so it is
                     typable on the spot rather than behind a menu — and the
                     "nothing here" note is demoted to a quiet line beneath it
                     instead of being the hero. Same include as the add dialog, so
                     the two cannot drift. -->
                <LinearLayout
                    android:id="@+id/emptyFormCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_hero_red"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <include
                        android:id="@+id/emptyForm"
                        layout="@layout/include_block_add_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/buttonEmptyBlock"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_ds_block_cta"
                        android:fontFamily="@font/mulish_bold"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:paddingVertical="13dp"
                        android:text="@string/action_block"
                        android:textColor="@color/ds_on_accent"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Deliberately understated: an empty blocklist is a good state,
                     not an error, so this reports it rather than dramatising it. -->
                <LinearLayout
                    android:id="@+id/emptyNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="14dp">

                    <ImageView
                        android:id="@+id/emptyIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_ds_empty_disc"
                        android:contentDescription="@null"
                        android:padding="11dp"
                        android:src="@drawable/ic_ds_block_slash"
                        app:tint="@color/ds_nav_idle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:text="@string/blocklist_empty"
                            android:textColor="@color/ds_ink"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/mulish_semibold"
                            android:text="@string/blocklist_empty_subtitle"
                            android:textColor="@color/ds_ink_muted"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Hosted as a tab: MainShellActivity owns the app-wide bottom banner, so
             this screen carries no banner slot of its own. -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
