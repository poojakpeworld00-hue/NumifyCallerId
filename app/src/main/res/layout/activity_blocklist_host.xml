<?xml version="1.0" encoding="utf-8"?>
<!-- Host for the blocklist.

     Blocklist was a nav-less tab in MainShellActivity, opened by relaunching the
     shell with an extra. That is why Back from it landed on Recents: the launch
     carried FLAG_ACTIVITY_CLEAR_TOP, which finished the Settings screen the user
     had come from, so there was nothing behind it but the shell's own tab
     history. As an Activity it simply sits on the stack above whatever opened
     it, and Back goes back.

     The screen itself is still BlockedNumbersFragment, which brings its own
     header, add form, list and native-ad slot — so this supplies the container
     and the bottom banner every other Activity gets. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blocklistHostRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page">

        <FrameLayout
            android:id="@+id/blocklistContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDivider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
