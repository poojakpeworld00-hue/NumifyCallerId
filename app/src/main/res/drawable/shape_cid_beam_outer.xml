<?xml version="1.0" encoding="utf-8"?>
<!-- Outer halo behind the torch button. Fades to nothing at its edge so it reads
     as spill rather than a drawn ring. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:type="radial"
        android:gradientRadius="50%"
        android:startColor="#2EE5920A"
        android:endColor="#00E5920A" />
</shape>
