<?xml version="1.0" encoding="utf-8"?>
<!--
    Stopwatch — CID03 redesign.

    Header (back · title · Stopwatch/Timer segmented) over an analog face with the
    readout inside it, three round transport controls, then the lap list.

    The dial is StopwatchDialView: the design lays its sixty ticks out as sixty
    absolutely-positioned spans, which cannot re-proportion for a smaller dial.
    Ad slots are unchanged from the previous layout.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/stopwatchRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.StopwatchActivity">

        <LinearLayout
            android:id="@+id/crownBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_12sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/padBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/glyph_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:text="@string/tools_stopwatch"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_cid_seg_track"
                android:orientation="horizontal"
                android:padding="@dimen/_3sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_28sdp"
                    android:background="@drawable/shape_cid_seg_active"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:text="@string/tools_stopwatch"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/padSegTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_28sdp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_11sdp"
                    android:text="@string/timer_tool"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/_10ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintTop_toBottomOf="@id/crownBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <!-- ===== Face ===== -->
                <FrameLayout
                    android:layout_width="@dimen/_210sdp"
                    android:layout_height="@dimen/_210sdp"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:elevation="@dimen/_3sdp"
                    android:outlineAmbientShadowColor="@color/card_shadow"
                    android:outlineSpotShadowColor="@color/card_shadow">

                    <com.numify.callerid.lookup.feature.tools.StopwatchDialView
                        android:id="@+id/faceVw"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Readout sits above centre so the hand's lower sweep is
                         never hidden behind the digits. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="@dimen/_62sdp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:baselineAligned="true"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/lblTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:letterSpacing="-0.04"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_32ssp"
                                android:textStyle="bold"
                                tools:text="02:14" />

                            <TextView
                                android:id="@+id/lblFraction"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_1sdp"
                                android:includeFontPadding="false"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/_16ssp"
                                android:textStyle="bold"
                                tools:text=".38" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_7sdp"
                            android:background="@drawable/shape_cid_pill_neutral"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="@dimen/_10sdp"
                            android:paddingVertical="@dimen/_4sdp"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_9ssp"
                            android:textStyle="bold"
                            tools:text="Running" />
                    </LinearLayout>
                </FrameLayout>

                <!-- ===== Transport ===== -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/padReset"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:background="@drawable/shape_cid_circle_outline"
                        android:contentDescription="@string/action_reset"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_13sdp"
                        android:src="@drawable/glyph_undo"
                        app:tint="@color/on_surface" />

                    <ImageView
                        android:id="@+id/padStartPause"
                        android:layout_width="@dimen/_66sdp"
                        android:layout_height="@dimen/_66sdp"
                        android:layout_marginHorizontal="@dimen/_12sdp"
                        android:background="@drawable/shape_cid_circle_dark"
                        android:contentDescription="@string/action_start"
                        android:elevation="@dimen/_6sdp"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:outlineAmbientShadowColor="@color/card_shadow"
                        android:outlineSpotShadowColor="@color/card_shadow"
                        android:padding="@dimen/_18sdp"
                        android:src="@drawable/glyph_play"
                        app:tint="@color/on_primary" />

                    <ImageView
                        android:id="@+id/padLap"
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        android:background="@drawable/shape_cid_circle_outline"
                        android:contentDescription="@string/stopwatch_lap"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:padding="@dimen/_13sdp"
                        android:src="@drawable/glyph_flag"
                        app:tint="@color/on_surface" />
                </LinearLayout>

                <!-- ===== Laps ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/shape_section_dot" />

                    <TextView
                        android:id="@+id/lblLapCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        tools:text="Laps" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <TextView
                    android:id="@+id/emptyStateVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:gravity="center"
                    android:text="@string/stopwatch_empty"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_11ssp" />

                <LinearLayout
                    android:id="@+id/rowLaps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/adNativeFrameVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmerVw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDividerVw"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrameVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
