<?xml version="1.0" encoding="utf-8"?>
<!--
    Intro 02 · Block Numbers. A cropped slice of Call Details for a spam number with
    the Block tile spotlighted, the Blocklist card beside it, and a "Number blocked"
    toast that rises on the same 3s clock as the tap marker.

    IntroAnimations drives: heroCard (popIn), heroResult (slide), heroResultCard
    (float), heroPulse (ring), heroTap (tap marker), heroToast (toast).
-->
<com.callerid.numberlookup.home.feature.intro.IntroHeroLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/intro_hero_block_cd"
    android:importantForAccessibility="yes"
    app:introAccent="@color/ds_danger"
    app:introBorder="@color/ds_hero_red_border"
    app:introDashAlpha="0.2"
    app:introRingAlpha="0.10"
    app:introWash="@color/intro_wash_block"
    app:introWashMid="@color/intro_wash_block_mid"
    tools:layout_height="268dp">

    <!-- Mini call details -->
    <FrameLayout
        android:id="@+id/heroScreen"
        android:layout_width="@dimen/intro_screen_w"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="-14dp"
        android:background="@drawable/bg_intro_mini_page"
        android:clipToOutline="true"
        android:elevation="10dp"
        android:importantForAccessibility="noHideDescendants"
        android:outlineAmbientShadowColor="@color/intro_shadow_blue"
        android:outlineSpotShadowColor="@color/intro_shadow_blue"
        tools:targetApi="31">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="8dp">

                <FrameLayout
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_intro_r6"
                    android:backgroundTint="@color/ds_back_chip">

                    <ImageView
                        style="@style/IntroArtIcon"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_ds_chevron_left"
                        app:tint="@color/ds_ink"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <TextView
                    style="@style/IntroArtText"
                    android:layout_marginStart="6dp"
                    android:text="@string/call_detail_title"
                    android:textSize="9.5dp"
                    tools:ignore="SpUsage" />
            </LinearLayout>

            <!-- The caller, on the detail screen's dark hero -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/bg_intro_detail_hero"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    style="@style/IntroArtText.Display"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_intro_glass_circle"
                    android:gravity="center"
                    android:text="\?"
                    android:textColor="@color/ds_on_accent"
                    android:textSize="13dp"
                    tools:ignore="HardcodedText,SpUsage" />

                <TextView
                    style="@style/IntroArtText.Display"
                    android:layout_marginTop="5dp"
                    android:text="@string/intro_art_block_number"
                    android:textColor="@color/ds_on_accent"
                    android:textSize="11.5dp"
                    tools:ignore="SpUsage" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_intro_r8"
                    android:backgroundTint="#1AFFFFFF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="2dp">

                    <ImageView
                        style="@style/IntroArtIcon"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/ds_on_hero_danger"
                        tools:ignore="ContentDescription" />

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_marginStart="3dp"
                        android:text="@string/intro_art_spam_robocall"
                        android:textColor="@color/ds_on_hero_danger"
                        android:textSize="7.5dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>
            </LinearLayout>

            <!-- Call · Message · Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_intro_r12"
                android:clipChildren="false"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp"
                android:paddingVertical="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_intro_r9"
                        android:backgroundTint="@color/ds_hero_blue_wash">

                        <ImageView
                            style="@style/IntroArtIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ds_phone"
                            app:tint="@color/ds_accent"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_call"
                        android:textColor="@color/ds_ink_strong"
                        android:textSize="7dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_intro_r9"
                        android:backgroundTint="@color/ds_violet_wash">

                        <ImageView
                            style="@style/IntroArtIcon"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_ds_message"
                            app:tint="@color/ds_violet"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_marginTop="3dp"
                        android:text="@string/action_message"
                        android:textColor="@color/ds_ink_strong"
                        android:textSize="7dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <!-- The target: ring under the tile, tap marker over it, 2dp right
                     of the column's centre as the design places it. -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false">

                    <View
                        android:id="@+id/heroPulse"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center_horizontal|top"
                        android:background="@drawable/bg_intro_ring_block" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_intro_r9"
                            android:backgroundTint="@color/ds_danger"
                            android:elevation="6dp"
                            android:outlineAmbientShadowColor="@color/ds_danger"
                            android:outlineSpotShadowColor="@color/ds_danger"
                            tools:targetApi="31">

                            <ImageView
                                style="@style/IntroArtIcon"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_ds_block_slash"
                                app:tint="@color/ds_on_accent"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <TextView
                            style="@style/IntroArtText"
                            android:layout_marginTop="3dp"
                            android:text="@string/action_block"
                            android:textColor="@color/ds_danger"
                            android:textSize="7dp"
                            tools:ignore="SpUsage" />
                    </LinearLayout>

                    <View
                        android:id="@+id/heroTap"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center_horizontal|top"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_intro_tap"
                        android:elevation="7dp"
                        android:outlineProvider="none" />
                </FrameLayout>
            </LinearLayout>

            <!-- Call history: two missed calls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_intro_r12"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_intro_oval"
                        android:backgroundTint="@color/ds_danger" />

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/intro_art_missed"
                        android:textSize="7.5dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_marginStart="6dp"
                        android:text="@string/detail_today_short"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="7dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/ds_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="5dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/bg_intro_oval"
                        android:backgroundTint="@color/ds_danger" />

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_width="0dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/intro_art_missed"
                        android:textSize="7.5dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_marginStart="6dp"
                        android:text="@string/intro_art_mon"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="7dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Blocklist card -->
    <FrameLayout
        android:id="@+id/heroResult"
        android:layout_width="@dimen/intro_result_w"
        android:elevation="14dp"
        android:outlineProvider="none"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:id="@+id/heroResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_intro_card_block"
            android:elevation="14dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/intro_shadow_red"
            android:outlineSpotShadowColor="@color/intro_shadow_red"
            android:padding="12dp"
            tools:targetApi="31">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_intro_r9"
                    android:backgroundTint="@color/ds_danger_tint">

                    <ImageView
                        style="@style/IntroArtIcon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_shield_check"
                        app:tint="@color/ds_danger"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/IntroArtText.Display"
                        android:text="@string/blocklist_title"
                        android:textSize="11.5dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_marginTop="1dp"
                        android:text="@string/intro_art_auto_rejected"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="7.5dp"
                        tools:ignore="SpUsage" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="9dp"
                android:background="@color/ds_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/IntroArtText" android:layout_width="0dp" android:layout_weight="1" android:text="@string/intro_art_block_number" android:textSize="8.5dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="4dp" android:background="@drawable/bg_intro_r6" android:backgroundTint="@color/ds_danger_tint" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="@string/intro_art_blocked" android:textColor="@color/ds_danger" android:textSize="7dp" tools:ignore="SpUsage" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:alpha="0.55"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/IntroArtText" android:layout_width="0dp" android:layout_weight="1" android:text="@string/intro_art_block_number_2" android:textSize="8.5dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="4dp" android:background="@drawable/bg_intro_r6" android:backgroundTint="@color/ds_danger_tint" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="@string/intro_art_blocked" android:textColor="@color/ds_danger" android:textSize="7dp" tools:ignore="SpUsage" />
            </LinearLayout>

            <!-- Dropped on short screens (bool/intro_result_full). -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:alpha="0.3"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:tag="intro_extra">

                <TextView style="@style/IntroArtText" android:layout_width="0dp" android:layout_weight="1" android:text="@string/intro_art_block_number_3" android:textSize="8.5dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="4dp" android:background="@drawable/bg_intro_r6" android:backgroundTint="@color/ds_danger_tint" android:paddingHorizontal="6dp" android:paddingVertical="2dp" android:text="@string/intro_art_blocked" android:textColor="@color/ds_danger" android:textSize="7dp" tools:ignore="SpUsage" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- "Number blocked" -->
    <LinearLayout
        android:id="@+id/heroToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_intro_r12"
        android:backgroundTint="@color/ds_ink"
        android:elevation="16dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal"
        android:paddingHorizontal="11dp"
        android:paddingVertical="7dp">

        <ImageView
            style="@style/IntroArtIcon"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/ic_ds_block_slash"
            app:tint="@color/ds_on_hero_danger"
            tools:ignore="ContentDescription" />

        <TextView
            style="@style/IntroArtText"
            android:layout_marginStart="6dp"
            android:text="@string/intro_art_number_blocked"
            android:textColor="@color/ds_on_accent"
            android:textSize="9.5dp"
            tools:ignore="SpUsage" />
    </LinearLayout>
</com.callerid.numberlookup.home.feature.intro.IntroHeroLayout>
