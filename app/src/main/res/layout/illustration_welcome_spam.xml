<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding hero 2 — the call that was blocked.

     Same card geometry as hero 1 in the danger ramp: a shield tile with a
     circle-slash badge notched into its corner, then the "BLOCKED CALL" eyebrow,
     the unresolved name, and the classification pill. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_hero_red"
    android:padding="16dp">

    <!-- The badge overhangs the tile by 6dp on both edges, so the pair lives in a
         box 6dp larger than the tile and clipping is turned off around it. -->
    <FrameLayout
        android:id="@+id/heroShieldBox"
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/heroShield"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_ds_danger_tile"
            android:contentDescription="@null"
            android:padding="16dp"
            android:src="@drawable/ic_ds_shield_block" />

        <ImageView
            android:id="@+id/heroBadge"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_ds_danger_badge"
            android:contentDescription="@null"
            android:padding="5dp"
            android:src="@drawable/ic_ds_block_slash" />
    </FrameLayout>

    <TextView
        android:id="@+id/heroEyebrow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/mulish_bold"
        android:letterSpacing="0.0952"
        android:text="@string/onboarding_hero_blocked"
        android:textColor="@color/ds_danger"
        android:textSize="10.5sp"
        app:layout_constraintBottom_toTopOf="@id/heroName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/heroShieldBox"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/heroName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/space_grotesk_bold"
        android:maxLines="1"
        android:text="@string/onboarding_hero_unknown"
        android:textColor="@color/ds_ink"
        android:textSize="16.5sp"
        app:layout_constraintBottom_toTopOf="@id/heroSpamPill"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/heroShieldBox"
        app:layout_constraintTop_toBottomOf="@id/heroEyebrow" />

    <TextView
        android:id="@+id/heroSpamPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="5dp"
        android:background="@drawable/bg_ds_spam_pill"
        android:fontFamily="@font/mulish_bold"
        android:letterSpacing="0.0273"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:text="@string/onboarding_hero_spam_tag"
        android:textColor="@color/ds_danger"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/heroShieldBox"
        app:layout_constraintTop_toBottomOf="@id/heroName" />

</androidx.constraintlayout.widget.ConstraintLayout>
