<?xml version="1.0" encoding="utf-8"?>
<!-- The attempt-count badge on a blocked row: the danger tint on an 8dp radius,
     per the handoff. Small and red because the count is the one thing on this
     screen that changes on its own. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_danger_tint" />
    <corners android:radius="8dp" />
</shape>
