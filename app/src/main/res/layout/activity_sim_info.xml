<?xml version="1.0" encoding="utf-8"?>
<!--
    Network info — CID03 redesign.

    A dark hero naming the connection, then two labelled groups of rows, then a
    CTA through to the speed test.

    The design's hero also shows download / upload / ping. Those are NOT here:
    this screen reads the device's network state, it does not run a transfer, so
    those figures would be invented. They live on the speed-test screen, which is
    exactly where the CTA at the foot goes.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/simRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.SimInfoActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                style="@style/ToolHeaderBack"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/ToolHeaderTitle"
                android:text="@string/tools_sim" />

            <ImageView
                android:id="@+id/buttonRefresh"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sim_refresh"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_refresh"
                app:tint="@color/primary" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <!-- ===== Hero ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:background="@drawable/bg_cid_hero_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_14sdp">

                    <ImageView
                        android:layout_width="@dimen/_38sdp"
                        android:layout_height="@dimen/_38sdp"
                        android:background="@drawable/bg_cid_hero_tile"
                        android:contentDescription="@null"
                        android:padding="@dimen/_9sdp"
                        android:src="@drawable/ic_tool_network"
                        app:tint="@color/cid_050" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textCarrier"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/space_grotesk_bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/cid_050"
                            android:textSize="18sp"
                            tools:text="Vi India" />

                        <TextView
                            android:id="@+id/textStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:alpha="0.6"
                            android:ellipsize="end"
                            android:fontFamily="@font/mulish_semibold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/cid_050"
                            android:textSize="12.5sp"
                            tools:text="Unknown · Connected" />
                    </LinearLayout>

                    <!-- Signal bars. Tinted per level in SimInfoActivity. -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:gravity="bottom"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/bar1"
                            style="@style/NetSignalBar"
                            android:layout_height="@dimen/_8sdp" />

                        <View
                            android:id="@+id/bar2"
                            style="@style/NetSignalBar"
                            android:layout_height="@dimen/_12sdp" />

                        <View
                            android:id="@+id/bar3"
                            style="@style/NetSignalBar"
                            android:layout_height="@dimen/_16sdp" />

                        <View
                            android:id="@+id/bar4"
                            style="@style/NetSignalBar"
                            android:layout_height="@dimen/_20sdp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== SIM & carrier ===== -->
                <LinearLayout style="@style/NetSectionRow">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/bg_section_dot" />

                    <TextView
                        style="@style/NetSectionLabel"
                        android:text="@string/sim_section_carrier" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_brand"
                        android:src="@drawable/ic_sim_card"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_carrier" />

                    <TextView
                        android:id="@+id/textCarrierRow"
                        style="@style/NetRowValue"
                        tools:text="Airtel" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_teal"
                        android:src="@drawable/ic_radio"
                        app:tint="@color/cid_teal" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_network_type" />

                    <TextView
                        android:id="@+id/textNetworkType"
                        style="@style/NetRowValue"
                        tools:text="5G SA" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_amber"
                        android:src="@drawable/ic_language"
                        app:tint="@color/cid_amber" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_country" />

                    <TextView
                        android:id="@+id/textCountry"
                        style="@style/NetRowValue"
                        tools:text="India · IN" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_clay"
                        android:src="@drawable/ic_tool_network"
                        app:tint="@color/cid_clay" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_signal" />

                    <TextView
                        android:id="@+id/textSignal"
                        style="@style/NetRowValue"
                        tools:text="−72 dBm" />
                </LinearLayout>

                <!-- ===== Connection ===== -->
                <LinearLayout style="@style/NetSectionRow">

                    <View
                        android:layout_width="@dimen/_5sdp"
                        android:layout_height="@dimen/_5sdp"
                        android:background="@drawable/bg_section_dot" />

                    <TextView
                        style="@style/NetSectionLabel"
                        android:text="@string/sim_section_connection" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_brand"
                        android:src="@drawable/ic_profile"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_ip" />

                    <TextView
                        android:id="@+id/textIp"
                        style="@style/NetRowValue"
                        tools:text="192.168.1.24" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_teal"
                        android:src="@drawable/ic_sim_card_alt"
                        app:tint="@color/cid_teal" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_state" />

                    <TextView
                        android:id="@+id/textSimState"
                        style="@style/NetRowValue"
                        tools:text="Ready" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_amber"
                        android:src="@drawable/ic_call"
                        app:tint="@color/cid_amber" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_phone_type" />

                    <TextView
                        android:id="@+id/textPhoneType"
                        style="@style/NetRowValue"
                        tools:text="GSM" />
                </LinearLayout>

                <LinearLayout style="@style/NetRowCard">

                    <ImageView
                        style="@style/NetRowIcon"
                        android:background="@drawable/bg_cid_chip_clay"
                        android:src="@drawable/ic_compass"
                        app:tint="@color/cid_clay" />

                    <TextView
                        style="@style/NetRowLabel"
                        android:text="@string/sim_roaming" />

                    <TextView
                        android:id="@+id/textRoaming"
                        style="@style/NetRowValue"
                        tools:text="No" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonSpeedTest"
                    style="@style/ToolCta"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/sim_run_speed_test"
                    app:icon="@drawable/ic_speed" />

                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native_two" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
