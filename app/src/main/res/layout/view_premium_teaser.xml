<?xml version="1.0" encoding="utf-8"?>
<!--
    The inside of PremiumTeaserView — the paywall's hero, as it now is: the same
    gradient card, the same "Free vs Premium" line with its two-tone spark and
    gold crown, and the same subtitle, at the same sizes.

    Not a smaller echo of it. The point of this row is that the Settings entry
    and the screen it opens are the same object, so the type is the design's
    26sp/16sp/13.5sp rather than something scaled to settings-row height.

    No chevron. The hero has none, and at 26sp the title line needs the width;
    the card is the only coloured thing on the page and it presses, so it does
    not need an arrow to read as tappable.

    <merge> because the parent is the FrameLayout that owns the background and
    the animations; a second wrapper would only add a layer to draw.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:background="@drawable/bg_premium_hero"
    tools:parentTag="android.widget.FrameLayout">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingVertical="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/teaserSpark"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_premium_spark_duo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/premium_hero_free"
                android:textColor="@color/premium_hero_title"
                android:textSize="26sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="@font/mulish_semibold"
                android:includeFontPadding="false"
                android:text="@string/premium_hero_vs"
                android:textColor="@color/premium_hero_vs"
                android:textSize="16sp" />

            <com.callerid.numberlookup.home.feature.premium.ShineTextView
                android:id="@+id/teaserPremium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/premium_hero_premium"
                android:textSize="26sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="9dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_premium_crown"
                app:tint="@color/premium_badge" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/mulish_semibold"
            android:text="@string/premium_hero_sub"
            android:textColor="@color/premium_hero_sub"
            android:textSize="@dimen/_13ssp" />
    </LinearLayout>
</merge>
