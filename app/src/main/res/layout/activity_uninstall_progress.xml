<?xml version="1.0" encoding="utf-8"?>
<!-- Uninstall flow · 4b progress (advance run): progress ring around a shaking bin that
     turns into a green check, big percent, three steps, then a "ready" toast and the
     hand-over to App info. Nothing is removed here; the copy says "preparing". -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/un_page"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <FrameLayout
                android:layout_width="170dp"
                android:layout_height="170dp">

                <com.callerid.numberlookup.home.feature.uninstall.UninstallRingView
                    android:id="@+id/ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <FrameLayout
                    android:id="@+id/binTile"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_un_bin"
                    android:backgroundTint="@color/un_surface"
                    android:elevation="8dp">

                    <ImageView
                        android:id="@+id/ivBin"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_un_g_delete"
                        app:tint="@color/un_danger_fg" />
                </FrameLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:textColor="@color/un_ink"
                android:textSize="34sp"
                tools:text="64%" />

            <TextView
                android:id="@+id/tvProgressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/un_ink"
                android:textSize="16sp"
                tools:text="Preparing to uninstall CallerId…" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/un_progress_sub"
                android:textColor="@color/un_muted"
                android:textSize="12.5sp" />

            <LinearLayout
                android:id="@+id/steps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStep1"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvStep1"
                        style="@style/UnStepText"
                        android:text="@string/un_step_1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStep2"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvStep2"
                        style="@style/UnStepText"
                        android:text="@string/un_step_2" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivStep3"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null" />

                    <TextView
                        android:id="@+id/tvStep3"
                        style="@style/UnStepText"
                        android:text="@string/un_step_3" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/readyToast"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_un_toast"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_un_g_check_circle"
                app:tint="@color/un_toast_check" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/mulish_bold"
                android:includeFontPadding="false"
                android:text="@string/un_progress_ready"
                android:textColor="@color/un_strong_fg"
                android:textSize="13sp" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout style="@style/UnAdCard">

        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/admob_mid_native_two" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
    </FrameLayout>
</LinearLayout>
</layout>
