<?xml version="1.0" encoding="utf-8"?>
<!--
    Contacts Premium - the paywall, design 1a ("Paywall with weekly-normalised
    pricing"). The design canvas is 360 wide and its CSS px map 1:1 onto dp.

    Top to bottom:
      dark hero  - close (after a countdown) + Restore, the crown tile and title,
                   four benefit tiles; full bleed, under the status bar,
                   rounded only at the bottom                          [scrolls]
      plans      - "Choose your plan", one row per Play plan, each led by its
                   price per week                                      [scrolls]
      footer     - the full-price line, the CTA, "Continue without Premium",
                   Terms · Privacy                              [pinned below]

    Everything fits a 360x800 screen without scrolling; a shorter one scrolls
    the hero and plans while the footer stays put, so the button and the price
    Google Play requires beside it never leave the screen.

    Plan rows are inflated from item_premium_plan with live Play prices; their
    per-week figures, savings and every price line are PremiumActivity's.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/premiumRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/premium_page">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/premiumScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintBottom_toTopOf="@id/premiumFooter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- ===== hero ===== paddingTop is the status bar, added in code. -->
                <com.callerid.numberlookup.home.feature.premium.PaywallHeroLayout
                    android:id="@+id/paywallHero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="20dp">

                    <!-- close / countdown · Restore -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingTop="8dp">

                        <FrameLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp">

                            <com.callerid.numberlookup.home.feature.premium.CloseCountdownView
                                android:id="@+id/closeCountdown"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <ImageView
                                android:id="@+id/buttonClose"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_paywall_glass"
                                android:contentDescription="@string/action_back"
                                android:foreground="?attr/selectableItemBackgroundBorderless"
                                android:padding="11dp"
                                android:src="@drawable/ic_premium_close"
                                android:visibility="gone"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/buttonRestore"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:fontFamily="@font/mulish_bold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:minHeight="36dp"
                            android:text="@string/premium_restore"
                            android:textColor="@color/paywall_on_hero_75"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <!-- crown tile · "Contacts Premium" · tagline -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/crownTile"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_paywall_crown"
                            android:clipToOutline="true"
                            android:elevation="10dp"
                            android:outlineAmbientShadowColor="@color/paywall_crown_shadow"
                            android:outlineSpotShadowColor="@color/paywall_crown_shadow"
                            tools:targetApi="31">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_premium_crown"
                                app:tint="@color/white" />

                            <com.callerid.numberlookup.home.feature.premium.ShineBandView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                app:shineDelay="1000"
                                app:shineDuration="3200"
                                app:shinePeak="0.5"
                                app:shineWidth="18dp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/space_grotesk_bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/paywall_brand"
                                    android:textColor="@color/white"
                                    android:textSize="25sp" />

                                <com.callerid.numberlookup.home.feature.premium.GradientTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="7dp"
                                    android:fontFamily="@font/space_grotesk_bold"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="@string/premium_hero_premium"
                                    android:textSize="25sp" />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/mulish_semibold"
                                android:text="@string/paywall_tagline"
                                android:textColor="@color/paywall_on_hero_72"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Four benefit tiles, two by two, 8dp apart -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/perkLookups"
                            layout="@layout/item_paywall_perk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/perkBlock"
                            layout="@layout/item_paywall_perk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/perkAi"
                            layout="@layout/item_paywall_perk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/perkAds"
                            layout="@layout/item_paywall_perk"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1" />
                    </LinearLayout>
                </com.callerid.numberlookup.home.feature.premium.PaywallHeroLayout>

                <!-- ===== plans ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/mulish_bold"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.12"
                        android:text="@string/paywall_choose_plan"
                        android:textAllCaps="true"
                        android:textColor="@color/premium_ink_muted"
                        android:textSize="10.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/mulish_bold"
                        android:includeFontPadding="false"
                        android:text="@string/paywall_prices_per_week"
                        android:textColor="@color/premium_price_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Rows land here. The top badge overhangs its row by 10dp, so
                     nothing here clips, and the 12dp top padding holds it. -->
                <LinearLayout
                    android:id="@+id/listPlans"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="12dp" />

                <TextView
                    android:id="@+id/textPlansStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/mulish_semibold"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.5"
                    android:paddingHorizontal="20dp"
                    android:textColor="@color/premium_price_muted"
                    android:textSize="13sp"
                    tools:text="Loading plans…" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== Pinned footer ===== -->
        <LinearLayout
            android:id="@+id/premiumFooter"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/premium_page"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- The full billed price, ahead of any breakdown (Play policy). -->
            <TextView
                android:id="@+id/textAboveCta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:textColor="@color/premium_ink_muted"
                android:textSize="12sp"
                tools:text="3 days free, then $9.99/week. Cancel anytime." />

            <FrameLayout
                android:id="@+id/buttonSubscribe"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_paywall_cta"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="12dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:outlineAmbientShadowColor="@color/premium_cta_glow"
                android:outlineSpotShadowColor="@color/premium_cta_glow"
                tools:targetApi="31">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_premium_sparkle"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/textCta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9dp"
                        android:fontFamily="@font/mulish_bold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        tools:text="Start 3-day free trial" />
                </LinearLayout>

                <com.callerid.numberlookup.home.feature.premium.ShineBandView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:shineDelay="1600"
                    app:shineDuration="3600"
                    app:shinePeak="0.28"
                    app:shineWidth="40dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/buttonContinueFree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/mulish_bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/paywall_continue_free"
                android:textColor="@color/paywall_continue"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/mulish_bold"
                    android:paddingVertical="4dp"
                    android:text="@string/premium_terms_link"
                    android:textColor="@color/premium_ink_muted"
                    android:textSize="11.5sp" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="11dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="@color/premium_radio_idle" />

                <TextView
                    android:id="@+id/buttonPrivacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/mulish_bold"
                    android:paddingVertical="4dp"
                    android:text="@string/premium_privacy_link"
                    android:textColor="@color/premium_ink_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Replaces the offer once Premium is held. The design has no owned
             state, so this one is the app's own and is deliberately plain. -->
        <LinearLayout
            android:id="@+id/stateOwned"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/premium_page"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="40dp"
            android:visibility="gone"
            tools:visibility="gone">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_premium_crown"
                android:elevation="6dp"
                android:outlineAmbientShadowColor="@color/premium_crown_shadow"
                android:outlineSpotShadowColor="@color/premium_crown_shadow"
                tools:targetApi="31">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_premium_crown" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:gravity="center"
                android:text="@string/premium_owned_title"
                android:textColor="@color/premium_ink"
                android:textSize="@dimen/_19ssp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/mulish_semibold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.35"
                android:text="@string/premium_owned_sub"
                android:textColor="@color/premium_ink_muted"
                android:textSize="@dimen/_13ssp" />

            <!-- The way out. Without it this screen is a dead end: the purchase
                 is done, the crown is drawn, and the only controls are Manage and
                 the close cross in the corner. -->
            <TextView
                android:id="@+id/buttonGoToApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_premium_pill"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/mulish_bold"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="52dp"
                android:text="@string/premium_go_to_app"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp" />

            <TextView
                android:id="@+id/buttonManage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:text="@string/premium_manage"
                android:textColor="@color/premium_accent"
                android:textSize="@dimen/_12ssp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
