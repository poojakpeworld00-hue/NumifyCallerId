<?xml version="1.0" encoding="utf-8"?>
<!--
    Ask AI settings. One switch per surface the assistant actually occupies, so
    a user who only wants the incoming-call verdict can have exactly that.

    The closing note is not decoration: it states what leaves the device and what
    is never captured, and it has to keep matching the Play data-safety
    declaration. Change one and change the other.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:id="@+id/aiSettingsRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingVertical="@dimen/_10sdp">

            <ImageView
                android:id="@+id/buttonAiSettingsBack"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_back"
                android:padding="@dimen/_7sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:includeFontPadding="false"
                android:text="@string/ai_settings_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_15ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingBottom="@dimen/_20sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_4sdp">

                    <include
                        android:id="@+id/rowAiHome"
                        layout="@layout/item_ai_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/SettingsRowDivider" />

                    <include
                        android:id="@+id/rowAiVerdict"
                        layout="@layout/item_ai_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/SettingsRowDivider" />

                    <include
                        android:id="@+id/rowAiSummary"
                        layout="@layout/item_ai_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/SettingsRowDivider" />

                    <include
                        android:id="@+id/rowAiSmartReply"
                        layout="@layout/item_ai_setting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- Questions asked. Shown as a plain count, not a quota: there is
                     no purchase to make, so framing it as "3 of 5" would advertise
                     a limit that does not exist. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/bg_card"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_13sdp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/ai_settings_questions_asked"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/textAiQueryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold"
                        tools:text="12" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_14sdp"
                    android:paddingVertical="@dimen/_13sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="@string/ai_settings_privacy_title"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_11ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:lineSpacingExtra="@dimen/_2sdp"
                        android:text="@string/ai_settings_privacy_body"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>
