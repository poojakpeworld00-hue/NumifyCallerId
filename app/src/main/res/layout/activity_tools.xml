<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:id="@+id/toolsRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/topBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="14dp">

                    <ImageView
                        android:id="@+id/buttonBack"
                        android:layout_width="@dimen/_34sdp"
                        android:layout_height="@dimen/_34sdp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/onboarding_skip"
                        android:padding="@dimen/_5sdp"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/ds_ink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:text="@string/tools_title"
                        android:textColor="@color/ds_ink"
                        android:textSize="24sp" />
                </LinearLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background"
            android:stateListAnimator="@null"
            app:elevation="0dp"
            app:liftOnScroll="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_scrollFlags="scroll">

                <LinearLayout
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:background="@drawable/bg_ds_outlined_field"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/tools_search_hint"
                        android:src="@drawable/ic_ds_search"
                        app:tint="@color/ds_ink_muted" />

                    <EditText
                        android:id="@+id/inputSearch"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:fontFamily="@font/mulish_semibold"
                        android:hint="@string/tools_search_hint"
                        android:imeOptions="actionSearch"
                        android:includeFontPadding="false"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="@color/ds_ink"
                        android:textColorHint="@color/ds_placeholder"
                        android:textCursorDrawable="@null"
                        android:textSize="13.5sp" />

                    <ImageView
                        android:id="@+id/buttonClearSearch"
                        android:layout_width="@dimen/_20sdp"
                        android:layout_height="@dimen/_20sdp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/tools_clear_search"
                        android:padding="@dimen/_3sdp"
                        android:src="@drawable/ic_close"
                        android:visibility="gone"
                        app:tint="@color/ds_ink_muted" />
                </LinearLayout>

                <!-- Number lookup, moved off the top of Recents. It belongs with
                     the tools rather than above the call log: Recents is a list
                     you read, and a search field above it competes for the same attention
                     as the list itself. Submitting opens the Lookup screen. -->
                <LinearLayout
                    android:id="@+id/cardLookup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">
    
                    <!-- No heading above the field any more: the design folds the question
                         into the placeholder ("Who\'s calling? Search a number") and lets
                         the row stand on its own, which is what keeps the top of Home to a
                         title, a field and a status line instead of three stacked cards. -->
    
                    <!-- The field takes the whole row. Ask AI used to share it and now
                         sits on the protection strip above; see the note there. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ds_home_field"
                        android:elevation="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:outlineAmbientShadowColor="@color/ds_card_shadow"
                        android:outlineSpotShadowColor="@color/ds_card_shadow"
                        android:padding="6dp">
    
                        <LinearLayout
                            android:id="@+id/columnLookupCountry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/_5sdp"
                            android:paddingVertical="@dimen/_6sdp">
    
                            <!-- Flag and dial code both sit in a fixed-height box and centre
                                 inside it. An emoji flag's font metrics are nothing like the
                                 Latin text beside it, so with wrap_content heights the two
                                 optical centres never line up however they are gravitied.
                                 Same textSize for the same reason. -->
                            <TextView
                                android:id="@+id/textLookupFlag"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_22sdp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textSize="@dimen/_11ssp"
                                tools:text="🇮🇳" />
    
                            <TextView
                                android:id="@+id/textLookupDial"
                                android:layout_width="wrap_content"
                                android:layout_height="@dimen/_22sdp"
                                android:layout_marginStart="@dimen/_4sdp"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/ds_ink"
                                android:textSize="@dimen/_11ssp"
                                android:textStyle="bold"
                                tools:text="+91" />
    
                            <!-- Caret as a sized ImageView: a compound drawable draws at its
                                 own intrinsic 24dp, which towers over an 11ssp label. -->
                            <ImageView
                                android:layout_width="@dimen/_11sdp"
                                android:layout_height="@dimen/_11sdp"
                                android:layout_marginStart="@dimen/_3sdp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_caret_down"
                                app:tint="@color/ds_ink_muted" />
                        </LinearLayout>
    
                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/_20sdp"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:layout_marginEnd="@dimen/_9sdp"
                            android:background="@color/ds_rule" />
    
                        <EditText
                            android:id="@+id/inputLookupNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/mulish_semibold"
                            android:hint="@string/home_search_placeholder"
                            android:imeOptions="actionSearch"
                            android:importantForAutofill="no"
                            android:includeFontPadding="false"
                            android:inputType="text"
                            android:lineSpacingMultiplier="1.15"
                            android:paddingHorizontal="2dp"
                            android:textColor="@color/ds_ink"
                            android:textColorHint="@color/ds_placeholder"
                            android:textSize="13.5sp"
                            tools:ignore="TextFields" />
    
                        <ImageView
                            android:id="@+id/buttonLookupClear"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/action_cancel"
                            android:padding="@dimen/_5sdp"
                            android:src="@drawable/ic_close"
                            android:visibility="gone"
                            app:tint="@color/ds_ink_muted" />
    
                        <ImageView
                            android:id="@+id/buttonLookupSearch"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_ds_search_square"
                            android:contentDescription="@string/lookup_hint"
                            android:padding="9dp"
                            android:src="@drawable/ic_ds_search"
                            app:tint="@color/ds_on_accent" />
                    </LinearLayout>
            </LinearLayout>
                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_14sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:visibility="gone">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <include layout="@layout/admob_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/listTools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="6dp"
                android:paddingBottom="40dp"
                tools:listitem="@layout/item_tool_category" />

            <LinearLayout
                android:id="@+id/emptyTools"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_44sdp"
                android:visibility="gone">

                <com.numify.callerid.lookup.feature.widgets.RippleIconView
                    android:id="@+id/emptyToolsIcon"
                    android:layout_width="@dimen/_78sdp"
                    android:layout_height="@dimen/_78sdp"
                    app:ripple_disc="@drawable/bg_empty_circle_tools"
                    app:ripple_icon="@drawable/ic_tool_wrench"
                    app:ripple_iconSize="@dimen/_34sdp"
                    app:ripple_iconTint="@color/on_primary_container"
                    app:ripple_ring="@drawable/bg_ring_tools" />

                <TextView
                    android:id="@+id/textEmptyTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:gravity="center"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold"
                    tools:text="No tools match &quot;ruler&quot;" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:gravity="center"
                    android:text="@string/tools_empty_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_11ssp" />

                <LinearLayout
                    android:id="@+id/buttonResetSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:background="@drawable/bg_reset_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_18sdp">

                    <ImageView
                        android:layout_width="@dimen/_14sdp"
                        android:layout_height="@dimen/_14sdp"
                        android:contentDescription="@string/tools_reset_search"
                        android:src="@drawable/ic_close"
                        app:tint="@color/on_primary_container" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:text="@string/tools_reset_search"
                        android:textColor="@color/on_primary_container"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="match_parent"
            android:visibility="gone"/>
        </androidx.coordinatorlayout.widget.CoordinatorLayout>
    </LinearLayout>
</layout>
