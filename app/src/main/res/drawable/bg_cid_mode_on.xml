<?xml version="1.0" encoding="utf-8"?>
<!-- Selected torch mode: the handoff's amber fill on a 16dp radius. A rounded
     rectangle, not the 100dp pill this was — the three modes sit in a row of
     equal tiles, and a full pill reads as a chip rather than as one of three. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_warning" />
    <corners android:radius="16dp" />
</shape>
