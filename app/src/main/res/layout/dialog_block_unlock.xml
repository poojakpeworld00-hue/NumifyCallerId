<?xml version="1.0" encoding="utf-8"?>
<!--
    "Free blocks used up" — shown by BlockReward before the rewarded ad.

    Built on the ds_ tokens rather than reusing dialog_watch_ad, which is still on
    the old palette: this one sits on top of the redesigned blocklist and would
    read as a different app otherwise.

    The number being blocked is stated plainly in the middle, so the user can see
    what they are about to spend an ad on. The primary button is danger red like
    every other Block in the app — the ad is a step on the way to blocking, not a
    different action — and Cancel is quiet text, because backing out should cost
    nothing to find.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ds_card"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_ds_danger_disc"
            android:contentDescription="@null"
            android:padding="15dp"
            android:src="@drawable/ic_ds_block_slash"
            app:tint="@color/ds_danger" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/space_grotesk_bold"
            android:includeFontPadding="false"
            android:text="@string/block_unlock_title"
            android:textColor="@color/ds_ink"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textUnlockMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/mulish_semibold"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ds_ink_muted"
            android:textSize="12.5sp"
            tools:text="Your 3 free blocks are in use. Watch a short ad to block this number too." />

        <!-- What the ad is being spent on. -->
        <TextView
            android:id="@+id/textUnlockNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_ds_inner_field"
            android:fontFamily="@font/mulish_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"
            android:paddingVertical="13dp"
            android:textColor="@color/ds_ink"
            android:textSize="15sp"
            tools:text="+91 70164 14568" />

        <TextView
            android:id="@+id/buttonWatchAd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_ds_block_cta"
            android:drawableStart="@drawable/ic_play"
            android:drawablePadding="8dp"
            android:fontFamily="@font/mulish_bold"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:text="@string/block_unlock_button"
            android:textColor="@color/ds_on_accent"
            android:textSize="15sp"
            app:drawableTint="@color/ds_on_accent" />

        <TextView
            android:id="@+id/buttonCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:fontFamily="@font/mulish_semibold"
            android:gravity="center"
            android:minHeight="48dp"
            android:paddingHorizontal="20dp"
            android:text="@string/action_cancel"
            android:textColor="@color/ds_ink_muted"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
