<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Reusable breathing empty-state icon: a disc that gently pulses (scale
         1 → 1.05) behind a centered glyph, wrapped by an expanding, fading ring. -->
    <declare-styleable name="PulseIconView">
        <attr name="pulse_icon" format="reference" />
        <attr name="pulse_iconTint" format="color" />
        <attr name="pulse_iconSize" format="dimension" />
        <attr name="pulse_disc" format="reference" />
        <attr name="pulse_ring" format="reference" />
    </declare-styleable>

</resources>
