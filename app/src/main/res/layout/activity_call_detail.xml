<?xml version="1.0" encoding="utf-8"?>
<!-- Call details (design: Numify Call Details).

     The screen is one dark hero on a light page, then a grouped action strip,
     then the call history as a timeline.

     The hero absorbed what used to be four separate blocks — avatar, name,
     status chip, and a summary pill listing "59 calls · No talk time · Last 30
     days". Those were five stacked centred elements before the user reached a
     single action. Left-aligning the identity and folding the counts into three
     chips inside the hero puts the whole answer to "who is this and how often"
     in one card, and leaves the Identify CTA sitting inside the thing it acts on.

     The history is a timeline rather than rows in a card. The old card drew date
     headings and rows at the same indent, so a run of calls on one day read as a
     flat list with occasional labels; a rail with a node per call makes the
     grouping structural instead of typographic.

     Dark mode: every colour here is a ds_ token with a values-night counterpart.
     The hero is the one surface that gets *lighter* in dark — see the note in
     values-night/colors.xml. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/detailRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ds_page"
        tools:context=".feature.calldetails.CallDetailsActivity">

        <!-- Top bar: a 36dp rounded-square chip rather than a bare chevron, so the
             back target is a real 48dp-class hit area and the title has something
             to sit against. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_ds_back_chip"
                android:contentDescription="@string/onboarding_skip"
                android:padding="10dp"
                android:src="@drawable/ic_ds_chevron_left"
                app:tint="@color/ds_ink_strong" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:text="@string/call_detail_title"
                android:textColor="@color/ds_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingBottom="14dp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDivider"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- ===== Identity hero ===== -->
                <LinearLayout
                    android:id="@+id/heroCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_detail_hero"
                    android:clipToOutline="true"
                    android:elevation="10dp"
                    android:orientation="vertical"
                    android:outlineAmbientShadowColor="@color/ds_hero_shadow"
                    android:outlineSpotShadowColor="@color/ds_hero_shadow"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/avatarRing"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_ds_hero_avatar">

                            <TextView
                                android:id="@+id/textAvatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/space_grotesk_bold"
                                android:gravity="center"
                                android:includeFontPadding="false"
                                android:textColor="@color/ds_on_hero_muted"
                                android:textSize="24sp"
                                tools:text="JD" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/textName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:fontFamily="@font/space_grotesk_bold"
                                android:includeFontPadding="false"
                                android:letterSpacing="0.02"
                                android:maxLines="1"
                                android:textColor="@color/ds_on_hero"
                                android:textSize="26sp"
                                tools:text="112" />

                            <TextView
                                android:id="@+id/textNumber"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:fontFamily="@font/mulish_semibold"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:textColor="@color/ds_on_hero_muted"
                                android:textSize="12.5sp"
                                tools:text="+91 70164 14568 · Mobile" />

                            <!-- Unknown numbers only. The amber dot is the one warm
                                 colour on the card, so "we don't know this one" is
                                 legible without reading the label. -->
                            <LinearLayout
                                android:id="@+id/textVerified"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:background="@drawable/bg_ds_hero_pill"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp"
                                android:visibility="gone"
                                tools:visibility="visible">

                                <View
                                    android:layout_width="5dp"
                                    android:layout_height="5dp"
                                    android:background="@drawable/bg_ds_status_dot"
                                    android:backgroundTint="@color/ds_warning" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:fontFamily="@font/mulish_bold"
                                    android:includeFontPadding="false"
                                    android:text="@string/detail_not_identified"
                                    android:textColor="@color/ds_on_hero_muted"
                                    android:textSize="11.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Counts, inside the hero rather than in a pill below it. -->
                    <LinearLayout
                        android:id="@+id/summaryStrip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout style="@style/DetailHeroStat">

                            <TextView
                                android:id="@+id/textCallCount"
                                style="@style/DetailHeroStatValue"
                                tools:text="59" />

                            <TextView
                                style="@style/DetailHeroStatCaption"
                                android:text="@string/detail_stat_calls" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DetailHeroStat"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:id="@+id/textTotal"
                                style="@style/DetailHeroStatValue"
                                tools:text="12m 4s" />

                            <TextView
                                style="@style/DetailHeroStatCaption"
                                android:text="@string/detail_stat_talk" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DetailHeroStat"
                            android:layout_marginStart="8dp">

                            <TextView
                                style="@style/DetailHeroStatValue"
                                android:text="@string/detail_window_value" />

                            <TextView
                                style="@style/DetailHeroStatCaption"
                                android:text="@string/detail_stat_window" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Identify CTA — unknown numbers only. Inside the hero because
                         it acts on the identity above it, not on the screen. -->
                    <LinearLayout
                        android:id="@+id/buttonIdentify"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_ds_identify_cta"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="15dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="17dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_search"
                            app:tint="@color/ds_on_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:text="@string/detail_identify"
                            android:textColor="@color/ds_on_accent"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Actions: one grouped strip, not four floating buttons ===== -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_ds_card"
                    android:baselineAligned="false"
                    android:elevation="4dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/ds_card_shadow"
                    android:outlineSpotShadowColor="@color/ds_card_shadow"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="14dp">

                    <LinearLayout
                        android:id="@+id/buttonCall"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_accent"
                            android:contentDescription="@string/action_call"
                            android:src="@drawable/ic_ds_phone"
                            app:tint="@color/ds_on_accent" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_call" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonMessage"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_hero_blue_wash"
                            android:contentDescription="@string/action_message"
                            android:src="@drawable/ic_message_square_alt"
                            app:tint="@color/ds_accent" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_message" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/buttonWhatsapp"
                        style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_success_wash"
                            android:contentDescription="@string/action_whatsapp"
                            android:src="@drawable/ic_whatsapp"
                            app:tint="@color/ds_success" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_whatsapp" />
                    </LinearLayout>

                    <!-- Block / Unblock. Both halves are this one action: the
                         icon and label are ids because CallDetailsActivity
                         rewrites them from the blocklist, the way the lookup
                         detail screen already does. -->
                    <LinearLayout
                        android:id="@+id/buttonBlock"
                        style="@style/DetailAction">

                        <ImageView
                            android:id="@+id/imageBlockIcon"
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/ds_danger_tint"
                            android:contentDescription="@string/action_block"
                            android:src="@drawable/ic_ds_block_slash"
                            app:tint="@color/ds_danger" />

                        <TextView
                            android:id="@+id/textBlockLabel"
                            style="@style/DetailActionLabel"
                            android:text="@string/action_block" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Call history ===== -->
                <LinearLayout
                    android:id="@+id/historyCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_ds_status_dot"
                            android:backgroundTint="@color/ds_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.01"
                            android:text="@string/detail_call_history"
                            android:textColor="@color/ds_ink_muted"
                            android:textSize="11sp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="8dp"
                            android:layout_weight="1"
                            android:background="@color/ds_rule" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/mulish_bold"
                            android:includeFontPadding="false"
                            android:text="@string/detail_last_30"
                            android:textColor="@color/ds_band_label"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- The rail is one view behind the whole run of rows, not a
                         segment per row: drawn per row it would break at every
                         margin and read as a dashed line. It is inset 8dp at the
                         top and 14dp at the bottom so it starts and ends inside
                         the first and last nodes rather than poking past them. -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <View
                            android:layout_width="2dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="13dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginBottom="14dp"
                            android:background="@color/ds_timeline_rail" />

                        <LinearLayout
                            android:id="@+id/columnHistory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/buttonViewAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_ds_history_row"
                        android:drawableEnd="@drawable/ic_ds_chevron_right"
                        android:drawablePadding="7dp"
                        android:elevation="3dp"
                        android:fontFamily="@font/mulish_bold"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:minHeight="48dp"
                        android:outlineAmbientShadowColor="@color/ds_card_shadow"
                        android:outlineSpotShadowColor="@color/ds_card_shadow"
                        android:paddingVertical="15dp"
                        android:text="@string/detail_view_all"
                        android:textColor="@color/ds_accent"
                        android:textSize="14.5sp"
                        app:drawableTint="@color/ds_accent" />

                    <!-- Kept so CallDetailsActivity's "more" toggle still has a view
                         to hide; the timeline draws its own separation. -->
                    <View
                        android:id="@+id/historyDivider"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Empty history state (no calls with this number) -->
                <LinearLayout
                    android:id="@+id/textEmptyHistory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_ds_empty_disc"
                        android:contentDescription="@null"
                        android:padding="16dp"
                        android:src="@drawable/ic_phone_solid"
                        app:tint="@color/ds_ink_muted" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/mulish_bold"
                        android:gravity="center"
                        android:text="@string/detail_history_empty_title"
                        android:textColor="@color/ds_ink"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/mulish_semibold"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/detail_history_empty_sub"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="11.5sp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
