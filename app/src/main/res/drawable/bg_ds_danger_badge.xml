<?xml version="1.0" encoding="utf-8"?>
<!-- The small circle-slash badge clipped to the corner of the blocked tile. Its
     2dp ring is the page colour, not white, so the badge punches a hole in the
     tile beneath it exactly as the design's `border: 2px solid #F6F8FC` does. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@color/ds_danger" />
    <stroke
        android:width="2dp"
        android:color="@color/ds_page" />
</shape>
