<?xml version="1.0" encoding="utf-8"?>
<!-- Trailing checkbox: 8dp-radius square. Unselected is a 2dp #D6DAE5 outline;
     selected fills with the brand blue. Driven by isActivated from the adapter,
     matching how the previous list drove its radio. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_accent" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="@color/ds_check_idle" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
