<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tablet step-up for the splash. The composition itself (backdrop discs, card
         stack, loader width) is already proportional to screen width, but type held
         at phone sizes reads undersized on a 600dp+ panel, so it takes one 1.35x
         step here rather than scaling continuously and going soft on phones. -->
    <dimen name="splash_wordmark_text">46sp</dimen>
    <dimen name="splash_tagline_text">19.5sp</dimen>
    <dimen name="splash_disclosure_text">16sp</dimen>
    <dimen name="splash_version_text">15.5sp</dimen>

    <dimen name="splash_loader_height">8dp</dimen>
    <dimen name="splash_loader_radius">4dp</dimen>
    <dimen name="splash_footer_gap">19dp</dimen>


    <!-- Intro on foldables and tablets: the page column is capped at 420dp and
         centred, and the hero may grow to 340dp. smallestWidth outranks the h640dp
         step, so the full composition is restated here rather than inherited. -->
    <item name="intro_hero_percent" format="float" type="dimen">0.34</item>
    <dimen name="intro_hero_min">220dp</dimen>
    <dimen name="intro_hero_max">340dp</dimen>
    <dimen name="intro_title_text">28sp</dimen>
    <dimen name="intro_title_line">31.36sp</dimen>
    <integer name="intro_body_max_lines">6</integer>
    <bool name="intro_result_full">true</bool>
    <dimen name="intro_content_max">420dp</dimen>

</resources>
