<?xml version="1.0" encoding="utf-8"?>
<!-- Loader pill, filled. The design gives the fill its own radius rather than
     letting the track clip it, so both of its ends stay round as it grows. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/splash_cs_accent" />
    <corners android:radius="@dimen/splash_loader_radius" />
</shape>
