<?xml version="1.0" encoding="utf-8"?>
<!-- Row background inside a grouped card. The selected row takes the design's
     #EAF0FE wash; everything else stays on the card's own white so the divider
     hairlines read continuously down the group. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@color/ds_surface" />
        </shape>
    </item>
    <item>
        <selector>
            <item android:state_activated="true">
                <shape android:shape="rectangle">
                    <solid android:color="@color/ds_selected_tint" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/ds_surface" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
