<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical glow line that follows the magnifier as it sweeps the field. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#006D3BE8"
        android:centerColor="#CC6D3BE8"
        android:endColor="#006D3BE8"
        android:type="linear" />
    <corners android:radius="2dp" />
</shape>
