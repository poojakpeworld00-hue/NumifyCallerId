<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ds_page"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <!-- The account the list is showing, and the control for changing it.
             No page heading: this says something the nav chip does not, which is
             what earns the space a title was wasting. Tapping it opens
             ContactAccountSheet. -->
        <!--
            Takes the space the two buttons leave, rather than asking for its own.

            As `wrap_content` it demanded whatever its label needed, and a full
            email address needed more than was left: 40dp of header padding plus a
            223dp chip plus 98dp of buttons is 361dp on a 360dp screen, so
            LinearLayout satisfied the chip and clipped the last child — the add
            button lost its right edge. Sized from the remainder it cannot
            overflow, on any screen, whatever an account is called.

            No pill behind it, which is also what makes the stretch invisible: the
            content stays packed to the left, so the caret sits against the word
            it opens exactly as it did, and the empty space to its right is just
            header. The reference draws it the same way — a row of text and a
            caret, not a filled chip.
        -->
        <LinearLayout
            android:id="@+id/buttonAccountPicker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/iconAccountGroup"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_group"
                app:tint="@color/ds_ink" />

            <!--
                The caret is this label's drawableEnd, not a sibling view.

                As a sibling it could only sit right after a short name by being
                given no weight — and then a long name, taking all the row, would
                squeeze it out of the chip entirely. As a compound drawable it is
                part of the text's own layout: it follows the last glyph when the
                name is short and stays attached to the ellipsis when it is long,
                and it cannot be pushed anywhere, because it moves with the text
                rather than beside it.

                wrap_content inside a fixed-width chip, so the label is measured
                AT_MOST the room available and ellipsizes itself at the limit.

                Ellipsized in the middle rather than at the end: every account
                here is an address, and truncating at the end leaves a column of
                rows that all read "poojachaudhari28…". The halves that tell them
                apart are the start and the domain.
            -->
            <!--
                gravity="center_vertical" is what actually aligns this row, and
                it is not optional.

                The caret is a 24dp drawable on a 13sp label, so it makes this
                view 24dp tall — taller than its own text. TextView's default
                vertical gravity is TOP, so the text was drawn at the top of that
                box while the caret inside it and the group icon beside it both
                centred, leaving the words sitting about 5dp high against both.
                Measured: the row, the icon and this view all share centre y=228;
                only the glyphs inside this view were off.

                includeFontPadding stays off for the same family of reasons — it
                pads the box with ascent/descent the glyphs do not use.
            -->
            <TextView
                android:id="@+id/textAccountName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:drawableEnd="@drawable/ic_ds_chevron_down"
                android:drawablePadding="6dp"
                android:ellipsize="middle"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/contacts_account_all"
                android:textColor="@color/ds_ink"
                android:textSize="13sp"
                app:drawableTint="@color/ds_ink_muted" />
        </LinearLayout>

        <!-- Search is a destination, not a field on this page: tapping it opens
             ContactSearchActivity, which owns the keyboard, the voice button and
             the results. The same move Google Contacts and Samsung Contacts make,
             and the reason the in-page search field is gone. -->
        <!-- The neutral header chip, not the brand tile the add button wears.
             Two solid blue squares side by side read as two primary actions and
             neither wins; adding a contact is the one thing on this page worth
             that weight, and a dark glyph on brand blue was barely legible
             anyway. -->
        <!-- Premium leads the action cluster here for the same reason it does
             on Recents: it is the offer, and search and add are the tools.
             Hidden once the entitlement is held. -->
        <com.callerid.numberlookup.home.feature.premium.PremiumBadgeView
            android:id="@+id/buttonContactsPremium"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp" />

        <ImageView
            android:id="@+id/buttonContactsSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_ds_header_chip"
            android:contentDescription="@string/contacts_search_hint"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_ds_search"
            app:tint="@color/ds_ink" />

        <ImageView
            android:id="@+id/buttonContactsAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_ds_action_tile"
            android:contentDescription="@string/action_add"
            android:elevation="8dp"
            android:outlineAmbientShadowColor="@color/ds_accent_shadow"
            android:outlineSpotShadowColor="@color/ds_accent_shadow"
            android:padding="13dp"
            android:src="@drawable/ic_person_add"
            app:tint="@color/ds_on_accent" />
    </LinearLayout>

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ds_page"
        android:stateListAnimator="@null"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll">


        <!-- Filter chips, drawn exactly as Recents draws its own: loose on the
             page, not inside a card.

             The card was there to hold the search field and the rail together as
             one object. The search field has gone to its own screen, so the card
             was left wrapping a single row of chips — a white panel, a shadow and
             12dp of padding around something the sibling tab renders bare. Two
             tabs one swipe apart should not style the same control two ways.

             Every attribute below is copied from fragment_recents: same margin,
             same fading edge, same horizontal padding. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:fadingEdgeLength="20dp"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_16sdp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabAll"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/ic_group"
                    android:text="@string/contacts_tab_all" />

                <TextView
                    android:id="@+id/tabFavorites"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/ic_rate_contact"
                    android:text="@string/contacts_tab_favorites" />

                <TextView
                    android:id="@+id/tabRecents"
                    style="@style/RecentFilterTab"
                    android:drawableStart="@drawable/ic_history"
                    android:text="@string/contacts_tab_recents" />

                <TextView
                    android:id="@+id/tabGroups"
                    style="@style/RecentFilterTab"
                    android:layout_marginEnd="0dp"
                    android:drawableStart="@drawable/ic_group"
                    android:text="@string/contacts_tab_groups" />
            </LinearLayout>
        </HorizontalScrollView>

        <!--
            Favourites, as a section the user can collapse — the disclosure Google
            Contacts puts on the same group.

            The rail is a shortcut, and a shortcut nobody uses is just a band of
            screen taken from the directory underneath it. Tapping the header
            folds it away and the choice is remembered, so someone who does not
            use favourites stops paying for them on every launch.

            The whole header is the control, not the caret alone: an 18dp chevron
            is a poor target, and the row is already the width of the screen. It
            carries no ripple of its own, though — a band of grey washing across
            the full width says "this row was pressed" far more loudly than the
            thing that actually changed. The caret turning is the feedback.

            ContactListFragment still hides the section outright when nobody is
            starred, so the header never sits over an empty rail.
        -->
        <LinearLayout
            android:id="@+id/favSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="36dp"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulish_bold"
                android:letterSpacing="0.0909"
                android:text="@string/contacts_tab_favorites"
                android:textColor="@color/ds_ink_muted"
                android:textSize="11sp" />

            <!-- Beside the label, not out at the right margin. A caret alone on
                 the far edge reads as belonging to the row's right-hand end —
                 to whatever sits there — rather than to the word it opens and
                 closes. The spacer after it keeps the tap target the full width. -->
            <ImageView
                android:id="@+id/iconFavExpand"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@string/contacts_favorites_toggle"
                android:src="@drawable/ic_ds_chevron_down"
                app:tint="@color/ds_ink_muted" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listFavorites"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_6sdp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/_14sdp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_contact_favorite" />

        <!-- Full-bleed hairline separating the filters from the ad below -->
        <View
            android:id="@+id/adNativeDivider"
            android:layout_marginTop="@dimen/_10sdp"
            style="@style/AdDivider" />

        <!-- Native ad -->
        <FrameLayout
            android:id="@+id/adNativeFrame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_16sdp"
           >

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#ccc">

                <include layout="@layout/admob_native_banner" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>
        <!-- Full-bleed hairline separating the filters from the ad below -->
        <View
            android:id="@+id/adNativeDivider1"
            style="@style/AdDivider" />

        <!-- The directory's own heading, carrying the count that used to sit in
             the toolbar. Up there the number labelled the whole page; here it
             labels the list it is actually counting, and it gives the contacts
             card the same section header the favourites rail above it has. -->
        <TextView
            android:id="@+id/textContactsCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="2dp"
            android:fontFamily="@font/mulish_bold"
            android:letterSpacing="0.0909"
            android:paddingHorizontal="20dp"
            android:textColor="@color/ds_ink_muted"
            android:textSize="11sp"
            tools:text="Contacts : 586" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- One grouped card rather than loose rows, which is how the design frames
             the directory. The end margin clears the alphabet index so the card
             stops before it instead of running underneath it. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/listContacts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="26dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_ds_card"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:elevation="6dp"
            android:outlineAmbientShadowColor="@color/ds_card_shadow"
            android:outlineSpotShadowColor="@color/ds_card_shadow"
            android:overScrollMode="never"
            android:paddingBottom="12dp"
            tools:listitem="@layout/item_contact" />

        <!-- Alphabet fast-scroll index -->
        <LinearLayout
            android:id="@+id/alphaIndex"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="@dimen/_4sdp" />

        <TextView
            android:id="@+id/letterBubble"
            android:layout_width="@dimen/_48sdp"
            android:layout_height="@dimen/_48sdp"
            android:layout_gravity="center"
            android:background="@drawable/bg_letter_bubble"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="A"
            tools:visibility="visible" />

        <!-- Icon, what is missing, how it fills. Which of the four it shows
             depends on the tab - see ContactListFragment.showEmptyFor. -->
        <com.callerid.numberlookup.home.feature.widgets.EmptyStateView
            android:id="@+id/textEmpty"
            android:layout_width="match_parent"
            android:elevation="8dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <!--
            Permission state. A NestedScrollView for the same reason as the one
            in fragment_recents: while this is up [listContacts] is GONE, so
            without a nested-scrolling child here the AppBarLayout header above
            cannot scroll off, and on a shorter phone its lower half is left
            unreachable and untappable.
        -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/permState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingBottom="@dimen/_70sdp"
            android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/_32sdp">

            <ImageView
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:background="@drawable/bg_icon_box"
                android:contentDescription="@string/perm_contacts_title"
                android:padding="@dimen/_16sdp"
                android:src="@drawable/ic_group"
                app:tint="@color/primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_14sdp"
                android:text="@string/perm_contacts_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_13ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:text="@string/perm_contacts_message"
                android:textColor="@color/on_surface_variant"
                android:textSize="@dimen/_11ssp" />

            <TextView
                android:id="@+id/buttonGrant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="@dimen/_24sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:text="@string/action_grant"
                android:textColor="@color/white"
                android:textSize="@dimen/_12ssp"
                android:textStyle="bold" />
        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</LinearLayout>
