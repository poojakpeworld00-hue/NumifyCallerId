<?xml version="1.0" encoding="utf-8"?>
<!--
    Intro 03 · Contact Management. A cropped slice of the Contacts tab with the Add
    button spotlighted, the favourites strip, an A–Z list and index, and the Groups
    card beside it. No tap marker on this page: the design only rings the control.

    IntroAnimations drives: heroCard (popIn), heroResult (slide), heroResultCard
    (float), heroPulse (ring).
-->
<com.callerid.numberlookup.home.feature.intro.IntroHeroLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/heroCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:contentDescription="@string/intro_hero_contacts_cd"
    android:importantForAccessibility="yes"
    app:introAccent="@color/ds_violet"
    app:introBorder="@color/intro_border_contacts"
    app:introDashAlpha="0.22"
    app:introRingAlpha="0.12"
    app:introWash="@color/intro_wash_contacts"
    app:introWashMid="@color/intro_wash_contacts_mid"
    tools:layout_height="268dp">

    <!-- Mini contacts -->
    <FrameLayout
        android:id="@+id/heroScreen"
        android:layout_width="@dimen/intro_screen_w"
        android:layout_height="match_parent"
        android:layout_marginStart="18dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="-14dp"
        android:background="@drawable/bg_intro_mini_page"
        android:clipToOutline="true"
        android:elevation="10dp"
        android:importantForAccessibility="noHideDescendants"
        android:outlineAmbientShadowColor="@color/intro_shadow_blue"
        android:outlineSpotShadowColor="@color/intro_shadow_blue"
        tools:targetApi="31">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Account picker · search · add -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <ImageView
                    style="@style/IntroArtIcon"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_group"
                    app:tint="@color/ds_accent"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/IntroArtText"
                        android:text="@string/contacts_account_all"
                        android:textSize="9dp"
                        tools:ignore="SpUsage" />

                    <TextView
                        style="@style/IntroArtText"
                        android:layout_marginStart="2.5dp"
                        android:text="▾"
                        android:textSize="9dp"
                        tools:ignore="HardcodedText,SpUsage" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_intro_search_btn">

                    <ImageView
                        style="@style/IntroArtIcon"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_ds_search"
                        app:tint="@color/ds_ink"
                        tools:ignore="ContentDescription" />
                </FrameLayout>

                <!-- The target -->
                <FrameLayout
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="5dp"
                    android:clipChildren="false">

                    <View
                        android:id="@+id/heroPulse"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_intro_ring_contacts" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_intro_r7"
                        android:backgroundTint="@color/ds_violet">

                        <ImageView
                            style="@style/IntroArtIcon"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person_add"
                            app:tint="@color/ds_on_accent"
                            tools:ignore="ContentDescription" />
                    </FrameLayout>
                </FrameLayout>
            </LinearLayout>

            <!-- All · Favorites · Recents · Groups -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingBottom="6dp">

                <TextView style="@style/IntroArtText" android:background="@drawable/bg_intro_r8" android:backgroundTint="@color/ds_selected_tint" android:paddingHorizontal="7dp" android:paddingVertical="3dp" android:text="@string/contacts_tab_all" android:textColor="@color/ds_accent" android:textSize="7dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="4dp" android:background="@drawable/bg_intro_r8" android:paddingHorizontal="7dp" android:paddingVertical="3dp" android:text="@string/contacts_tab_favorites" android:textColor="@color/ds_ink_strong" android:textSize="7dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="4dp" android:background="@drawable/bg_intro_r8" android:paddingHorizontal="7dp" android:paddingVertical="3dp" android:text="@string/contacts_tab_recents" android:textColor="@color/ds_ink_strong" android:textSize="7dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="4dp" android:background="@drawable/bg_intro_r8" android:paddingHorizontal="7dp" android:paddingVertical="3dp" android:text="@string/contacts_tab_groups" android:textColor="@color/ds_ink_strong" android:textSize="7dp" tools:ignore="SpUsage" />
            </LinearLayout>

            <!-- Favourites strip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="8dp">

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/IntroArtText" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_lang_en" android:gravity="center" android:text="@string/intro_art_fav_1_initials" android:textColor="@color/ds_on_accent" android:textSize="8.5dp" tools:ignore="SpUsage" />
                    <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="@string/intro_art_fav_1_name" android:textColor="@color/ds_ink_strong" android:textSize="6.5dp" tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/IntroArtText" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_lang_zh" android:gravity="center" android:text="@string/intro_art_fav_2_initials" android:textColor="@color/ds_on_accent" android:textSize="8.5dp" tools:ignore="SpUsage" />
                    <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="@string/intro_art_fav_2_name" android:textColor="@color/ds_ink_strong" android:textSize="6.5dp" tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/IntroArtText" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_lang_pt" android:gravity="center" android:text="@string/intro_art_fav_3_initials" android:textColor="@color/ds_on_accent" android:textSize="8.5dp" tools:ignore="SpUsage" />
                    <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="@string/intro_art_fav_3_name" android:textColor="@color/ds_ink_strong" android:textSize="6.5dp" tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/IntroArtText" android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_lang_th" android:gravity="center" android:text="@string/intro_art_fav_4_initials" android:textColor="@color/ds_on_accent" android:textSize="8.5dp" tools:ignore="SpUsage" />
                    <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="@string/intro_art_fav_4_name" android:textColor="@color/ds_ink_strong" android:textSize="6.5dp" tools:ignore="SpUsage" />
                </LinearLayout>
            </LinearLayout>

            <!-- A–Z list, stopping short of the index on the right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="18dp"
                android:background="@drawable/bg_intro_r12"
                android:orientation="vertical"
                android:paddingHorizontal="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="30dp">

                <TextView style="@style/IntroArtText" android:paddingVertical="3dp" android:text="A" android:textColor="@color/ds_ink_muted" android:textSize="7dp" tools:ignore="HardcodedText,SpUsage" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="3dp">
                    <TextView style="@style/IntroArtText" android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_back_chip" android:gravity="center" android:text="@string/intro_art_row_1_initials" android:textColor="@color/ds_ink_strong" android:textSize="7dp" tools:ignore="SpUsage" />
                    <TextView style="@style/IntroArtText" android:layout_marginStart="6dp" android:text="@string/intro_art_row_1_name" android:textSize="8.5dp" tools:ignore="SpUsage" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="3dp">
                    <TextView style="@style/IntroArtText" android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_back_chip" android:gravity="center" android:text="@string/intro_art_row_2_initials" android:textColor="@color/ds_ink_strong" android:textSize="7dp" tools:ignore="SpUsage" />
                    <TextView style="@style/IntroArtText" android:layout_marginStart="6dp" android:text="@string/intro_art_row_2_name" android:textSize="8.5dp" tools:ignore="SpUsage" />
                </LinearLayout>

                <TextView style="@style/IntroArtText" android:paddingVertical="3dp" android:text="B" android:textColor="@color/ds_ink_muted" android:textSize="7dp" tools:ignore="HardcodedText,SpUsage" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="3dp">
                    <TextView style="@style/IntroArtText" android:layout_width="18dp" android:layout_height="18dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_back_chip" android:gravity="center" android:text="@string/intro_art_row_3_initials" android:textColor="@color/ds_ink_strong" android:textSize="7dp" tools:ignore="SpUsage" />
                    <TextView style="@style/IntroArtText" android:layout_marginStart="6dp" android:text="@string/intro_art_row_3_name" android:textSize="8.5dp" tools:ignore="SpUsage" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- A–Z index -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="78dp"
            android:layout_marginEnd="4dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView style="@style/IntroArtText" android:text="A" android:textColor="@color/ds_accent" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
            <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="B" android:textColor="@color/ds_nav_idle" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
            <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="C" android:textColor="@color/ds_nav_idle" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
            <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="D" android:textColor="@color/ds_nav_idle" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
            <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="E" android:textColor="@color/ds_nav_idle" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
            <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="F" android:textColor="@color/ds_nav_idle" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
            <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="G" android:textColor="@color/ds_nav_idle" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
            <TextView style="@style/IntroArtText" android:layout_marginTop="2dp" android:text="H" android:textColor="@color/ds_nav_idle" android:textSize="6dp" tools:ignore="HardcodedText,SpUsage" />
        </LinearLayout>

        <com.callerid.numberlookup.home.feature.intro.IntroMiniNavView
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="bottom"
            app:introNavActive="contacts" />
    </FrameLayout>

    <!-- Groups card -->
    <FrameLayout
        android:id="@+id/heroResult"
        android:layout_width="@dimen/intro_result_w_narrow"
        android:elevation="14dp"
        android:outlineProvider="none"
        android:layout_height="wrap_content"
        android:layout_gravity="end|top"
        android:layout_marginTop="62dp"
        android:layout_marginEnd="14dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:importantForAccessibility="noHideDescendants">

        <LinearLayout
            android:id="@+id/heroResultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_intro_card_contacts"
            android:elevation="14dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/intro_shadow_violet"
            android:outlineSpotShadowColor="@color/intro_shadow_violet"
            android:padding="12dp"
            tools:targetApi="31">

            <TextView
                style="@style/IntroArtText.Eyebrow"
                android:text="@string/contacts_tab_groups"
                android:textColor="@color/ds_violet"
                tools:ignore="SpUsage" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_violet" />
                <TextView style="@style/IntroArtText" android:layout_width="0dp" android:layout_marginStart="7dp" android:layout_weight="1" android:text="@string/intro_art_family" android:textSize="9.5dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="7dp" android:text="8" android:textColor="@color/ds_ink_muted" android:textSize="8.5dp" tools:ignore="HardcodedText,SpUsage" />
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_accent" />
                <TextView style="@style/IntroArtText" android:layout_width="0dp" android:layout_marginStart="7dp" android:layout_weight="1" android:text="@string/intro_art_work" android:textSize="9.5dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="7dp" android:text="23" android:textColor="@color/ds_ink_muted" android:textSize="8.5dp" tools:ignore="HardcodedText,SpUsage" />
            </LinearLayout>

            <!-- Dropped on short screens (bool/intro_result_full). -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:tag="intro_extra">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_intro_oval" android:backgroundTint="@color/ds_warning" />
                <TextView style="@style/IntroArtText" android:layout_width="0dp" android:layout_marginStart="7dp" android:layout_weight="1" android:text="@string/intro_art_friends" android:textSize="9.5dp" tools:ignore="SpUsage" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="7dp" android:text="41" android:textColor="@color/ds_ink_muted" android:textSize="8.5dp" tools:ignore="HardcodedText,SpUsage" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:background="@color/ds_divider" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                <ImageView style="@style/IntroArtIcon" android:layout_width="11dp" android:layout_height="11dp" android:src="@drawable/ic_star" app:tint="@color/ds_warning" tools:ignore="ContentDescription" />
                <TextView style="@style/IntroArtText" android:layout_marginStart="6dp" android:text="@string/intro_art_favorites_pinned" android:textColor="@color/ds_ink_strong" android:textSize="8.5dp" tools:ignore="SpUsage" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.callerid.numberlookup.home.feature.intro.IntroHeroLayout>
