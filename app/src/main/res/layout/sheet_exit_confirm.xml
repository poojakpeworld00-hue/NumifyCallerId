<?xml version="1.0" encoding="utf-8"?>
<!--
    Exit confirmation dialog (replaces the plain MaterialAlertDialogBuilder).
    Title/description/button labels are remote-driven from the `exit.dialog`
    block; the ad slot honours `dialog.isNativeAdShow` + `dialog.isBottomAdsType`.

    The shimmer placeholder is intentionally EMPTY here — ExitDialog inflates the
    matching gads_* layout into it at runtime, since the ad format is chosen by
    Remote Config rather than fixed at build time.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/exitDialogCardVw"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_card"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/_14sdp"
    android:paddingTop="@dimen/_16sdp"
    android:paddingBottom="@dimen/_12sdp">

    <TextView
        android:id="@+id/exitDialogTitleVw"
        android:fontFamily="@font/figtree_bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:letterSpacing="-0.01"
        android:text="@string/exit_dialog_title"
        android:textColor="@color/on_surface"
        android:textSize="@dimen/_13ssp" />

    <TextView
        android:id="@+id/exitDialogDescVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_5sdp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.35"
        android:text="@string/exit_dialog_desc"
        android:textColor="@color/on_surface_variant"
        android:textSize="@dimen/_10ssp" />

    <!-- Ad slot. Gone unless the config asks for an ad AND it loads. -->
    <FrameLayout
        android:id="@+id/adNativeFrameVw"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp"
        android:visibility="gone">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/adShimmerVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:orientation="horizontal"
        android:weightSum="2">

        <TextView
            android:id="@+id/exitDialogCancelVw"
            android:layout_width="0dp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginEnd="@dimen/_5sdp"
            android:layout_weight="1"
            android:background="@drawable/shape_btn_outline"
            android:gravity="center"
            android:text="@string/exit_dialog_negative"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_11ssp" />

        <TextView
            android:id="@+id/exitDialogExitVw"
            android:fontFamily="@font/figtree_semibold"
            android:layout_width="0dp"
            android:layout_height="@dimen/_42sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:layout_weight="1"
            android:background="@drawable/shape_btn_primary"
            android:gravity="center"
            android:text="@string/exit_dialog_positive"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_11ssp" />
    </LinearLayout>
</LinearLayout>
