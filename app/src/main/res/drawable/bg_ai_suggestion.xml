<?xml version="1.0" encoding="utf-8"?>
<!-- Starter / follow-up chip. Activated = the context-derived chip, which is
     tinted so the ranked suggestion reads ahead of the generic ones. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/primary_container" />
            <corners android:radius="@dimen/_100sdp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/outline" />
            <corners android:radius="@dimen/_100sdp" />
        </shape>
    </item>
</selector>
