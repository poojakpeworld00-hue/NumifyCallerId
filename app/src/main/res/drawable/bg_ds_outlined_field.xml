<?xml version="1.0" encoding="utf-8"?>
<!-- Search field that sits directly on the page rather than inside a card, so it
     needs its own hairline to separate it from the background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/ds_rail" />
    <corners android:radius="14dp" />
</shape>
