<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blocklistRootVw"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.spamlist.BlockedNumbersFragment">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/crownBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/padBack"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/glyph_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:text="@string/blocklist_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ===== POPULATED ===== -->

        <!-- Slim summary strip (not a hero card celebrating a number) -->
        <LinearLayout
            android:id="@+id/summaryStripVw"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/shape_row_neutral"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_14sdp"
            android:paddingVertical="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@id/adNativeFrameVw">

            <ImageView
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/shape_summary_tile"
                android:contentDescription="@string/blocklist_section_blocked"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/glyph_shield_summary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblSummaryCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_12ssp"
                    android:textStyle="bold"
                    tools:text="12 numbers blocked" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/blocklist_summary_sub"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Mid-native ad slot, top of the tab. Anchored to crownBar, NOT to
             summaryStripVw: the strip belongs to populatedGroupVw and goes GONE on
             an empty list, which collapsed this slot up into the empty state and
             drew the two on top of each other. Both the populated strip and the
             empty state now flow *below* this slot instead. -->
        <FrameLayout
            android:id="@+id/adNativeFrameVw"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/crownBar">

            <com.facebook.shimmer.ShimmerFrameLayout
                android:id="@+id/adShimmerVw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/gads_mid_native" />
            </com.facebook.shimmer.ShimmerFrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/lblHeaderBlocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_18sdp"
            android:layout_marginTop="@dimen/_14sdp"
            android:letterSpacing="0.08"
            android:text="@string/blocklist_section_blocked"
            android:textAllCaps="true"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_9ssp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/summaryStripVw" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rollBlocklist"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_18sdp"
            android:paddingTop="@dimen/_6sdp"
            android:paddingBottom="@dimen/_88sdp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDividerVw"
            app:layout_constraintTop_toBottomOf="@id/lblHeaderBlocked"
            tools:listitem="@layout/cell_blocklist" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_20sdp"
            android:contentDescription="@string/blocklist_add"
            android:src="@drawable/glyph_add"
            app:backgroundTint="@color/primary"
            app:elevation="@dimen/_6sdp"
            app:layout_constraintBottom_toTopOf="@id/adBannerDividerVw"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Fab.Rounded"
            app:tint="@color/white" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/populatedGroupVw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="summaryStripVw,lblHeaderBlocked,rollBlocklist,fabAddVw" />

        <!-- ===== EMPTY STATE: breathing icon + headline + the three methods ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/emptyScrollVw"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/_12sdp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/adBannerDividerVw"
            app:layout_constraintTop_toBottomOf="@id/adNativeFrameVw">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_20sdp">

                <com.numify.callerid.lookup.feature.widgets.RippleIconView
                    android:id="@+id/emptyIconVw"
                    android:layout_width="@dimen/_74sdp"
                    android:layout_height="@dimen/_74sdp"
                    android:layout_marginTop="@dimen/_20sdp"
                    app:ripple_disc="@drawable/shape_empty_circle_spam"
                    app:ripple_icon="@drawable/glyph_block_circle"
                    app:ripple_iconSize="@dimen/_32sdp"
                    app:ripple_ring="@drawable/shape_ring_spam" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:text="@string/blocklist_empty"
                    android:textColor="@color/on_surface"
                    android:textSize="@dimen/_14ssp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:gravity="center"
                    android:text="@string/blocklist_empty_subtitle"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_11ssp" />

                <!-- Empty state carries the add form itself, not a menu that opens
                     it: with nothing blocked yet the only thing to do here is add
                     the first number, so make it typable on the spot. Same
                     part_block_add_form as the dialog, so the two cannot drift. -->
                <LinearLayout
                    android:id="@+id/emptyFormCardVw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:background="@drawable/shape_row_neutral"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <include
                        android:id="@+id/emptyFormVw"
                        layout="@layout/part_block_add_form"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/padEmptyBlock"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_44sdp"
                        android:layout_marginTop="@dimen/_14sdp"
                        android:background="@drawable/shape_btn_danger"
                        android:foreground="?attr/selectableItemBackground"
                        android:gravity="center"
                        android:text="@string/action_block"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Hosted as a tab: MainShellActivity owns the app-wide bottom banner, so
             this screen carries no banner slot of its own. -->
        <View
            android:id="@+id/adBannerDividerVw"
            style="@style/AdDivider"
            android:layout_width="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
