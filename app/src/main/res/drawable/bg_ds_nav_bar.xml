<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom navigation, as a floating white pill rather than a full-bleed bar.
     26dp radius; its lift comes from elevation on the view so the shadow tracks
     the rounded outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface" />
    <corners android:radius="26dp" />
</shape>
