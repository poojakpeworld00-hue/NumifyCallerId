<?xml version="1.0" encoding="utf-8"?>
<!-- Call / lookup detail hero: `linear-gradient(155deg,#2A2154,#12172B)` at a
     22dp radius.

     The angle is 315 (CSS 135deg) rather than the authored 155, because a shape
     drawable only accepts 45-degree steps — the same rounding bg_ds_hero_blue
     documents. Both stops are deep indigo-to-near-black, so the 20-degree
     difference is not resolvable on a 200dp card.

     The shadow is not baked in: the layout supplies elevation plus
     outlineSpotShadowColor, so it tracks the rounded outline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/ds_detail_hero_start"
        android:endColor="@color/ds_detail_hero_end"
        android:type="linear" />
    <corners android:radius="22dp" />
</shape>
