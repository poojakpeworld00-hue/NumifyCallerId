<?xml version="1.0" encoding="utf-8"?>
<!-- Unselected torch mode: white on a 16dp radius, no outline. The handoff
     separates these from the page with a shadow rather than a hairline, which
     the layout supplies as elevation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ds_surface" />
    <corners android:radius="16dp" />
</shape>
