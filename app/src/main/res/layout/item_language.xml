<?xml version="1.0" encoding="utf-8"?>
<!-- Language row (design: Numify Language Screen).

     A 44dp round chip carrying the country flag leads the row, then the endonym
     over the English name, with the checkbox trailing. The design draws a
     two-letter code on that chip; the flag is shown instead, and the code is kept
     only as the fallback for a device that cannot draw one.

     Text is at the design's sizes. The screen wants to show as many of its
     eleven rows as it can, and the room for that came out of the spacing rather
     than the type: cutting the row's padding from 16dp to 9dp takes 14dp off
     every row without making a single word harder to read, which is 154dp over
     the list — about two more rows on a phone. Shrinking type buys less and
     costs legibility, so it was tried and reverted.

     includeFontPadding is off on both lines: the row is 9 + 44 + 9, and the
     font's own leading would otherwise add ~9dp of air on top of that.

     Sizes are the design's own px in dp, not sdp. The sdp scale is not 1:1 with
     dp (on a sw360dp phone `_16sdp` is 19.2dp), so feeding it design numbers
     would inflate the whole row by a fifth. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/columnLanguage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ds_row_selectable"
    android:clickable="true"
    android:focusable="true"
    android:padding="9dp">

    <!-- The country flag, on a 44dp neutral disc.

         One disc for all eleven rows (see @drawable/bg_ds_flag_chip) — the flag is
         the row's only colour. 44dp rather than the design's 40dp because the flag
         itself grew: an emoji flag draws about 1.8x its nominal text size wide, so
         a badge large enough to read needs a disc that can still contain it. At
         40dp the hoist and fly ends hung outside the ring.

         The size here is only what the tools preview uses — LanguageAdapter sets
         the real one per row, since the two-letter fallback wants a different size
         from the flag. Keep it in step with LanguageAdapter.FLAG_TEXT_DP.

         `dp`, not `sp`: this is a picture, and the app-wide text scale
         (Typography.scaled) must not grow it past the fixed disc. The two text
         lines beside it are sp and do scale.

         LanguageAdapter substitutes the two-letter code when the device font has
         no glyph for the flag, so the chip is never an empty circle or tofu. -->
    <TextView
        android:id="@+id/textChip"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_ds_flag_chip"
        android:fontFamily="@font/mulish_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textColor="@color/ds_ink"
        android:textSize="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="SpUsage"
        tools:text="🇮🇳" />

    <TextView
        android:id="@+id/textNative"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:fontFamily="@font/mulish_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ds_ink"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@id/textName"
        app:layout_constraintEnd_toStartOf="@id/checkBox"
        app:layout_constraintStart_toEndOf="@id/textChip"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="हिन्दी" />

    <TextView
        android:id="@+id/textName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/mulish_semibold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ds_ink_muted"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/checkBox"
        app:layout_constraintStart_toEndOf="@id/textChip"
        app:layout_constraintTop_toBottomOf="@id/textNative"
        tools:text="Hindi" />

    <!-- 24dp box: 2dp outline when idle, filled brand blue with a white tick when
         selected. Both states come from isActivated, set in the adapter. -->
    <ImageView
        android:id="@+id/checkBox"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_ds_checkbox"
        android:contentDescription="@null"
        android:padding="5dp"
        android:src="@drawable/ic_check"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/selector_ds_check" />

</androidx.constraintlayout.widget.ConstraintLayout>
