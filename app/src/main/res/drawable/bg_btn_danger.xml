<?xml version="1.0" encoding="utf-8"?>
<!--
    Filled pill for a destructive confirm. Uses the verdict `danger` token rather
    than the brand: blocking is a spam action, and the app already reads that hue
    as "spam / blocked" everywhere else.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/danger" />
    <corners android:radius="100dp" />
</shape>
