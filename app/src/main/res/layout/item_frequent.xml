<?xml version="1.0" encoding="utf-8"?>
<!-- Dialer match row — avatar + name/number + one-tap call.

     Flat, like every other row in the app: the list's container carries the
     white, the 18dp radius and the one shadow, and hairlines divide the rows
     inside it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/textAvatar"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:background="@drawable/bg_avatar"
        android:backgroundTint="@color/primary_container"
        android:gravity="center"
        android:textColor="@color/on_primary_container"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        tools:text="PC" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            tools:text="Pooja Chudhri" />

        <TextView
            android:id="@+id/textCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_10ssp"
            tools:text="70460 24874" />
    </LinearLayout>

    <ImageView
        android:id="@+id/buttonCall"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/bg_circle_surface"
        android:contentDescription="@string/action_call"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/ic_call"
        app:tint="@color/primary" />
</LinearLayout>
