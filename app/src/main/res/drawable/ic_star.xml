<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="56dp"
    android:height="56dp"
    android:viewportWidth="56"
    android:viewportHeight="56">
      <!-- These started life as icon TILES: a filled backdrop plus the mark, with
       the mark sitting on only ~41% of the viewport. The backdrop is gone
       (the layout draws the chip now), so the mark is scaled up to fill the
       viewport like every other glyph here — otherwise the host's padding is
       applied on top of the tile's old inset and the icon reads as a speck. -->
  <group
      android:pivotX="28.0"
      android:pivotY="28.0"
      android:scaleX="2.094"
      android:scaleY="2.094"
      android:translateX="0.0"
      android:translateY="0.0">
