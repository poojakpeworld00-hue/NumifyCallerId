<?xml version="1.0" encoding="utf-8"?>
<!-- "Almost ready to unlock" - the rewarded no-fill cooldown in `nofill_mode`
     "wait": a ring that drains with the countdown in its centre, then
     "Unlock now" asks for the ad again. Same card, type and CTA as
     dialog_reward_unlock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ds_reward_dialog"
        android:clipToOutline="true"
        android:elevation="24dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:outlineAmbientShadowColor="@color/ds_scrim_shadow"
        android:outlineSpotShadowColor="@color/ds_scrim_shadow"
        android:padding="20dp">

        <TextView
            android:id="@+id/textWaitTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/reward_wait_title"
            android:textColor="@color/ds_ink"
            android:textSize="21sp" />

        <TextView
            android:id="@+id/textWaitBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="@font/mulish_semibold"
            android:gravity="center"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/reward_wait_body"
            android:textColor="@color/ds_ink_subtle"
            android:textSize="13.5sp" />

        <FrameLayout
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:layout_marginTop="20dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/ringWait"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="1000"
                app:indicatorColor="@color/ds_accent"
                app:indicatorDirectionCircular="counterclockwise"
                app:indicatorSize="128dp"
                app:trackColor="@color/ds_track_idle"
                app:trackCornerRadius="6dp"
                app:trackThickness="9dp"
                tools:progress="700" />

            <TextView
                android:id="@+id/textWaitTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/space_grotesk_bold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink"
                android:textSize="28sp"
                tools:text="01:48" />

            <ImageView
                android:id="@+id/imageWaitDone"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/ds_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonWaitLater"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingHorizontal="6dp"
                android:text="@string/watch_ad_cancel"
                android:textColor="@color/ds_ink_muted"
                android:textSize="14.5sp" />

            <TextView
                android:id="@+id/buttonWaitUnlock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:background="@drawable/bg_ds_identify_cta"
                android:clickable="true"
                android:enabled="false"
                android:focusable="true"
                android:fontFamily="@font/mulish_bold"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minHeight="48dp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="15dp"
                android:text="@string/reward_wait_unlock"
                android:textColor="@color/ds_on_accent"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
