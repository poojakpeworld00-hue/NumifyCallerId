<?xml version="1.0" encoding="utf-8"?>
<!-- Dialer match row — avatar + name/number + one-tap call, styled like a recents card. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_6sdp"
    android:background="@drawable/shape_home_tile"
    android:elevation="@dimen/_1sdp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/card_shadow"
    android:outlineSpotShadowColor="@color/card_shadow"
    android:paddingHorizontal="@dimen/_12sdp"
    android:paddingVertical="@dimen/_8sdp">

    <TextView
        android:id="@+id/lblAvatar"
        android:layout_width="@dimen/_36sdp"
        android:layout_height="@dimen/_36sdp"
        android:background="@drawable/shape_avatar"
        android:backgroundTint="@color/primary_container"
        android:gravity="center"
        android:textColor="@color/on_primary_container"
        android:textSize="@dimen/_13ssp"
        android:textStyle="bold"
        tools:text="PC" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/on_surface"
            android:textSize="@dimen/_11ssp"
            android:textStyle="bold"
            tools:text="Pooja Chudhri" />

        <TextView
            android:id="@+id/lblCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_2sdp"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_10ssp"
            tools:text="70460 24874" />
    </LinearLayout>

    <ImageView
        android:id="@+id/padCall"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@drawable/shape_circle_surface"
        android:contentDescription="@string/action_call"
        android:padding="@dimen/_8sdp"
        android:src="@drawable/glyph_call"
        app:tint="@color/primary" />
</LinearLayout>
