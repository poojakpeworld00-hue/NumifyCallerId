<?xml version="1.0" encoding="utf-8"?>
<!-- One bottom-navigation cell: the glyph over its label.

     The handoff sat the active pair in a rounded wash, and there used to be a
     [navPill] wrapper here to carry it — the wash hugged its contents while the
     root still filled its weighted share, so the tap target stayed the full
     quarter of the bar. The wash is gone now: with the bar itself flat and
     full-bleed, a tinted lozenge was the only remaining chrome down there and it
     read as a leftover. State is carried by the accent colour and the bolder
     label instead, and with nothing to wrap, the pill went with it.

     Both are tinted from MainShellActivity: the active accent is per tab, blue
     everywhere except Blocklist.

     19dp/10sp was sized to survive five destinations in a padded island. At four
     cells in a full-width bar there is room to read it: 22dp glyph, 12sp label. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/navIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_ds_nav_recents"
            app:tint="@color/ds_nav_idle"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/navLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/mulish_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ds_nav_idle"
            android:textSize="12sp"
            tools:text="Recents" />
    </LinearLayout>
</layout>
