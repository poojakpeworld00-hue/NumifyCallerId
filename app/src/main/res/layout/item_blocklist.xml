<?xml version="1.0" encoding="utf-8"?>
<!--
    One blocked number.

    Same row rhythm as item_contact and item_call: a 40dp leading disc, a 14.5sp
    title over a 12sp subtitle, and a trailing action. The three differ only in what
    fills those slots, which is what makes the app's lists read as one family.

    The leading disc is the danger circle-slash on every row — every entry here is
    blocked, so that is the row's subject, not a state that some rows are in.
    BlockedNumberAdapter still distinguishes a spam-flagged entry, but now only by
    taking the title into the danger red rather than by restyling the whole row.

    Unblock is plain text, not a pill: it is a quiet, reversible action and a filled
    button would out-rank the Block CTA on the card above it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/blockRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_ds_card"
    android:clickable="true"
    android:elevation="4dp"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:outlineAmbientShadowColor="@color/ds_card_shadow"
    android:outlineSpotShadowColor="@color/ds_card_shadow"
    android:paddingHorizontal="16dp"
    android:paddingVertical="13dp">

    <FrameLayout
        android:id="@+id/avatarBox"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_ds_danger_disc">

        <ImageView
            android:id="@+id/imageAvatar"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="@string/blocklist_status_blocked"
            android:src="@drawable/ic_ds_block_slash"
            app:tint="@color/ds_danger" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/mulish_bold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ds_ink"
            android:textSize="14.5sp"
            tools:text="+91 98765 43210" />

        <TextView
            android:id="@+id/textNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/mulish_semibold"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/ds_ink_muted"
            android:textSize="12sp"
            tools:text="Blocked · Today" />
    </LinearLayout>

    <TextView
        android:id="@+id/buttonUnblock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/mulish_bold"
        android:gravity="center"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:paddingHorizontal="4dp"
        android:text="@string/blocklist_unblock"
        android:textColor="@color/ds_accent"
        android:textSize="13sp" />
</LinearLayout>
