<?xml version="1.0" encoding="utf-8"?>
<!--
    One blocked number, with what it has tried since (design: Numify Blocklist).

    Same row rhythm as item_contact and item_call: a 40dp leading disc, a 14.5sp
    title over a 12sp subtitle, and a trailing action. The three differ only in what
    fills those slots, which is what makes the app's lists read as one family.

    The leading disc is the danger circle-slash on every row — every entry here is
    blocked, so that is the row's subject, not a state that some rows are in.
    BlockedNumberAdapter still distinguishes a spam-flagged entry, but now only by
    taking the title into the danger red rather than by restyling the whole row.

    Unblock is plain text, not a pill: it is a quiet, reversible action and a filled
    button would out-rank the Block CTA on the card above it.

    Under the row sits what the handoff adds: how many times this number has called
    since it was blocked, and a disclosure that opens the individual attempts. Both
    are hidden when it has not tried — an empty history is not worth a control.

    Flat, like item_call and item_contact: the list's own container carries the
    white, the 18dp radius and the single shadow, and the rows inside it are
    divided by hairlines.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/blockRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp">

            <FrameLayout
                android:id="@+id/avatarBox"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_ds_danger_disc">

                <ImageView
                    android:id="@+id/imageAvatar"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/blocklist_status_blocked"
                    android:src="@drawable/ic_ds_block_slash"
                    app:tint="@color/ds_danger" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/mulish_bold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/ds_ink"
                    android:textSize="14.5sp"
                    tools:text="+91 98765 43210" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/mulish_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="11.5sp"
                        tools:text="Blocked · Today" />

                    <!-- How many times it has tried since being blocked. Hidden at
                         zero: "0 attempts" on every fresh block is noise, and the
                         absence of the badge already says it. -->
                    <TextView
                        android:id="@+id/badgeAttempts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_ds_attempt_badge"
                        android:fontFamily="@font/mulish_bold"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="7dp"
                        android:paddingVertical="2dp"
                        android:textColor="@color/ds_danger"
                        android:textSize="10.5sp"
                        android:visibility="gone"
                        tools:text="7 attempts"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/buttonUnblock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/mulish_bold"
                android:gravity="center"
                android:minWidth="48dp"
                android:minHeight="48dp"
                android:paddingHorizontal="4dp"
                android:text="@string/blocklist_unblock"
                android:textColor="@color/ds_accent"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Disclosure: last attempt, and the chevron that opens the rest. Indented
             to the text column so it reads as belonging to the row above rather
             than as a row of its own. -->
        <LinearLayout
            android:id="@+id/rowLastAttempt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="68dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/textLastAttempt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/mulish_bold"
                android:includeFontPadding="false"
                android:textColor="@color/ds_ink_muted"
                android:textSize="11.5sp"
                tools:text="Last attempt: 2h ago" />

            <ImageView
                android:id="@+id/chevronAttempts"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/blocklist_call_attempts"
                android:src="@drawable/ic_caret_down"
                app:tint="@color/ds_accent" />
        </LinearLayout>

        <!-- The attempts themselves, filled by BlockedNumberAdapter. -->
        <LinearLayout
            android:id="@+id/columnAttempts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ds_attempt_sheet"
            android:orientation="vertical"
            android:paddingStart="68dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="@font/mulish_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.076"
                android:text="@string/blocklist_call_attempts"
                android:textColor="@color/ds_band_label"
                android:textSize="10.5sp" />

            <LinearLayout
                android:id="@+id/columnAttemptRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</layout>
