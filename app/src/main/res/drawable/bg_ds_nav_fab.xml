<?xml version="1.0" encoding="utf-8"?>
<!-- The raised lookup action, per the handoff: a 54dp circle carrying
     `linear-gradient(150deg,#4C7BFF,#1F3FAE)` inside a 4dp ring of the page
     colour, so the circle reads as punched through the nav island rather than
     sitting on it.

     Android gradient angles are multiples of 45 measured anticlockwise from
     east; 315 is the nearest to the design's 150deg, and puts the light end at
     the top-left exactly as the handoff does. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:angle="315"
        android:endColor="@color/ds_fab_end"
        android:startColor="@color/ds_fab_start"
        android:type="linear" />
    <stroke
        android:width="4dp"
        android:color="@color/ds_page" />
</shape>
