<?xml version="1.0" encoding="utf-8"?>
<!-- Verified shield: a filled brand-blue shield with a white tick knocked through
     it. Two paths rather than one tinted glyph, because the tick has to stay white
     whatever the shield is tinted to. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/ds_accent"
        android:pathData="M12 3l7 3v6c0 5 -3.1 8 -7 9 -3.9 -1 -7 -4 -7 -9V6l7 -3z" />
    <path
        android:pathData="M9 12l2 2 4 -4"
        android:strokeColor="@color/ds_on_accent"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
