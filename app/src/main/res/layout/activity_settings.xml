<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/settingsRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.prefs.SettingsActivity">

        <!-- Top bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="16dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                style="@style/ToolHeaderBack"
                android:contentDescription="@string/onboarding_skip"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                style="@style/ToolHeaderTitle"
                android:text="@string/nav_settings" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/settingsScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_12sdp"
            android:paddingBottom="@dimen/_20sdp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layoutAnimation="@anim/anim_tool_grid"
                android:orientation="vertical">

                <!-- Native ad at the top of the settings list -->
                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

                <!-- ===== Preferences ===== -->
                <!-- Premium leads the page, above the section header, because it
                     is an offer rather than a setting and because everything below
                     it is a limit this removes. Hidden entirely once owned — see
                     SettingsActivity.bindPremium. -->
                <!-- No bottom margin: the PREFERENCES header below already brings
                     the 18sdp every section boundary on this page uses, and
                     carrying one here too left a hole under the card. -->
                <com.callerid.numberlookup.home.feature.premium.PremiumTeaserView
                    android:id="@+id/cardPremium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout style="@style/SettingsSectionRow">

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:text="@string/settings_section_preferences" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <!-- Appearance, as the handoff leads the page: a tinted hero rather
                     than another white group, because this is the one setting here
                     that is chosen in place rather than navigated to.

                     The row names the current choice, the segmented control under it
                     changes it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ds_appearance_hero"
                    android:elevation="6dp"
                    android:orientation="horizontal"
                    android:outlineAmbientShadowColor="@color/ds_fab_shadow"
                    android:outlineSpotShadowColor="@color/ds_fab_shadow"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:background="@drawable/bg_cid_chip_brand"
                            android:contentDescription="@null"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/ic_theme_system"
                            app:tint="@color/primary" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/settings_theme"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_12ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textThemeValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:includeFontPadding="false"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/_10ssp"
                                tools:text="Light" />
                        </LinearLayout>
                    </LinearLayout>

                    <include
                        android:id="@+id/cardTheme"
                        layout="@layout/item_pref_theme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                      />
                </LinearLayout>

                <!-- Preferences as a 2x2 tile grid, per the handoff, rather than a
                     stacked list. GridLayout with two equal columns: these are four
                     peer destinations, and a list implies an order they do not have.

                     The second way into AI settings lives here. The first is the
                     gear on the Ask AI screen, which the Home switch can hide — a
                     setting that can conceal its own way back is a trap. -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="2"
                    android:useDefaultMargins="false">

                    <include
                        android:id="@+id/cardLanguage"
                        layout="@layout/item_pref_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="10dp" />

                    <include
                        android:id="@+id/cardAiSettings"
                        layout="@layout/item_pref_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="5dp"
                        android:layout_marginBottom="10dp" />

                    <include
                        android:id="@+id/cardBlocklist"
                        layout="@layout/item_pref_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="5dp" />

                    <include
                        android:id="@+id/cardSim"
                        layout="@layout/item_pref_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginStart="5dp" />
                </GridLayout>

                <!-- ===== Caller protection =====
                     Header + card are hidden together with panelCallScreening
                     (SettingsActivity.refreshCallScreeningCard) — the card is
                     the section's only row, so leaving them behind renders an
                     empty white bar under the heading once Caller ID is on. -->
                <LinearLayout
                    android:id="@+id/secCallHeader"
                    style="@style/SettingsSectionRow">

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:text="@string/settings_section_call" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/secCallCard"
                    style="@style/SettingsGroupCard">

                    <LinearLayout
                        android:id="@+id/cardCallScreening"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="@dimen/_10sdp"
                        android:paddingVertical="@dimen/_8sdp">

                        <ImageView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="@dimen/_34sdp"
                            android:background="@drawable/bg_cid_chip_teal"
                            android:contentDescription="@null"
                            android:padding="@dimen/_8sdp"
                            android:src="@drawable/ic_phone_in_talk"
                            app:tint="@color/cid_teal" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:text="@string/call_screening"
                                android:textColor="@color/on_surface"
                                android:textSize="@dimen/_12ssp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_1sdp"
                                android:includeFontPadding="false"
                                android:text="@string/call_screening_desc"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchCallScreening"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ===== Account & support ===== -->
                <LinearLayout style="@style/SettingsSectionRow">

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:text="@string/settings_section_support" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsGroupCard">

                    <include
                        android:id="@+id/columnRate"
                        layout="@layout/item_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/rateDivider"
                        style="@style/SettingsRowDivider" />

                    <include
                        android:id="@+id/columnShare"
                        layout="@layout/item_setting_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <!-- ===== Legal ===== -->
                <LinearLayout style="@style/SettingsSectionRow">

                    <TextView
                        style="@style/SettingsSectionLabel"
                        android:text="@string/settings_section_legal" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_marginStart="@dimen/_8sdp"
                        android:layout_weight="1"
                        android:background="@color/outline" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsGroupCard">

                    <include
                        android:id="@+id/columnPrivacy"
                        layout="@layout/item_setting_legal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View style="@style/SettingsRowDivider" />

                    <include
                        android:id="@+id/columnTerms"
                        layout="@layout/item_setting_legal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <View style="@style/SettingsRowDivider" />

                    <!-- Data deletion. Sits with Privacy and Terms because it is
                         the same kind of obligation, and last in the group
                         because it is the destructive one. -->
                    <include
                        android:id="@+id/columnDataDeletion"
                        layout="@layout/item_setting_legal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:gravity="center"
                    android:textColor="@color/on_surface_variant"
                    android:textSize="@dimen/_10ssp"
                    tools:text="Numify · v1.2" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
