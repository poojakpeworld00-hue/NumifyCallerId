<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lookupDetailRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.search.ReportNumberActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_8sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onboarding_skip"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_2sdp"
                android:text="@string/lookup_detail_title"
                android:textColor="@color/on_surface"
                android:textSize="@dimen/_14ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingBottom="@dimen/_16sdp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Centered identity hero -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="@dimen/_64sdp"
                        android:layout_height="@dimen/_64sdp"
                        android:background="@drawable/bg_detail_avatar_ring"
                        android:padding="@dimen/_3sdp">

                        <TextView
                            android:id="@+id/textAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_avatar"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_20ssp"
                            android:textStyle="bold"
                            tools:text="JD" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/textName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:letterSpacing="-0.02"
                        android:maxLines="1"
                        android:textColor="@color/on_surface"
                        android:textSize="@dimen/_16ssp"
                        android:textStyle="bold"
                        tools:text="Pooja Chudhri" />

                    <TextView
                        android:id="@+id/textNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_12ssp"
                        tools:text="+91 704 602 4874" />

                    <TextView
                        android:id="@+id/textStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_pill"
                        android:backgroundTint="@color/success_soft"
                        android:drawablePadding="@dimen/_5sdp"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_5sdp"
                        android:textColor="@color/success"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold"
                        tools:text="Valid · Identified" />
                </LinearLayout>

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout android:id="@+id/buttonCall" style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/primary"
                            android:contentDescription="@string/action_call"
                            android:src="@drawable/ic_call"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_call" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/buttonMessage" style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/primary_container"
                            android:contentDescription="@string/action_message"
                            android:src="@drawable/ic_message_square_alt"
                            app:tint="@color/primary"  />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/action_message" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/buttonShare" style="@style/DetailAction">

                        <ImageView
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/primary_container"
                            android:contentDescription="@string/settings_share"
                            android:src="@drawable/ic_share"
                            app:tint="@color/primary" />

                        <TextView
                            style="@style/DetailActionLabel"
                            android:text="@string/settings_share" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/buttonBlock" style="@style/DetailAction">

                        <ImageView
                            android:id="@+id/imageBlockIcon"
                            style="@style/DetailActionIcon"
                            android:backgroundTint="@color/cid_clay_100"
                            android:contentDescription="@string/action_block"
                            android:src="@drawable/ic_block"
                            app:tint="@color/cid_clay" />

                        <TextView
                            android:id="@+id/textBlockLabel"
                            style="@style/DetailActionLabel"
                            android:text="@string/action_block" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Detail card — one scannable card of rows (icon · label · value) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_14sdp"
                    android:background="@drawable/bg_row_neutral"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_14sdp">

                    <!-- Country -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/_11sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@string/lookup_country"
                            android:src="@drawable/ic_row_country" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_weight="1"
                            android:text="@string/lookup_country"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/textCountry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            tools:text="India" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline" />

                    <!-- Carrier -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/_11sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@string/lookup_carrier"
                            android:src="@drawable/ic_row_carrier" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_weight="1"
                            android:text="@string/lookup_carrier"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/textCarrier"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            tools:text="Idea" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline" />

                    <!-- Line type -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/_11sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@string/lookup_line_type"
                            android:src="@drawable/ic_row_line" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_weight="1"
                            android:text="@string/lookup_line_type"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/textLineType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            tools:text="Mobile" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline" />

                    <!-- City -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="@dimen/_11sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:contentDescription="@string/lookup_city"
                            android:src="@drawable/ic_row_city" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_weight="1"
                            android:text="@string/lookup_city"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/textCity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_11ssp"
                            android:textStyle="bold"
                            tools:text="Mumbai" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Spam type (only when flagged) -->
                <LinearLayout
                    android:id="@+id/spamRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/bg_cid_card"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp"
                    android:visibility="gone">

                    <TextView style="@style/BatteryStatLabel" android:text="@string/lookup_spam_type" />

                    <TextView
                        android:id="@+id/textSpamType"
                        style="@style/BatteryStatValue"
                        android:textColor="@color/danger"
                        tools:text="Telemarketer" />
                </LinearLayout>

                <!-- Also known as — per-name reveal (one rewarded ad per name) -->
                <LinearLayout
                    android:id="@+id/nicknamesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:background="@drawable/bg_row_neutral"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/lookup_also_known_as"
                            android:textColor="@color/on_surface"
                            android:textSize="@dimen/_12ssp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textNickCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="@dimen/_10ssp"
                            android:textStyle="bold"
                            tools:text="1 of 4 revealed" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/columnNicknames"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/textNickFooter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_2sdp"
                        android:gravity="center"
                        android:text="@string/lookup_nick_footer"
                        android:textColor="@color/on_surface_variant"
                        android:textSize="@dimen/_10ssp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Full-bleed hairline separating app content from the ad below -->
        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Bottom adaptive banner (auto-loaded by BaseActivity, type from ScreenAds config). -->
        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
