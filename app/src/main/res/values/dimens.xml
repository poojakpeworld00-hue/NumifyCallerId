<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Splash redesign (2026) — "Call card stack" =====
         Type and loader metrics, in the design's own units.

         These deliberately do NOT use the project's sdp/ssp scale. That library is
         not 1:1 with dp — on a sw360dp phone `_14ssp` resolves to 16.8sp — so
         feeding it the design's numbers would render the whole screen about 20%
         larger than the design draws it. The card stack and the backdrop scale
         themselves proportionally in code instead, and the values below carry the
         design's exact sizes, with one deliberate step up for tablets in
         values-sw600dp. -->
    <dimen name="splash_wordmark_text">34sp</dimen>
    <dimen name="splash_tagline_text">14.5sp</dimen>
    <dimen name="splash_disclosure_text">12sp</dimen>
    <dimen name="splash_version_text">11.5sp</dimen>

    <!-- The loader pill: 200x6 with a 3 radius, and the 14 gaps above and below it. -->
    <dimen name="splash_loader_height">6dp</dimen>
    <dimen name="splash_loader_radius">3dp</dimen>
    <dimen name="splash_footer_gap">14dp</dimen>


    <!-- Intro pages. The defaults here are the SHORT phone (<640dp tall) step from
         the design's size table; values-h640dp restores the full composition,
         values-w400dp widens the hero's two cards, values-sw600dp caps the column. -->
    <item name="intro_hero_percent" format="float" type="dimen">0.30</item>
    <dimen name="intro_hero_min">200dp</dimen>
    <dimen name="intro_hero_max">300dp</dimen>
    <dimen name="intro_title_text">24sp</dimen>
    <!-- lineHeight 1.12 of the title size. -->
    <dimen name="intro_title_line">26.88sp</dimen>
    <integer name="intro_body_max_lines">3</integer>
    <!-- Result card rows past the second are dropped on a short screen. -->
    <bool name="intro_result_full">false</bool>
    <dimen name="intro_screen_w">178dp</dimen>
    <dimen name="intro_result_w">156dp</dimen>
    <dimen name="intro_result_w_narrow">150dp</dimen>
    <!-- Page column cap; effectively none below sw600dp. -->
    <dimen name="intro_content_max">10000dp</dimen>

</resources>
