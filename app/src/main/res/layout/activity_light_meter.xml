<?xml version="1.0" encoding="utf-8"?>
<!--
    Light meter — CID03 redesign.

    Sunburst, lux readout, a five-band scale showing which lighting condition the
    reading falls in, then the session's lowest/highest and a pause control.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/lightRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        tools:context=".screen.utility.LightMeterActivity">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_4sdp"
            android:paddingEnd="@dimen/_8sdp"
            android:paddingVertical="@dimen/_5sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/buttonBack"
                style="@style/ToolHeaderBack"
                android:contentDescription="@string/action_back"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/ds_ink" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                style="@style/ToolHeaderTitle"
                android:text="@string/tools_light" />

            <ImageView
                android:id="@+id/buttonZero"
                android:layout_width="@dimen/_38sdp"
                android:layout_height="@dimen/_38sdp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_reset"
                android:padding="@dimen/_9sdp"
                android:src="@drawable/ic_undo"
                app:tint="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/textNoSensor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/_32sdp"
            android:gravity="center"
            android:text="@string/light_no_sensor"
            android:textColor="@color/on_surface_variant"
            android:textSize="@dimen/_12ssp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_16sdp">

                <FrameLayout
                    android:layout_width="@dimen/_180sdp"
                    android:layout_height="@dimen/_180sdp"
                    android:layout_marginTop="@dimen/_4sdp">

                    <com.callerid.numberlookup.home.feature.tools.RadiantBurstView
                        android:id="@+id/burst"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:layout_width="@dimen/_46sdp"
                        android:layout_height="@dimen/_46sdp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_tool_light"
                        app:tint="@color/cid_amber" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textLux"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/space_grotesk_bold"
                        android:includeFontPadding="false"
                        android:textColor="@color/ds_ink"
                        android:textSize="48sp"
                        tools:text="47" />

                    <!-- The unit rides the readout's baseline at 20sp in the muted
                         ink, as the handoff sets it — a unit at the same weight as
                         its number competes with the number. -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/mulish_bold"
                        android:includeFontPadding="false"
                        android:text="@string/light_unit"
                        android:textColor="@color/ds_ink_muted"
                        android:textSize="20sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_cid_chip_amber"
                    android:fontFamily="@font/mulish_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="6dp"
                    android:textColor="@color/ds_warning"
                    android:textSize="13sp"
                    tools:text="Dim" />

                <!-- Five bands; the active one is lit by LightMeterActivity. -->
                <LinearLayout
                    android:id="@+id/bands"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_18sdp"
                    android:background="@drawable/bg_cid_panel"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_12sdp"
                    android:paddingVertical="@dimen/_12sdp">

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band1"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band1Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_dark" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band2"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band2Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_dim" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band3"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band3Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_indoor" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band4"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band4Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_bright" />
                    </LinearLayout>

                    <LinearLayout style="@style/LuxBand">

                        <View
                            android:id="@+id/band5"
                            style="@style/LuxBandBar" />

                        <TextView
                            android:id="@+id/band5Lbl"
                            style="@style/LuxBandLabel"
                            android:text="@string/light_band_sun" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginEnd="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:rotation="90"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="@color/cid_teal" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/light_lowest" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textMin"
                            style="@style/BattStatValue"
                            tools:text="120 lux" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/BattStatCard"
                        android:layout_marginStart="@dimen/_4sdp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                style="@style/SpeedStatIcon"
                                android:rotation="-90"
                                android:src="@drawable/ic_arrow_forward"
                                app:tint="@color/cid_amber" />

                            <TextView
                                style="@style/BattStatLabel"
                                android:text="@string/light_highest" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/textMax"
                            style="@style/BattStatValue"
                            tools:text="2340 lux" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonCapture"
                    style="@style/ToolCta"
                    android:layout_marginTop="@dimen/_16sdp"
                    android:text="@string/meter_pause"
                    app:icon="@drawable/ic_pause" />

                <FrameLayout
                    android:id="@+id/adNativeFrame"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_10sdp">

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/adShimmer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#ccc">

                        <include layout="@layout/admob_mid_native" />
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:id="@+id/adBannerDivider"
            style="@style/AdDivider"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@id/bannerAdFrame"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <include
            layout="@layout/include_bottom_banner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
